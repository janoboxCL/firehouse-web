---
import Etiqueta from './Etiqueta.astro';
const fotos = [
  { img:'gal-stunt',   w:760,  h:1000, alto:true,
    alt:'Deportistas de Firehouse montando una elevación con la asistencia del coach' },
  { img:'gal-circulo', w:1000, h:760,
    alt:'El equipo de Firehouse sentado en círculo escuchando indicaciones' },
  { img:'gal-equipo',  w:1000, h:760,
    alt:'Deportistas de Firehouse con la polera de la academia en el gimnasio' },
];
---
<section class="section galeria" id="galeria">
  <div class="wrap">
    <div class="reveal">
      <Etiqueta texto="Un entrenamiento cualquiera" />
      <h2 class="section__title">Así se ve un viernes</h2>
    </div>

    <div class="galeria__mosaico">
      {fotos.map(f => (
        <picture class:list={['galeria__item', 'reveal', f.alto && 'galeria__item--alto']}>
          <source srcset={`/media/${f.img}.webp`} type="image/webp" />
          <img src={`/media/${f.img}.jpg`} alt={f.alt} width={f.w} height={f.h} loading="lazy" decoding="async" />
        </picture>
      ))}
    </div>
  </div>
</section>

<style>
.galeria__mosaico{
  display:grid; grid-template-columns:0.9fr 1.1fr; gap:var(--e-2);
  margin-top:var(--e-6);
}
.galeria__item{ display:block; overflow:hidden; }
.galeria__item img{ width:100%; height:100%; object-fit:cover; display:block; }
.galeria__item--alto{ grid-row:span 2; }

@media (max-width:760px){
  .galeria__mosaico{ grid-template-columns:1fr; }
  .galeria__item--alto{ grid-row:auto; }
}
</style>
