---
import Base from '../layouts/Base.astro';
import { whatsapp } from '../data/sitio.js';

const titulo = 'Inscripción Firehouse Star | Firehouse Cheer';
const descripcion = 'Inscribe a tu hija o hijo en Firehouse Star: el programa de iniciación de Firehouse Cheer.';
---
<Base titulo={titulo} descripcion={descripcion} ruta="/registro-star"
      navCtaHref="/firehouse-star" navCtaTexto="Ver Firehouse Star ⭐" navCtaTextoCorto="Star ⭐" navCtaExterno={false}>

  <section class="rstar-section">
    <div class="wrap rstar-wrap">
      <p class="rstar-eyebrow">Firehouse Star</p>
      <h1 class="rstar-titulo">Inscripción</h1>
      <p class="rstar-bajada">
        Hoy se paga el <strong>Kit de Iniciación Firehouse Star ($10.000)</strong>, que reserva el
        cupo. La primera mensualidad se cobra aparte, más cerca de la fecha de la primera clase —
        te avisamos por WhatsApp y correo antes de que llegue ese paso.
      </p>

      <form id="rstar-form" class="rstar-form" novalidate>
        <input type="text" name="empresa" id="rstar-trampa" class="campo-trampa" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <fieldset class="rstar-grupo">
          <legend>Datos del apoderado o apoderada</legend>
          <div class="rstar-fila">
            <div class="rstar-campo">
              <label for="rstar-ap-nombre">Nombre</label>
              <input type="text" id="rstar-ap-nombre" required maxlength="80" autocomplete="given-name" />
            </div>
            <div class="rstar-campo">
              <label for="rstar-ap-apellidos">Apellidos</label>
              <input type="text" id="rstar-ap-apellidos" required maxlength="120" autocomplete="family-name" />
            </div>
          </div>
          <div class="rstar-fila">
            <div class="rstar-campo">
              <label for="rstar-ap-telefono">WhatsApp</label>
              <input type="tel" id="rstar-ap-telefono" required placeholder="9 1234 5678" autocomplete="tel" />
            </div>
            <div class="rstar-campo">
              <label for="rstar-ap-email">Correo</label>
              <input type="email" id="rstar-ap-email" required maxlength="254" autocomplete="email" />
            </div>
          </div>
          <div class="rstar-campo">
            <label for="rstar-ap-comuna">Comuna</label>
            <input type="text" id="rstar-ap-comuna" required maxlength="100" autocomplete="address-level2" />
          </div>
        </fieldset>

        <fieldset class="rstar-grupo">
          <legend>Datos de la niña o el niño</legend>
          <div class="rstar-fila">
            <div class="rstar-campo">
              <label for="rstar-at-nombre">Nombre</label>
              <input type="text" id="rstar-at-nombre" required maxlength="80" />
            </div>
            <div class="rstar-campo">
              <label for="rstar-at-apellidos">Apellidos <span class="rstar-opcional">(opcional)</span></label>
              <input type="text" id="rstar-at-apellidos" maxlength="120" />
            </div>
          </div>
          <div class="rstar-campo">
            <label for="rstar-at-fecha">Fecha de nacimiento</label>
            <input type="date" id="rstar-at-fecha" required max="" />
          </div>
        </fieldset>

        <label class="rstar-check">
          <input type="checkbox" id="rstar-acepta" required />
          <span>
            Entiendo que el pago de hoy corresponde al Kit de Iniciación ($10.000) y que la
            primera mensualidad se paga aparte antes de la primera clase. Si ningún horario
            disponible es compatible con mi familia, el kit se reembolsa completo; si cambio de
            opinión sin ese problema, el pago queda como crédito Firehouse por 90 días.
          </span>
        </label>

        <p class="rstar-error" id="rstar-error" hidden></p>

        <div class="rstar-deshabilitado" id="rstar-deshabilitado" hidden>
          <p>Estamos terminando de habilitar el pago en línea. Escríbenos por WhatsApp y te ayudamos a inscribirte:</p>
          <a class="rstar-btn-quiet" href={whatsapp('ayudaRegistroStar')} target="_blank" rel="noopener">Escribir por WhatsApp →</a>
        </div>

        <button type="submit" class="rstar-btn" id="rstar-enviar">Pagar el Kit de Iniciación — $10.000 ⭐</button>

        <p class="rstar-ayuda">
          ¿Dudas antes de pagar?
          <a href={whatsapp('ayudaRegistroStar')} target="_blank" rel="noopener">Escríbenos por WhatsApp</a>
        </p>
      </form>
    </div>
  </section>

</Base>

<script>
  import { iniciarFormularioStar } from '../scripts/registro-star.ts';
  iniciarFormularioStar();
</script>

<script is:inline>
  // Tope de fecha de nacimiento = hoy, calculado en el navegador (evita
  // desfases de zona horaria del build estático).
  (() => {
    const input = document.getElementById('rstar-at-fecha');
    if (input) input.max = new Date().toISOString().slice(0, 10);
  })();
</script>

<style>
.rstar-section{ padding: var(--e-7) 0 var(--e-8); }
.rstar-wrap{ max-width: 640px; }
.rstar-eyebrow{
  font-family: var(--font-count); font-size: 11px; letter-spacing: .3em;
  color: var(--fire-yellow); text-transform: uppercase;
}
.rstar-titulo{ font-family: var(--font-display); font-weight: 800; font-size: clamp(1.8rem, 4vw, 2.6rem); margin-top: var(--e-2); }
.rstar-bajada{ color: var(--txt-soft); font-size: 15px; line-height: 1.6; margin-top: var(--e-3); max-width: 56ch; }
.rstar-bajada strong{ color: var(--chalk); }

.rstar-form{ margin-top: var(--e-6); display: flex; flex-direction: column; gap: var(--e-5); }
.rstar-grupo{ border: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--e-3); }
.rstar-grupo legend{
  font-family: var(--font-display); font-weight: 800; font-size: 15px; padding: 0 0 var(--e-2);
  border-bottom: 1px solid var(--hairline); width: 100%; margin-bottom: 4px;
}
.rstar-fila{ display: grid; grid-template-columns: 1fr 1fr; gap: var(--e-3); }
@media (max-width: 560px){ .rstar-fila{ grid-template-columns: 1fr; } }

.rstar-campo{ display: flex; flex-direction: column; gap: 6px; }
.rstar-campo label{ font-size: 13px; color: var(--txt-soft); font-family: var(--font-count); letter-spacing: .02em; }
.rstar-opcional{ color: var(--txt-faint); font-weight: 400; }
.rstar-campo input{
  background: var(--ember-deep); border: 1px solid var(--hairline); border-radius: 8px;
  padding: 12px 14px; color: var(--chalk); font-size: 15px; font-family: inherit;
}
.rstar-campo input:focus{ outline: none; border-color: var(--fire-yellow); }

.rstar-check{ display: flex; gap: 12px; align-items: flex-start; font-size: 13.5px; color: var(--txt-soft); line-height: 1.55; }
.rstar-check input{ flex: none; width: 18px; height: 18px; margin-top: 2px; accent-color: var(--fire-yellow); }

.campo-trampa{ position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

.rstar-error{ color: var(--fire-yellow); font-size: 14px; background: rgba(255,196,0,.1); border: 1px solid rgba(255,196,0,.3); padding: 12px 14px; border-radius: 8px; }

.rstar-deshabilitado{ background: var(--ember-deep); border-left: 4px solid var(--mat-blue); padding: var(--e-3) var(--e-4); font-size: 14px; color: var(--txt-soft); }
.rstar-deshabilitado p{ margin: 0 0 8px; }

.rstar-btn{
  display: flex; align-items: center; justify-content: center; min-height: 52px;
  background: var(--fire-red); color: #fff; font-weight: 800; font-size: 16px;
  font-family: var(--font-display); border: none; cursor: pointer;
  padding: 14px 30px; border-radius: var(--radio);
  transition: transform var(--t-interfaz) ease, background var(--t-interfaz) ease;
}
.rstar-btn:hover{ background: #a91111; transform: translateY(-2px); }
.rstar-btn:disabled{ opacity: .6; cursor: default; transform: none; }
.rstar-btn-quiet{ color: var(--fire-yellow); text-decoration: underline; font-size: 14px; }

.rstar-ayuda{ text-align: center; font-size: 13.5px; color: var(--txt-faint); }
.rstar-ayuda a{ color: var(--fire-yellow); }

@media (prefers-reduced-motion: reduce){
  .rstar-btn{ transition: none; }
  .rstar-btn:hover{ transform: none; }
}
</style>
