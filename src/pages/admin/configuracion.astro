---
import AdminBase from '../../layouts/AdminBase.astro';
---
<AdminBase titulo="Configuración">
  <a href="/admin" class="ficha-volver">← Volver al listado de casos</a>
  <h1 class="db-titulo">Configuración</h1>
  <p class="admin-intro">
    Días de clase de prueba, precios de cada programa y periodos de inscripción.
    Los cambios se aplican de inmediato.
  </p>

  <div id="cfg-error" class="admin-error" hidden></div>
  <p id="cfg-guardado" class="ficha-guardado" hidden>Cambios guardados.</p>

  <section class="admin-card">
    <p id="cfg-cargando" class="admin-spinner">Cargando…</p>

    <form id="cfg-form" hidden>
      <h2 class="ficha-bloque__titulo">Clase de prueba — días disponibles</h2>
      <p class="cfg-ayuda">Si desmarcas un día, deja de ofrecerse en el formulario público.</p>

      <label class="cfg-dia">
        <input type="checkbox" id="cfg-viernes" />
        <div>
          <p class="cfg-dia__nombre">Viernes</p>
          <p class="cfg-dia__detalle">Cheer, 18:00–20:00</p>
        </div>
      </label>

      <label class="cfg-dia">
        <input type="checkbox" id="cfg-sabado" />
        <div>
          <p class="cfg-dia__nombre">Sábado</p>
          <p class="cfg-dia__detalle">Gimnasia, 16:00–18:00</p>
        </div>
      </label>

      <button type="submit" class="admin-btn">Guardar</button>
    </form>
  </section>

  <section id="fm-seccion" class="admin-card cfg-seccion" hidden>
    <h2 class="ficha-bloque__titulo">Tu firma en los mensajes</h2>
    <p class="cfg-ayuda">Así te presentas en las plantillas de WhatsApp. El cargo lo define el administrador.</p>
    <form id="fm-form" class="fm-form" novalidate>
      <div>
        <label class="admin-label" for="fm-nombre">Tu nombre para mensajes</label>
        <input id="fm-nombre" class="admin-input" maxlength="60" placeholder="Ej.: Alejandro" />
      </div>
      <div>
        <p class="admin-label">Cargo</p>
        <p id="fm-cargo" class="fm-cargo"></p>
      </div>
      <button type="submit" class="admin-btn">Guardar</button>
    </form>
    <p class="fm-vista">Vista previa: <span id="fm-vista"></span></p>
    <p id="fm-guardado" class="ficha-guardado" hidden>Firma guardada.</p>
    <div id="fm-error" class="admin-error" hidden></div>
  </section>

  <div id="prg-aviso" class="admin-aviso-cerrado" hidden></div>

  <section id="prg-estado" class="admin-card cfg-seccion" hidden>
    <h2 class="ficha-bloque__titulo">Inscripciones hoy</h2>
    <div id="prg-estado-lista" class="prg-estado"></div>
  </section>

  <section id="prg-precios" class="admin-card cfg-seccion" hidden>
    <div class="prg-cabecera">
      <h2 class="ficha-bloque__titulo">Precios</h2>
      <div class="prg-temporada">
        <label class="admin-label" for="prg-temporada">Temporada</label>
        <select id="prg-temporada" class="admin-select"></select>
      </div>
    </div>

    <form id="prg-form-precios" novalidate>
      <h3 class="ficha-bloque__subtitulo">Por programa</h3>
      <div class="esq-scroll">
        <table class="esq-tabla prg-tabla">
          <thead><tr><th>Programa</th><th>Matrícula</th><th>Mensualidad</th></tr></thead>
          <tbody id="prg-filas-precios"></tbody>
        </table>
      </div>

      <h3 class="ficha-bloque__subtitulo">Precio hermanos (total mensual por dos)</h3>
      <div class="esq-scroll">
        <table class="esq-tabla prg-tabla">
          <thead><tr><th>Combinación</th><th>Total mensual</th><th>Por deportista</th></tr></thead>
          <tbody id="prg-filas-hermanos"></tbody>
        </table>
      </div>

      <div id="prg-precios-error" class="admin-error" hidden></div>
      <div class="ficha-acciones">
        <button type="submit" class="admin-btn">Guardar precios</button>
        <button type="button" id="prg-nueva-temporada" class="admin-btn admin-btn--secundario">Agregar temporada</button>
      </div>
      <p id="prg-precios-guardado" class="ficha-guardado" hidden>Precios guardados.</p>
    </form>
  </section>

  <section id="prg-periodos" class="admin-card cfg-seccion" hidden>
    <h2 class="ficha-bloque__titulo">Periodos de inscripción</h2>
    <p class="cfg-ayuda">
      Definen cuándo se puede inscribir alguien en cada programa. La fecha de inicio de
      clases es independiente: la inscripción puede abrir antes.
    </p>
    <div id="prg-solapes"></div>
    <div id="prg-lista-periodos"></div>

    <form id="prg-form-periodo" class="prg-form-periodo" novalidate>
      <h3 id="prg-form-titulo" class="ficha-bloque__subtitulo">Agregar periodo</h3>
      <div class="prg-campos">
        <div>
          <label class="admin-label" for="prg-p-programa">Programa</label>
          <select id="prg-p-programa" class="admin-select"></select>
        </div>
        <div>
          <label class="admin-label" for="prg-p-nombre">Nombre</label>
          <input id="prg-p-nombre" class="admin-input" maxlength="80" placeholder="Ej.: Pretemporada 2028" />
        </div>
        <div>
          <label class="admin-label" for="prg-p-abre">Abre</label>
          <input id="prg-p-abre" type="date" class="admin-input" />
        </div>
        <div>
          <label class="admin-label" for="prg-p-cierra">Cierra (opcional)</label>
          <input id="prg-p-cierra" type="date" class="admin-input" />
        </div>
        <div>
          <label class="admin-label" for="prg-p-clases">Inicio de clases (opcional)</label>
          <input id="prg-p-clases" type="date" class="admin-input" />
        </div>
      </div>
      <div id="prg-periodo-error" class="admin-error" hidden></div>
      <div class="ficha-acciones">
        <button type="submit" id="prg-p-guardar" class="admin-btn">Agregar periodo</button>
        <button type="button" id="prg-p-cancelar" class="admin-btn admin-btn--secundario" hidden>Cancelar edición</button>
      </div>
    </form>
  </section>
</AdminBase>

<script>
  import { iniciarConfiguracion } from '../../scripts/admin-configuracion.ts';
  iniciarConfiguracion();
</script>

<style is:global>
.cfg-dia{
  display: flex; align-items: center; gap: 14px; padding: 14px 0;
  border-bottom: 1px solid #EFEBE4; cursor: pointer;
}
.cfg-dia:last-of-type{ border-bottom: none; margin-bottom: 20px; }
.cfg-dia input{ width: 22px; height: 22px; accent-color: var(--fire-red); flex-shrink: 0; }
.cfg-dia__nombre{ font-weight: 600; margin: 0; }
.cfg-dia__detalle{ font-size: 13px; color: #6B6259; margin: 2px 0 0; }
</style>
