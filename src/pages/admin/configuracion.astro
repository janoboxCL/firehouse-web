---
import AdminBase from '../../layouts/AdminBase.astro';
---
<AdminBase titulo="Configuración">
  <a href="/admin" class="ficha-volver">← Volver al listado de casos</a>
  <h1 class="db-titulo">Configuración</h1>
  <p class="admin-intro">
    Todo lo que el CRM y el sitio usan como parámetro se edita aquí. Los cambios se aplican
    de inmediato.
  </p>

  <nav class="cfg-indice" aria-label="Secciones">
    <a href="#cfg-clase-prueba">Clase de prueba</a>
    <a href="#st-seccion">Horario Star</a>
    <a href="#prg-precios">Precios</a>
    <a href="#prg-periodos">Periodos de inscripción</a>
    <a href="#cb-seccion">Cobros</a>
    <a href="#tl-seccion">Tallas</a>
    <a href="#fm-seccion">Tu firma</a>
    <a href="#us-seccion">Usuarios</a>
    <a href="#ps-seccion">Pasarelas de pago</a>
  </nav>

  <div id="cfg-error" class="admin-error" hidden></div>
  <p id="cfg-guardado" class="ficha-guardado" hidden>Cambios guardados.</p>
  <div id="ac-aviso" class="admin-aviso-cerrado" hidden></div>

  <section class="admin-card" id="cfg-clase-prueba">
    <p id="cfg-cargando" class="admin-spinner">Cargando…</p>

    <form id="cfg-form" hidden novalidate>
      <h2 class="ficha-bloque__titulo">Clase de prueba: días y horarios</h2>
      <p class="cfg-ayuda">Si desmarcas un día, deja de ofrecerse en el formulario público. El horario aparece en el formulario y en el correo de confirmación.</p>

      <div class="cfg-dia">
        <label class="cfg-dia__check"><input type="checkbox" id="cfg-viernes" /> <span class="cfg-dia__nombre">Viernes</span></label>
        <div class="cfg-dia__horario" data-horario="VIERNES">
          <input class="admin-input" data-campo="disciplina" maxlength="40" placeholder="Disciplina" aria-label="Disciplina del viernes" />
          <input class="admin-input" type="time" data-campo="inicio" aria-label="Hora de inicio del viernes" />
          <input class="admin-input" type="time" data-campo="fin" aria-label="Hora de término del viernes" />
        </div>
      </div>

      <div class="cfg-dia">
        <label class="cfg-dia__check"><input type="checkbox" id="cfg-sabado" /> <span class="cfg-dia__nombre">Sábado</span></label>
        <div class="cfg-dia__horario" data-horario="SABADO">
          <input class="admin-input" data-campo="disciplina" maxlength="40" placeholder="Disciplina" aria-label="Disciplina del sábado" />
          <input class="admin-input" type="time" data-campo="inicio" aria-label="Hora de inicio del sábado" />
          <input class="admin-input" type="time" data-campo="fin" aria-label="Hora de término del sábado" />
        </div>
      </div>

      <p class="cfg-ayuda">La clase de prueba de Firehouse Star usa el horario de Star (siguiente sección).</p>
      <button type="submit" class="admin-btn">Guardar días y horarios</button>
    </form>
  </section>

  <section id="st-seccion" class="admin-card cfg-seccion" hidden>
    <h2 class="ficha-bloque__titulo">Firehouse Star: horario</h2>
    <p class="cfg-ayuda">
      Las clases son semanales desde la primera clase. Se usa para agendar las clases de prueba Star,
      en los correos y mensajes, en la mensualidad proporcional y en la página de Firehouse Star.
    </p>
    <form id="st-form" class="cfg-campos" novalidate>
      <div>
        <label class="admin-label" for="st-primera">Primera clase</label>
        <input id="st-primera" type="date" class="admin-input" />
      </div>
      <div>
        <label class="admin-label" for="st-inicio">Hora de inicio</label>
        <input id="st-inicio" type="time" class="admin-input" />
      </div>
      <div>
        <label class="admin-label" for="st-fin">Hora de término</label>
        <input id="st-fin" type="time" class="admin-input" />
      </div>
      <button type="submit" class="admin-btn">Guardar horario</button>
    </form>
    <p class="cfg-vista" id="st-vista"></p>
    <p class="ficha-guardado" data-ok="st" hidden>Horario guardado.</p>
    <div class="admin-error" data-error="st" hidden></div>
  </section>

  <section id="fm-seccion" class="admin-card cfg-seccion" hidden>
    <h2 class="ficha-bloque__titulo">Tu firma en los mensajes</h2>
    <p class="cfg-ayuda">Así te presentas en las plantillas de WhatsApp. El cargo lo define el administrador.</p>
    <form id="fm-form" class="fm-form" novalidate>
      <div>
        <label class="admin-label" for="fm-nombre">Tu nombre para mensajes</label>
        <input id="fm-nombre" class="admin-input" maxlength="60" placeholder="Ej.: Alejandro" />
      </div>
      <div>
        <p class="admin-label">Cargo</p>
        <p id="fm-cargo" class="fm-cargo"></p>
      </div>
      <button type="submit" class="admin-btn">Guardar</button>
    </form>
    <p class="fm-vista">Vista previa: <span id="fm-vista"></span></p>
    <p id="fm-guardado" class="ficha-guardado" hidden>Firma guardada.</p>
    <div id="fm-error" class="admin-error" hidden></div>
  </section>

  <div id="prg-aviso" class="admin-aviso-cerrado" hidden></div>

  <section id="prg-estado" class="admin-card cfg-seccion" hidden>
    <h2 class="ficha-bloque__titulo">Inscripciones hoy</h2>
    <div id="prg-estado-lista" class="prg-estado"></div>
  </section>

  <section id="prg-precios" class="admin-card cfg-seccion" hidden>
    <div class="prg-cabecera">
      <h2 class="ficha-bloque__titulo">Precios</h2>
      <div class="prg-temporada">
        <label class="admin-label" for="prg-temporada">Temporada</label>
        <select id="prg-temporada" class="admin-select"></select>
      </div>
    </div>

    <form id="prg-form-precios" novalidate>
      <h3 class="ficha-bloque__subtitulo">Por programa</h3>
      <div class="esq-scroll">
        <table class="esq-tabla prg-tabla">
          <thead><tr><th>Programa</th><th>Matrícula</th><th>Mensualidad</th></tr></thead>
          <tbody id="prg-filas-precios"></tbody>
        </table>
      </div>

      <h3 class="ficha-bloque__subtitulo">Precio hermanos (total mensual por dos)</h3>
      <div class="esq-scroll">
        <table class="esq-tabla prg-tabla">
          <thead><tr><th>Combinación</th><th>Total mensual</th><th>Por deportista</th></tr></thead>
          <tbody id="prg-filas-hermanos"></tbody>
        </table>
      </div>

      <div id="prg-precios-error" class="admin-error" hidden></div>
      <div class="ficha-acciones">
        <button type="submit" class="admin-btn">Guardar precios</button>
        <button type="button" id="prg-nueva-temporada" class="admin-btn admin-btn--secundario">Agregar temporada</button>
      </div>
      <p id="prg-precios-guardado" class="ficha-guardado" hidden>Precios guardados.</p>
    </form>
  </section>

  <section id="prg-periodos" class="admin-card cfg-seccion" hidden>
    <h2 class="ficha-bloque__titulo">Periodos de inscripción</h2>
    <p class="cfg-ayuda">
      Definen cuándo se puede inscribir alguien en cada programa. La fecha de inicio de
      clases es independiente: la inscripción puede abrir antes.
    </p>
    <div id="prg-solapes"></div>
    <div id="prg-lista-periodos"></div>

    <form id="prg-form-periodo" class="prg-form-periodo" novalidate>
      <h3 id="prg-form-titulo" class="ficha-bloque__subtitulo">Agregar periodo</h3>
      <div class="prg-campos">
        <div>
          <label class="admin-label" for="prg-p-programa">Programa</label>
          <select id="prg-p-programa" class="admin-select"></select>
        </div>
        <div>
          <label class="admin-label" for="prg-p-nombre">Nombre</label>
          <input id="prg-p-nombre" class="admin-input" maxlength="80" placeholder="Ej.: Pretemporada 2028" />
        </div>
        <div>
          <label class="admin-label" for="prg-p-abre">Abre</label>
          <input id="prg-p-abre" type="date" class="admin-input" />
        </div>
        <div>
          <label class="admin-label" for="prg-p-cierra">Cierra (opcional)</label>
          <input id="prg-p-cierra" type="date" class="admin-input" />
        </div>
        <div>
          <label class="admin-label" for="prg-p-clases">Inicio de clases (opcional)</label>
          <input id="prg-p-clases" type="date" class="admin-input" />
        </div>
      </div>
      <div id="prg-periodo-error" class="admin-error" hidden></div>
      <div class="ficha-acciones">
        <button type="submit" id="prg-p-guardar" class="admin-btn">Agregar periodo</button>
        <button type="button" id="prg-p-cancelar" class="admin-btn admin-btn--secundario" hidden>Cancelar edición</button>
      </div>
    </form>
  </section>

  <section id="cb-seccion" class="admin-card cfg-seccion" hidden>
    <h2 class="ficha-bloque__titulo">Cobros</h2>
    <p class="cfg-ayuda">Se aplican a las mensualidades que se generen desde ahora; los cargos ya creados no cambian.</p>
    <form id="cb-form" novalidate>
      <div class="cfg-campos">
        <div>
          <label class="admin-label" for="cb-vencimiento">Día de vencimiento de la mensualidad</label>
          <input id="cb-vencimiento" type="number" min="1" max="28" class="admin-input" />
        </div>
      </div>
      <h3 class="ficha-bloque__subtitulo">Mensualidad proporcional según la semana de la primera clase</h3>
      <div class="esq-scroll">
        <table class="esq-tabla prg-tabla">
          <thead><tr><th>Primera clase en</th><th>% de la mensualidad</th><th>Ejemplo Star</th></tr></thead>
          <tbody id="cb-prorrateo"></tbody>
        </table>
      </div>
      <button type="submit" class="admin-btn">Guardar cobros</button>
    </form>
    <p class="ficha-guardado" data-ok="cb" hidden>Cobros guardados.</p>
    <div class="admin-error" data-error="cb" hidden></div>
  </section>

  <section id="tl-seccion" class="admin-card cfg-seccion" hidden>
    <h2 class="ficha-bloque__titulo">Tallas de polera</h2>
    <p class="cfg-ayuda">Separadas por coma, en el orden en que quieres verlas en la ficha y en clase de prueba.</p>
    <form id="tl-form" class="cfg-campos cfg-campos--ancho" novalidate>
      <div>
        <label class="admin-label" for="tl-lista">Tallas</label>
        <input id="tl-lista" class="admin-input" placeholder="4, 6, 8, 10, 12, 14, 16, XS, S, M, L, XL" />
      </div>
      <button type="submit" class="admin-btn">Guardar tallas</button>
    </form>
    <p class="ficha-guardado" data-ok="tl" hidden>Tallas guardadas.</p>
    <div class="admin-error" data-error="tl" hidden></div>
  </section>

  <section id="us-seccion" class="admin-card cfg-seccion" hidden>
    <h2 class="ficha-bloque__titulo">Usuarios del CRM</h2>
    <p class="cfg-ayuda" id="us-ayuda">El cargo define cómo se presenta cada persona en los mensajes. Solo un usuario con rol ADMIN puede cambiarlo.</p>
    <div class="esq-scroll">
      <table class="esq-tabla">
        <thead><tr><th>Usuario</th><th>Firma</th><th>Rol</th><th>Cargo</th></tr></thead>
        <tbody id="us-lista"></tbody>
      </table>
    </div>
    <p class="ficha-guardado" data-ok="us" hidden>Cargo actualizado.</p>
    <div class="admin-error" data-error="us" hidden></div>
  </section>

  <section id="ps-seccion" class="admin-card cfg-seccion" hidden>
    <h2 class="ficha-bloque__titulo">Pasarelas de pago</h2>
    <p class="cfg-ayuda">
      Definen con qué se cobra el registro Firehouse Star y la Campaña 2026. La página de pago familiar
      (/pagar) usa siempre Mercado Pago. Solo un usuario con rol ADMIN puede cambiarlas.
    </p>
    <ul id="ps-lista" class="ps-lista"></ul>
    <p class="ficha-guardado" data-ok="ps" hidden>Pasarelas actualizadas.</p>
    <div class="admin-error" data-error="ps" hidden></div>
  </section>
</AdminBase>

<script>
  import { iniciarConfiguracion } from '../../scripts/admin-configuracion.ts';
  iniciarConfiguracion();
</script>

<style is:global>
.cfg-indice{ display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 0 0 20px; font-size: 13px; }
.cfg-indice a{ color: var(--ember); text-decoration: underline; text-decoration-color: #D8D2C8; text-underline-offset: 3px; }
.cfg-indice a:hover{ color: var(--fire-red); }
.cfg-dia{ display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; padding: 14px 0; border-bottom: 1px solid #EFEBE4; }
.cfg-dia__check{ display: flex; align-items: center; gap: 12px; min-width: 120px; cursor: pointer; }
.cfg-dia__check input{ width: 22px; height: 22px; accent-color: var(--fire-red); flex-shrink: 0; }
.cfg-dia__nombre{ font-weight: 600; margin: 0; }
.cfg-dia__horario{ display: grid; grid-template-columns: minmax(140px, 1.4fr) repeat(2, minmax(110px, 1fr)); gap: 10px; flex: 1 1 380px; }
#cfg-form > .admin-btn{ margin-top: 12px; }
.cfg-campos{ display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 14px; align-items: end; margin-bottom: 14px; }
.cfg-campos--ancho{ grid-template-columns: minmax(220px, 1fr) auto; }
.cfg-vista{ font-size: 13px; color: #6B6259; margin: 4px 0 0; }
.cb-pct{ max-width: 110px; }
.ps-lista{ list-style: none; padding: 0; margin: 0; }
.ps-item{ display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 0; border-top: 1px solid #EFEBE4; }
.ps-item:first-child{ border-top: 0; }
.ps-item__nombre{ font-weight: 600; margin: 0; }
.ps-item__estado{ display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
.ps-item__acciones{ display: flex; flex-wrap: wrap; gap: 8px; }
.ps-item__acciones .admin-btn{ min-height: 36px; padding: 8px 14px; font-size: 13px; }
@media (max-width: 600px){ .cfg-dia__horario{ grid-template-columns: 1fr 1fr; } .cfg-dia__horario [data-campo="disciplina"]{ grid-column: 1 / -1; } .cfg-campos--ancho{ grid-template-columns: 1fr; } }
</style>
