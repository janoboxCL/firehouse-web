---
import { sitio, whatsapp } from '../data/sitio.js';
---
<section class="hero">
  <div class="hero__fondo" aria-hidden="true">
    <div class="hero__respaldo">
      <span class="plano plano--carbon"></span>
      <span class="plano plano--tapiz"></span>
      <span class="plano plano--fuego"></span>
    </div>

    <video class="hero__video" autoplay muted loop playsinline poster="/media/hero-poster.jpg">
      <source src="/media/hero.webm" type="video/webm" />
      <source src="/media/hero.mp4" type="video/mp4" />
    </video>

    <div class="hero__velo"></div>
  </div>

  <div class="wrap hero__contenido">
    <p class="count">5 · 6 · 7 · 8</p>

    <h1 class="hero__titular">
      <span class="hero__linea">En marzo no sabía dar una voltereta.</span>{' '}
      <span class="hero__linea hero__remate">En octubre estaba compitiendo.</span>
    </h1>

    <p class="hero__bajada">
      Cheerleading en {sitio.ciudad}, para niñas y niños desde los
      {sitio.edadMinima} años. Se empieza sin experiencia previa y se entrena para competir.
    </p>

    <p class="hero__acciones">
      <a class="btn" href={whatsapp('hero')} target="_blank" rel="noopener">Ven a una clase de prueba gratis</a>
      <a class="btn-quiet" href="/#precios">Ver cuánto cuesta la temporada</a>
    </p>
  </div>

  <ul class="hero__datos">
    {sitio.horarios.map(h => <li>{h.dia} {h.hora}</li>)}
    <li>{sitio.comuna}</li>
  </ul>
</section>

<style>
.hero{ position:relative; overflow:hidden; isolation:isolate; }

.hero__fondo{ position:absolute; inset:0; z-index:-1; }

/* Solo se ve si el video falta o no carga */
.hero__respaldo{ position:absolute; inset:0; overflow:hidden; background:var(--ember); }
.plano{ position:absolute; display:block; transform:rotate(var(--tilt)); }
.plano--carbon{ left:-10%; top:18%;  width:64%; height:140%; background:var(--ember-deep); }
.plano--tapiz { right:-14%; top:-30%; width:52%; height:120%; background:var(--mat-blue); opacity:.40; }
.plano--fuego { left:24%;  top:-10%; width:26%; height:130%; background:var(--fire-red); opacity:.30; }

.hero__video{
  position:absolute; inset:0; width:100%; height:100%; object-fit:cover;
  /* El gimnasio está mal iluminado: esto recupera contraste y color sin tocar el archivo */
  filter:contrast(1.12) saturate(1.18) brightness(1.06);
}

/* Mucho más liviano que antes: el titular se sostiene con su propia sombra */
.hero__velo{
  position:absolute; inset:0;
  background:
    radial-gradient(ellipse 62% 52% at 50% 44%, rgba(23,20,18,.52) 0%, rgba(23,20,18,.10) 100%),
    linear-gradient(180deg, rgba(23,20,18,.42) 0%, rgba(23,20,18,0) 34%, rgba(23,20,18,.55) 100%);
}

.hero__contenido{ position:relative; padding-block:150px 104px; text-align:center; }

.hero__titular{
  font-size:clamp(2.1rem, 4.6vw, 3.5rem);
  max-width:100%;
  margin:var(--e-3) auto 0;
  text-shadow:0 2px 26px rgba(23,20,18,.85), 0 1px 3px rgba(23,20,18,.9);
}
/* En escritorio cada frase ocupa su línea; en móvil el navegador reparte solo */
.hero__linea{ display:inline; }
.hero__remate{ color:var(--fire-yellow); }
@media (min-width:900px){
  .hero__linea{ display:block; }
}

.hero__bajada{
  color:var(--txt-soft); max-width:56ch; margin:var(--e-3) auto var(--e-4);
  font-size:clamp(1.05rem, 1.5vw, 1.25rem);
  text-shadow:0 1px 14px rgba(23,20,18,.95);
}
.hero__acciones{ display:flex; flex-direction:column; align-items:center; gap:var(--e-2); }
.hero__acciones .btn-quiet{ color:rgba(245,239,232,.8); text-shadow:0 1px 10px rgba(23,20,18,.9); }

/* El corte diagonal se reemplaza por dos reglas: rojo sobre azul de tapiz */
.hero__datos{
  position:relative;
  display:flex; justify-content:center; flex-wrap:wrap; gap:0;
  list-style:none; margin:0; padding:0;
  font-size:14px; color:var(--txt-soft);
  background:var(--ember-deep);
  border-top:var(--regla) solid var(--fire-red);
  border-bottom:var(--regla) solid var(--mat-blue);
}
.hero__datos li{ padding:var(--e-2) var(--e-4); }
.hero__datos li + li{ border-left:0.5px solid var(--hairline); }

@media (max-width:640px){
  .hero__contenido{ padding-block:96px 80px; }
  .hero__datos{ font-size:12.5px; }
  .hero__datos li{ padding:12px 16px; }
}
</style>
