---
import Base from '../layouts/Base.astro';
import BandaFoto from '../components/BandaFoto.astro';
import { whatsapp } from '../data/sitio.js';
import { COMUNAS_CHILE, REGIONES_COMUNAS } from '../lib/crm/comunas.ts';
import {
  RELACION_APODERADO,
  RELACION_APODERADO_LABEL,
  COMO_CONOCIO_OPCIONES,
  COMO_CONOCIO_LABEL,
  CANAL_PREFERIDO,
  CANAL_PREFERIDO_LABEL,
  LIMITES,
} from '../lib/crm/constants.ts';

const comunasRM = REGIONES_COMUNAS.find((r) => r.region === 'Metropolitana de Santiago')!.comunas;

const titulo = 'Registro Firehouse | Cuéntanos sobre tu familia';
const descripcion = 'Registra tus datos para conocer las opciones de Firehouse Cheer: Pretemporada, temporada 2027 o renovación.';
---
<Base titulo={titulo} descripcion={descripcion} ruta="/registro">
  <BandaFoto src="/media/banda-llegada.jpg"
             alt="Niñas y niños llegando al gimnasio antes de empezar el entrenamiento en Firehouse"
             alto="bajo" foco="center 46%" />

  <section class="section registro">
    <div class="wrap registro__wrap">

      <div id="form-cabecera" class="registro__cabecera reveal">
        <p class="count">Registro</p>
        <h1 class="registro__titulo">Registro Firehouse</h1>
        <p class="registro__bajada">Cuéntanos un poco sobre tu familia para poder orientarte mejor.</p>
        <p class="registro__tiempo">⏱ No te tomará más de 3 minutos</p>
      </div>

      <form id="form-registro" class="registro__form reveal" novalidate>
        <div class="registro__stepper-sticky">
          <ol class="progreso" aria-label="Progreso del formulario">
            <li data-progreso-item="1" class="activo">
              <span class="progreso__circulo">1</span>
              <span class="progreso__texto-item">Apoderado</span>
            </li>
            <li data-progreso-item="2">
              <span class="progreso__circulo">2</span>
              <span class="progreso__texto-item">Atleta</span>
            </li>
            <li data-progreso-item="3">
              <span class="progreso__circulo">3</span>
              <span class="progreso__texto-item">Contacto</span>
            </li>
          </ol>
          <p class="progreso__texto" id="texto-paso">Paso 1 de 3</p>
        </div>

        <input type="hidden" id="f-submission-id" />
        <input type="hidden" id="f-started-at" />

        <!-- Trampa anti-bot: invisible para personas, visible para robots que llenan todo. -->
        <div class="campo-trampa" aria-hidden="true">
          <label for="f-honeypot">Deja este campo vacío</label>
          <input id="f-honeypot" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div id="error-envio" class="banner-error" role="alert" hidden></div>

        <!-- ================= PASO 1 — APODERADO ================= -->
        <fieldset data-paso="1">
          <legend class="paso__titulo">Tus datos</legend>
          <p class="paso__intro">Necesitamos estos datos para poder contactarte y orientarte sobre Firehouse.</p>

          <div class="campo">
            <label for="f-nombre">Nombre</label>
            <input id="f-nombre" type="text" maxlength={LIMITES.NOMBRE_MAX} required autocomplete="given-name" />
          </div>

          <div class="campo">
            <label for="f-apellidos">Apellidos</label>
            <input id="f-apellidos" type="text" maxlength={LIMITES.APELLIDOS_MAX} required autocomplete="family-name" />
          </div>

          <div class="campo">
            <label for="f-telefono">Celular / WhatsApp</label>
            <input id="f-telefono" type="tel" inputmode="tel" placeholder="9 1234 5678" required autocomplete="tel" />
          </div>

          <div class="campo">
            <label for="f-email">Correo electrónico</label>
            <input id="f-email" type="email" maxlength={LIMITES.EMAIL_MAX} required autocomplete="email" />
            <p class="campo__validacion" id="email-feedback" aria-live="polite"></p>
          </div>

          <div class="campo">
            <p class="campo__label">Relación con el/la atleta</p>
            <div class="pills">
              {Object.entries(RELACION_APODERADO).map(([, valor]) => (
                <label class="pill">
                  <input type="radio" name="relacion" value={valor} required={valor === RELACION_APODERADO.MAMA} />
                  {RELACION_APODERADO_LABEL[valor]}
                </label>
              ))}
            </div>
          </div>

          <div class="campo">
            <label for="f-comuna-rm">Comuna</label>
            <select id="f-comuna-rm" required>
              <option value="">Selecciona tu comuna</option>
              {comunasRM.map((c) => <option value={c}>{c}</option>)}
              <option value="OTRA">Otra (fuera de la Región Metropolitana)</option>
            </select>
            <div class="campo campo--anidado" id="comuna-otra-wrap" hidden>
              <label for="f-comuna-otra">¿Cuál es tu comuna?</label>
              <input id="f-comuna-otra" type="text" list="lista-comunas" maxlength={LIMITES.COMUNA_MAX} autocomplete="address-level2" />
              <datalist id="lista-comunas">
                {COMUNAS_CHILE.map((c) => <option value={c} />)}
              </datalist>
            </div>
          </div>

          <div class="campo">
            <label for="f-telefono-secundario">Segundo teléfono <span class="campo__opcional">(opcional)</span></label>
            <input id="f-telefono-secundario" type="tel" inputmode="tel" placeholder="9 1234 5678" autocomplete="tel" />
          </div>

          <p class="campo__privacidad">
            Usaremos estos datos exclusivamente para gestionar tu contacto con Firehouse y los procesos
            relacionados con la academia.
          </p>

          <div class="paso__nav">
            <span></span>
            <button type="button" class="btn" data-accion="siguiente">Siguiente</button>
          </div>
        </fieldset>

        <!-- ================= PASO 2 — ATLETA(S) ================= -->
        <fieldset data-paso="2" hidden>
          <legend class="paso__titulo">Datos del/la atleta</legend>

          <div id="atletas-lista"></div>

          <button type="button" id="btn-agregar-atleta" class="btn-agregar">+ Agregar otro/a atleta</button>

          <div class="paso__nav">
            <button type="button" class="btn-quiet" data-accion="atras">Atrás</button>
            <button type="button" class="btn" data-accion="siguiente">Siguiente</button>
          </div>
        </fieldset>

        <!-- ================= PASO 3 — CONTACTO Y ORIGEN ================= -->
        <fieldset data-paso="3" hidden>
          <legend class="paso__titulo">Para finalizar</legend>

          <div class="campo">
            <label for="f-como-conocio">¿Cómo conociste Firehouse?</label>
            <select id="f-como-conocio" required>
              <option value="">Selecciona una opción</option>
              {Object.entries(COMO_CONOCIO_OPCIONES).map(([, valor]) => (
                <option value={valor}>{COMO_CONOCIO_LABEL[valor]}</option>
              ))}
            </select>
          </div>

          <div class="campo">
            <p class="campo__label">¿Cómo prefieres que te contactemos?</p>
            <div class="pills">
              {Object.entries(CANAL_PREFERIDO).map(([, valor]) => (
                <label class="pill">
                  <input type="radio" name="canalPreferido" value={valor} required={valor === CANAL_PREFERIDO.WHATSAPP} />
                  {CANAL_PREFERIDO_LABEL[valor]}
                </label>
              ))}
            </div>
            <p class="campo__ayuda-canal">
              Para confirmar tu inscripción te enviaremos un correo de confirmación.
              Los siguientes contactos serán por la vía que prefieras.
            </p>
          </div>

          <div class="campo">
            <label for="f-comentario">¿Quieres contarnos algo más? <span class="campo__opcional">(opcional)</span></label>
            <textarea id="f-comentario" maxlength={LIMITES.COMENTARIO_INICIAL_MAX} rows="4"></textarea>
            <p class="campo__contador" id="contador-comentario">0 / {LIMITES.COMENTARIO_INICIAL_MAX}</p>
          </div>

          <label class="campo-consentimiento">
            <input id="f-consent" type="checkbox" required />
            <span>
              Autorizo a Firehouse a contactarme mediante los datos proporcionados para responder mi
              solicitud y entregarme información relacionada con la academia. He leído la
              <a href="/privacidad" target="_blank" rel="noopener">Política de Privacidad</a>.
            </span>
          </label>

          <div class="paso__nav">
            <button type="button" class="btn-quiet" data-accion="atras">Atrás</button>
            <button type="submit" id="btn-enviar" class="btn btn-enviar">ENVIAR REGISTRO</button>
          </div>
        </fieldset>
      </form>

      <div id="pantalla-exito" class="registro__exito" hidden>
        <p class="registro__exito-emoji">🔥</p>
        <h2>¡Listo!</h2>
        <p id="exito-texto"></p>
        <p>
          Gracias por interesarte en Firehouse. Revisaremos la información y nos comunicaremos contigo
          para orientarte sobre la alternativa más adecuada.
        </p>
        <a class="btn" href={whatsapp('registro')} target="_blank" rel="noopener">Hablar con Firehouse por WhatsApp</a>
        <p><a class="btn-quiet" href="/">Volver al inicio</a></p>
      </div>

    </div>
  </section>
</Base>

<script>
  import { iniciarFormularioRegistro } from '../scripts/registro-form.ts';
  iniciarFormularioRegistro();
</script>

<style is:global>
.registro{ padding-top: var(--e-6); }
.registro__wrap{ max-width: 760px; }

.registro__cabecera{ margin-bottom: var(--e-4); }
.registro__titulo{
  font-family: var(--font-display); font-weight: 800;
  font-size: clamp(2rem, 5vw, 2.9rem); margin-top: var(--e-2);
}
.registro__bajada{ color: var(--txt-soft); margin-top: var(--e-2); max-width: 56ch; }

.registro__tiempo{
  display: inline-flex; align-items: center; gap: 8px;
  margin-top: var(--e-3); background: rgba(255,196,0,.12); color: var(--fire-yellow);
  border-radius: 999px; padding: 8px 16px; font-size: 13px; font-weight: 600;
}

/* Va pegado (sticky) arriba de la tarjeta mientras se hace scroll dentro del
   formulario, para que nunca se pierda de vista qué paso es — ni siquiera con
   el teclado del celular abierto tapando la parte de arriba de la página. */
.registro__stepper-sticky{
  position: sticky; top: 78px; z-index: 5;
  background: var(--ember-deep);
  margin: calc(-1 * var(--e-5)) calc(-1 * var(--e-5)) var(--e-4);
  padding: var(--e-4) var(--e-5) var(--e-3);
  border-bottom: 1px solid var(--hairline);
  border-radius: 20px 20px 0 0;
}
@media (min-width: 640px){
  .registro__stepper-sticky{
    top: 100px;
    margin: calc(-1 * var(--e-6)) calc(-1 * var(--e-6)) var(--e-4);
    padding: var(--e-4) var(--e-6) var(--e-3);
  }
}

.progreso{
  list-style: none; display: flex; margin: 0; padding: 0; position: relative;
}
.progreso li{
  flex: 1; position: relative; display: flex; flex-direction: column; align-items: center;
  gap: 10px; font-family: var(--font-body); font-size: 13px; color: var(--txt-faint); text-align: center;
}
.progreso li:not(:last-child)::after{
  content: ''; position: absolute; top: 21px; left: 50%; width: 100%; height: 2px;
  background: var(--hairline); z-index: 0;
}
.progreso li.completado:not(:last-child)::after{ background: var(--fire-red); }

.progreso__circulo{
  position: relative; z-index: 1;
  width: 42px; height: 42px; border-radius: 999px;
  display: flex; align-items: center; justify-content: center;
  background: var(--ember-deep); border: 2px solid var(--hairline);
  font-family: var(--font-count); font-weight: 700; font-size: 15px; color: var(--txt-faint);
  transition: all var(--t-interfaz) ease;
}
.progreso li.activo .progreso__circulo{
  border-color: var(--fire-yellow); color: var(--fire-yellow); background: rgba(255,196,0,.14);
  box-shadow: 0 0 0 6px rgba(255,196,0,.12);
}
.progreso li.completado .progreso__circulo{
  border-color: var(--fire-red); background: var(--fire-red); color: transparent;
}
.progreso li.completado .progreso__circulo::after{
  content: '✓'; position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 17px; font-family: var(--font-body);
}
.progreso__texto-item{ font-weight: 500; }
.progreso li.activo .progreso__texto-item{ color: var(--fire-yellow); font-weight: 700; }
.progreso li.completado .progreso__texto-item{ color: var(--txt-soft); }

.progreso__texto{
  margin-top: var(--e-3); font-family: var(--font-count); font-weight: 700;
  font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: var(--txt-soft);
}

.registro__form{
  background: var(--ember-deep); border-radius: 20px; padding: var(--e-5);
  border: 1px solid var(--hairline);
}
@media (min-width: 640px){ .registro__form{ padding: var(--e-6); } }

/* Transición suave al cambiar de paso */
fieldset[data-paso]:not([hidden]){ animation: registroPasoEntra 320ms ease both; }
@keyframes registroPasoEntra{ from{ opacity: 0; transform: translateY(10px); } to{ opacity: 1; transform: none; } }
@media (prefers-reduced-motion: reduce){ fieldset[data-paso]{ animation: none !important; } }

.paso__titulo{ font-family: var(--font-display); font-weight: 800; font-size: 1.6rem; padding: 0; }
.paso__intro{ color: var(--txt-soft); margin-top: var(--e-2); margin-bottom: var(--e-4); }

.campo{ margin-top: var(--e-4); }
.campo label, .campo__label{
  display: block; font-family: var(--font-body); font-weight: 500; font-size: 14px;
  color: var(--txt-soft); margin-bottom: 8px;
}
.campo__opcional{ color: var(--txt-faint); font-weight: 400; }
.campo--anidada, .campo--anidado{
  margin-top: var(--e-3); padding: var(--e-3); border-radius: 12px;
  background: rgba(245,239,232,.04); border: 1px solid var(--hairline);
}
.campo__validacion{ margin-top: 6px; font-size: 13px; min-height: 1.2em; }
.campo__validacion.valido{ color: var(--fire-yellow); }
.campo__validacion.invalido{ color: rgba(197,21,21,.85); }

input[type="text"], input[type="tel"], input[type="email"], input[type="date"], select, textarea{
  width: 100%; box-sizing: border-box;
  background: var(--ember); color: var(--chalk);
  border: 1px solid var(--hairline); border-radius: 12px;
  padding: 14px 16px; font-family: var(--font-body); font-size: 16px;
  min-height: 48px; transition: border-color 150ms ease, box-shadow 150ms ease, background 150ms ease;
}
textarea{ min-height: 96px; resize: vertical; }
input:focus-visible, select:focus-visible, textarea:focus-visible{
  outline: none; border-color: var(--fire-yellow);
  box-shadow: 0 0 0 4px rgba(255,196,0,.20);
}
/* Sólo mostramos el aviso de campo inválido después de que la persona ya interactuó
   con el campo (clase .tocado agregada al perder el foco) — nunca antes de escribir. */
input.tocado:invalid, select.tocado:invalid, textarea.tocado:invalid{
  border-color: rgba(197,21,21,.5); background: rgba(197,21,21,.05);
}
input.tocado:invalid:focus-visible, select.tocado:invalid:focus-visible, textarea.tocado:invalid:focus-visible{
  box-shadow: 0 0 0 4px rgba(197,21,21,.16);
}

.campo__ayuda{ margin-top: 6px; font-size: 13px; color: var(--fire-yellow); min-height: 1em; }
.campo__ayuda-canal{ margin-top: 10px; font-size: 13px; color: var(--txt-faint); line-height: 1.5; }
.campo__contador{ margin-top: 6px; font-size: 12px; color: var(--txt-faint); text-align: right; }
.campo__privacidad{ margin-top: var(--e-4); font-size: 13px; color: var(--txt-faint); }

.pills{ display: flex; flex-wrap: wrap; gap: 10px; }
.pill{
  display: inline-flex; align-items: center; gap: 8px;
  border: 1px solid var(--hairline); border-radius: 999px;
  padding: 12px 18px; font-size: 15px; cursor: pointer; min-height: 44px;
  transition: border-color 150ms ease, background 150ms ease;
}
.pill:has(input:checked){ border-color: var(--fire-yellow); background: rgba(255,196,0,.1); }
.pill input{ accent-color: var(--fire-yellow); }

.tarjetas-interes{ display: grid; gap: 12px; }
.tarjeta-interes{
  display: block; border: 1px solid var(--hairline); border-radius: 14px;
  padding: 16px; cursor: pointer; transition: border-color 150ms ease, background 150ms ease;
}
.tarjeta-interes:has(input:checked){ border-color: var(--fire-yellow); background: rgba(255,196,0,.08); }
.tarjeta-interes input{ position: absolute; opacity: 0; pointer-events: none; }
.tarjeta-interes__titulo{ display: block; font-family: var(--font-display); font-weight: 800; font-size: 1.05rem; }
.tarjeta-interes__texto{ display: block; margin-top: 6px; color: var(--txt-soft); font-size: 14px; }

.atleta-card{
  border: 1px solid var(--hairline); border-radius: 16px; padding: var(--e-4);
  margin-top: var(--e-4); background: var(--ember);
}
.atleta-card:first-of-type{ margin-top: var(--e-3); }
.atleta-card__cabecera{ display: flex; align-items: center; justify-content: space-between; }
.atleta-card__titulo{ font-family: var(--font-display); font-weight: 800; font-size: 1.1rem; }
.atleta-card__eliminar{
  background: none; border: none; color: var(--txt-faint); text-decoration: underline;
  font-size: 13px; cursor: pointer; padding: 8px;
}
.atleta-card__bloque{ margin-top: var(--e-3); }

.btn-agregar{
  display: flex; align-items: center; justify-content: center; gap: 10px;
  width: 100%; margin-top: var(--e-4); min-height: 52px;
  background: transparent; color: var(--fire-yellow);
  border: 2px dashed rgba(255,196,0,.4); border-radius: 14px;
  padding: 16px; font-family: var(--font-body); font-weight: 600; font-size: 15px;
  cursor: pointer; transition: border-color 150ms ease, background 150ms ease, transform 150ms ease;
}
.btn-agregar:hover{ border-color: var(--fire-yellow); background: rgba(255,196,0,.08); transform: translateY(-1px); }
.btn-agregar:focus-visible{ outline: none; border-color: var(--fire-yellow); box-shadow: 0 0 0 4px rgba(255,196,0,.2); }

.campo-consentimiento{
  display: flex; gap: 12px; align-items: flex-start; margin-top: var(--e-5);
  font-size: 14px; color: var(--txt-soft); cursor: pointer;
}
.campo-consentimiento input{ margin-top: 4px; width: 20px; height: 20px; accent-color: var(--fire-yellow); flex: none; }
.campo-consentimiento a{ color: var(--fire-yellow); text-decoration: underline; }

.paso__nav{
  display: flex; align-items: center; justify-content: space-between;
  margin-top: var(--e-6); gap: var(--e-3);
}
.btn-enviar{ min-width: 220px; text-align: center; }
.btn.cargando{ opacity: .75; pointer-events: none; }

.banner-error{
  background: rgba(197,21,21,.15); border: 1px solid var(--fire-red); color: var(--chalk);
  border-radius: 12px; padding: 14px 16px; margin-bottom: var(--e-4); font-size: 14px;
}

.campo-trampa{ position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

.registro__exito{ text-align: center; padding: var(--e-7) var(--e-4); }
.registro__exito-emoji{ font-size: 3rem; margin: 0; }
.registro__exito h2{ font-family: var(--font-display); font-size: 2.2rem; margin-top: var(--e-3); }
.registro__exito p{ color: var(--txt-soft); margin-top: var(--e-3); max-width: 46ch; margin-inline: auto; }
.registro__exito .btn{ margin-top: var(--e-5); }
.registro__exito .btn-quiet{ display: inline-block; margin-top: var(--e-4); }

@media (max-width: 640px){
  .registro{ padding-top: var(--e-5); }
  .registro__form{ border-radius: 16px; padding: var(--e-4); }
  .registro__stepper-sticky{
    top: 62px;
    margin: calc(-1 * var(--e-4)) calc(-1 * var(--e-4)) var(--e-3);
    padding: var(--e-3) var(--e-4) var(--e-2);
    border-radius: 16px 16px 0 0;
  }
  .progreso__circulo{ width: 36px; height: 36px; font-size: 13px; }
  .progreso li:not(:last-child)::after{ top: 18px; }
  .progreso li{ font-size: 11px; }
  .paso__nav{ flex-direction: column-reverse; align-items: stretch; }
  .paso__nav .btn, .paso__nav .btn-quiet{ text-align: center; }
}
</style>
</Base>
