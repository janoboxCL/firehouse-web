---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import BandaFoto from '../components/BandaFoto.astro';
import Sparky from '../components/Sparky.astro';
import { sitio } from '../data/sitio.js';

const titulo = 'Firehouse Star — cheerleading desde cero para niñas y niños desde 4 años | Firehouse Cheer';
const descripcion = 'Firehouse Star es la primera experiencia Firehouse: una clase semanal de cheerleading para empezar desde cero, sin necesidad de experiencia previa. Sábados en La Cisterna.';

const preguntas = [
  { p: 'Mi hijo nunca ha hecho cheer.',
    r: 'Perfecto. Firehouse Star está pensado justamente para empezar desde cero.' },
  { p: '¿Tiene que saber hacer piruetas?',
    r: 'No. La clase parte con movimientos y ejercicios adaptados a su nivel, sin ninguna base previa.' },
  { p: '¿Es muy exigente?',
    r: 'Es una clase semanal de 90 minutos donde se mezclan movimiento, juegos y fundamentos del cheer. No es un entrenamiento de competencia.' },
  { p: '¿Va a competir?',
    r: 'No. Firehouse Star no compite: es la puerta de entrada al cheer. Si en marzo de 2027 quiere sumarse a un equipo de competencia, puede iniciar el proceso de incorporación a la temporada en ese momento.' },
  { p: '¿Existe clase de prueba?',
    r: 'Durante esta etapa, Firehouse Star funciona por inscripción directa, sin clase de prueba gratuita. Para bajar el riesgo de esa decisión, si ningún horario disponible resulta compatible con tu familia, la inscripción se reembolsa completa; y si te arrepientes antes de la primera clase sin que exista ese problema, el pago queda como crédito Firehouse por 90 días, para este hijo o para un hermano.' },
  { p: '¿Existe permanencia mínima?',
    r: 'No. La mensualidad funciona mes a mes, igual que en el resto de Firehouse.' },
  { p: '¿Qué pasa si me inscribo a mitad de mes?',
    r: 'La mensualidad se ajusta a las clases que queden en el mes: se paga solo por las semanas de clase a las que efectivamente se llega, nunca el mes completo si se entra después de la primera semana.' },
];
---
<Base titulo={titulo} descripcion={descripcion} ruta="/firehouse-star" preguntas={preguntas} miga="Firehouse Star">

  <!-- ============ HERO ============ -->
  <section class="star-hero">
    <div class="star-hero__fondo" aria-hidden="true">
      <picture>
        <source srcset="/media/dia-cheer.webp" type="image/webp" />
        <img class="star-hero__img" src="/media/dia-cheer.jpg" alt="" loading="eager" />
      </picture>
      <div class="star-hero__velo"></div>
      <span class="star-chispa star-chispa--1">⭐</span>
      <span class="star-chispa star-chispa--2">⭐</span>
      <span class="star-chispa star-chispa--3">⭐</span>
      <span class="star-chispa star-chispa--4">⭐</span>
    </div>

    <div class="star-hero__sparky-wrap">
      <Sparky pose="wave" size={104} class="sparky--flota" />
    </div>

    <div class="wrap star-hero__contenido">
      <p class="star-count reveal star-reveal-1">SÁBADOS · 16:00 – 17:30</p>
      <h1 class="star-hero__titulo reveal star-reveal-2">No necesita saber cheer.<br />Solo tener ganas de empezar. ⭐</h1>
      <p class="star-hero__bajada reveal star-reveal-3">
        Firehouse Star es la primera experiencia Firehouse para niñas y niños desde los 4 años
        que quieren descubrir el cheer desde cero.
      </p>

      <ul class="star-datos reveal star-reveal-4">
        <li>
          <svg class="star-datos__icono" viewBox="0 0 48 48" aria-hidden="true"><path d="M24 4 29.4 18.1 45 19.2 33.4 29.2 37 44 24 35.8 11 44 14.6 29.2 3 19.2 18.6 18.1Z" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linejoin="round"/></svg>
          <span>Edad</span><b>Desde 4 años</b>
        </li>
        <li>
          <svg class="star-datos__icono" viewBox="0 0 48 48" aria-hidden="true"><rect x="6" y="10" width="36" height="32" rx="4" fill="none" stroke="currentColor" stroke-width="3.2"/><path d="M6 19h36" stroke="currentColor" stroke-width="3.2"/><path d="M15 6v9M33 6v9" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/></svg>
          <span>Cuándo</span><b>Sábados</b>
        </li>
        <li>
          <svg class="star-datos__icono" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="18" fill="none" stroke="currentColor" stroke-width="3.2"/><path d="M24 14v10l8 5" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Duración</span><b>90 minutos</b>
        </li>
        <li>
          <svg class="star-datos__icono" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="18" fill="none" stroke="currentColor" stroke-width="3.2"/><text x="24" y="31" text-anchor="middle" font-weight="800" font-size="20" fill="currentColor">$</text></svg>
          <span>Mensualidad</span><b>$30.000</b>
        </li>
      </ul>

      <p class="star-hero__cta reveal star-reveal-5">
        <a class="star-btn star-btn--brilla" href="/registro" id="wa-star-hero">QUIERO EMPEZAR EN STAR ⭐</a>
        <a class="star-btn-quiet" href="#clase">¿Qué va a hacer en la clase?</a>
      </p>
    </div>
  </section>

  <!-- ============ SPARKY TAMPOCO SABÍA CHEER ============ -->
  <section class="star-section star-section--objeto">
    <svg class="star-objeto star-objeto--sol" viewBox="0 0 120 120" aria-hidden="true">
      <path d="M60 8 74.6 45.2 114 47.9 83.6 73.1 93.4 111.4 60 89.2 26.6 111.4 36.4 73.1 6 47.9 45.4 45.2 60 8Z"
            fill="none" stroke="currentColor" stroke-width="5" stroke-linejoin="round"/>
    </svg>
    <div class="wrap star-split">
      <div class="star-panel-img reveal">
        <Sparky pose="dizzy" size={220} class="sparky--flota" alt="Sparky mareado, intentando un movimiento sencillo" />
      </div>
      <div class="reveal star-reveal-2">
        <p class="star-eyebrow">La idea central</p>
        <h2 class="star-title">Sparky tampoco sabía cheer.</h2>
        <p class="star-parrafo">
          Y eso está perfecto.<br />
          Porque aquí no tienen que llegar sabiendo.<br />
          Aquí vienen a aprender y a divertirse.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ ASÍ SE VIVE UNA CLASE STAR ============ -->
  <section class="star-section star-section--panel" id="clase">
    <div class="wrap">
      <p class="star-eyebrow">Así se vive una clase Star</p>
      <h2 class="star-title">¿Qué va a hacer realmente durante 90 minutos?</h2>

      <ol class="star-escenas">
        <li class="star-escena reveal">
          <div class="star-escena__img">
            <picture>
              <source srcset="/media/star/escena-activamos.webp" type="image/webp" />
              <img src="/media/star/escena-activamos.jpg" alt="Sparky y los niños estirando antes de empezar la clase Star" loading="lazy" decoding="async" />
            </picture>
          </div>
          <div class="star-escena__texto">
            <span class="star-escena__num">1</span>
            <h3>Nos activamos 🔥</h3>
            <p>Empezamos moviéndonos, entrando en calor y preparando el cuerpo.</p>
          </div>
        </li>
        <li class="star-escena reveal">
          <div class="star-escena__img">
            <picture>
              <source srcset="/media/star/escena-jugamos.webp" type="image/webp" />
              <img src="/media/star/escena-jugamos.jpg" alt="Sparky y los niños en un circuito de conos, jugando y moviéndose" loading="lazy" decoding="async" />
            </picture>
          </div>
          <div class="star-escena__texto">
            <span class="star-escena__num">2</span>
            <h3>Jugamos y nos movemos 🎯</h3>
            <p>Juegos, circuitos y pequeños desafíos para moverse, reaccionar y coordinar.</p>
          </div>
        </li>
        <li class="star-escena reveal">
          <div class="star-escena__img">
            <picture>
              <source srcset="/media/star/escena-descubrimos.webp" type="image/webp" />
              <img src="/media/star/escena-descubrimos.jpg" alt="Niños de Star practicando una posición de cheer junto a Sparky" loading="lazy" decoding="async" />
            </picture>
          </div>
          <div class="star-escena__texto">
            <span class="star-escena__num">3</span>
            <h3>Descubrimos el cheer ⭐</h3>
            <p>Aprendemos posiciones, movimientos, saltos y fundamentos adaptados a cada nivel.</p>
          </div>
        </li>
        <li class="star-escena reveal">
          <div class="star-escena__img">
            <picture>
              <source srcset="/media/star/escena-juntos.webp" type="image/webp" />
              <img src="/media/star/escena-juntos.jpg" alt="Sparky y los niños de Star con las manos juntas al centro, en equipo" loading="lazy" decoding="async" />
            </picture>
          </div>
          <div class="star-escena__texto">
            <span class="star-escena__num">4</span>
            <h3>Lo hacemos juntos 🙌</h3>
            <p>Aprendemos a escuchar, esperar, colaborar y trabajar con otros.</p>
          </div>
        </li>
        <li class="star-escena reveal">
          <div class="star-escena__img">
            <picture>
              <source srcset="/media/star/escena-celebramos.webp" type="image/webp" />
              <img src="/media/star/escena-celebramos.jpg" alt="Sparky y los niños de Star celebrando saltando, con estrellas alrededor" loading="lazy" decoding="async" />
            </picture>
          </div>
          <div class="star-escena__texto">
            <span class="star-escena__num">5</span>
            <h3>Celebramos lo aprendido 🎉</h3>
            <p>Cada clase termina con algo nuevo que intentamos, aprendimos o conseguimos.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ============ LO QUE VA APRENDIENDO ============ -->
  <section class="star-section">
    <div class="wrap">
      <p class="star-eyebrow">Qué obtiene</p>
      <h2 class="star-title">Lo que va aprendiendo</h2>

      <div class="star-grid5">
        <div class="star-card reveal">
          <svg class="star-card__icono" viewBox="0 0 48 48" aria-hidden="true"><path d="M20 4 10 26h10L14 44 36 18H24Z" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linejoin="round"/></svg>
          <h3>Movimiento</h3><p>Equilibrio, coordinación, fuerza y control corporal.</p>
        </div>
        <div class="star-card reveal">
          <svg class="star-card__icono" viewBox="0 0 48 48" aria-hidden="true"><path d="M24 4 29.4 18.1 45 19.2 33.4 29.2 37 44 24 35.8 11 44 14.6 29.2 3 19.2 18.6 18.1Z" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linejoin="round"/></svg>
          <h3>Cheer</h3><p>Primeros movimientos y fundamentos adaptados a su nivel.</p>
        </div>
        <div class="star-card reveal">
          <svg class="star-card__icono" viewBox="0 0 48 48" aria-hidden="true"><circle cx="16" cy="14" r="6" fill="none" stroke="currentColor" stroke-width="3.2"/><circle cx="32" cy="14" r="6" fill="none" stroke="currentColor" stroke-width="3.2"/><path d="M4 40c0-8 5-13 12-13s12 5 12 13M20 40c0-8 5-13 12-13s12 5 12 13" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/></svg>
          <h3>Equipo</h3><p>Escuchar, participar y hacer cosas junto a otros.</p>
        </div>
        <div class="star-card reveal">
          <svg class="star-card__icono" viewBox="0 0 48 48" aria-hidden="true"><path d="M24 4c0 3-3 5-6 5-1.5 0-2 1-1 2.5 1.5 2.5 1 4.5-1 6.5-2.5 2.5-4 5.5-4 9 0 6 5 10 12 10s12-4 12-10c0-3.5-1.5-6.5-4-8.5.3 2.5-1 4-3 4-2.5 0-3.5-2-2.5-4.5C28 14 24 9 24 4Z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/></svg>
          <h3>Atreverse</h3><p>Intentar cosas nuevas, equivocarse y volver a probar.</p>
        </div>
        <div class="star-card reveal">
          <svg class="star-card__icono" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="18" fill="none" stroke="currentColor" stroke-width="3.2"/><circle cx="17" cy="20" r="2.4" fill="currentColor"/><circle cx="31" cy="20" r="2.4" fill="currentColor"/><path d="M15 29c2.5 4 6 6 9 6s6.5-2 9-6" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/></svg>
          <h3>Diversión</h3><p>Porque queremos que disfrute y tenga ganas de volver.</p>
        </div>
      </div>
    </div>
  </section>

  <BandaFoto src="/media/gal-equipo.jpg"
             alt="Deportistas de Firehouse de distintas edades junto al coach en el tapete, incluyendo niñas pequeñas"
             frase="Todos tuvieron alguna vez una primera clase."
             alto="medio" foco="center 38%" />

  <!-- ============ ¿NUNCA HA HECHO CHEER? ============ -->
  <section class="star-section star-section--panel">
    <div class="wrap star-nunca">
      <p class="star-eyebrow reveal">La objeción número uno</p>
      <h2 class="star-title reveal">¿Nunca ha hecho cheer?</h2>
      <p class="star-nunca__grande reveal">Perfecto.</p>
      <p class="star-parrafo reveal">
        Firehouse Star está pensado justamente para empezar desde cero.<br />
        No necesita saber hacer piruetas.<br />
        No necesita haber entrenado antes.<br />
        No necesita llegar preparado.<br />
        Y no tiene que decidir hoy si quiere competir.
      </p>
    </div>
  </section>

  <!-- ============ PRECIO ============ -->
  <section class="star-section" id="precio">
    <div class="wrap">
      <p class="star-eyebrow">Empezar es simple</p>
      <h2 class="star-title">Cuánto cuesta empezar</h2>

      <div class="star-precio">
        <div class="star-precio__bloque star-precio__bloque--primero reveal">
          <span class="star-precio__etq">Primer pago — antes de la primera clase</span>
          <span class="star-precio__num">$40.000<svg class="star-precio__chispa" viewBox="0 0 48 48" aria-hidden="true"><path d="M24 4 29.4 18.1 45 19.2 33.4 29.2 37 44 24 35.8 11 44 14.6 29.2 3 19.2 18.6 18.1Z" fill="currentColor"/></svg></span>
          <ul class="star-precio__desglose">
            <li><span>Inscripción Star</span><b>$10.000</b></li>
            <li><span>Primera mensualidad</span><b>$30.000</b></li>
          </ul>
        </div>
        <div class="star-precio__bloque reveal">
          <span class="star-precio__etq">Desde el segundo mes</span>
          <span class="star-precio__num">$30.000<small>/mes</small></span>
          <p class="star-precio__inc">Incluye 1 clase semanal de 90 minutos, sábados 16:00–17:30.</p>
        </div>
      </div>

      <p class="star-nota">Pago mes a mes, sin permanencia obligatoria. La inscripción incluye el kit de bienvenida.</p>

      <div class="star-prorrateo reveal">
        <p class="star-prorrateo__titulo">¿Te inscribes a mitad de mes? Pagas solo lo que queda:</p>
        <table class="star-tabla">
          <thead>
            <tr><th>Ingresas en</th><th>Pagas ese mes</th></tr>
          </thead>
          <tbody>
            <tr><td>Semana 1</td><td>$30.000 <span class="star-tabla__nota">(mes completo)</span></td></tr>
            <tr><td>Semana 2</td><td>$22.500</td></tr>
            <tr><td>Semana 3</td><td>$15.000</td></tr>
            <tr><td>Semana 4</td><td>$7.500</td></tr>
          </tbody>
        </table>
      </div>

      <div class="star-politica reveal">
        <p class="star-politica__titulo">Sin clase de prueba, con esta garantía:</p>
        <ul class="star-politica__lista">
          <li><b>Si el problema es nuestro</b> — ningún horario disponible resulta compatible con tu familia — reembolsamos completa la inscripción de $10.000.</li>
          <li><b>Si cambias de opinión</b> antes de la primera clase, sin que exista ese problema, el pago no se devuelve en dinero, pero queda como <b>crédito Firehouse por 90 días</b>, usable para este hijo o un hermano.</li>
        </ul>
      </div>

      <p class="star-hero__cta">
        <a class="star-btn" href="/registro" id="wa-star-precio">QUEREMOS INSCRIBIRNOS EN STAR ⭐</a>
      </p>
    </div>
  </section>

  <!-- ============ KIT DE BIENVENIDA ============ -->
  <section class="star-section star-section--panel">
    <div class="wrap">
      <p class="star-eyebrow">Incluido en la inscripción</p>
      <h2 class="star-title">Starter Pack Firehouse Star</h2>
      <div class="star-grid5 star-grid5--pack">
        <div class="star-card reveal">
          <svg class="star-card__icono" viewBox="0 0 48 48" aria-hidden="true"><path d="M16 6 6 14l6 6 4-3v25h16V17l4 3 6-6-10-8c0 3-3 5-6 5s-6-2-6-5Z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/></svg>
          <h3>Polera de entrenamiento</h3><p>Polera oficial Firehouse Star, para todos.</p>
        </div>
        <div class="star-card reveal">
          <svg class="star-card__icono" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="14" fill="none" stroke="currentColor" stroke-width="6"/><path d="M24 10c3 2 3 4 0 6M24 38c3-2 3-4 0-6" stroke="currentColor" stroke-width="3" stroke-linecap="round" fill="none"/></svg>
          <h3>Accesorio (niñas)</h3><p>Scrunchie Firehouse para el pelo, incluido para las niñas.</p>
        </div>
      </div>
    </div>
  </section>

  <Faq preguntas={preguntas} titulo="Antes de decidir" />

  <!-- ============ CTA FINAL ============ -->
  <section class="star-cierre star-section--objeto">
    <svg class="star-objeto star-objeto--mono" viewBox="0 0 120 120" aria-hidden="true">
      <path d="M60 8 74.6 45.2 114 47.9 83.6 73.1 93.4 111.4 60 89.2 26.6 111.4 36.4 73.1 6 47.9 45.4 45.2 60 8Z"
            fill="none" stroke="currentColor" stroke-width="5" stroke-linejoin="round"/>
    </svg>
    <div class="wrap reveal">
      <Sparky pose="excited" size={110} class="sparky--salta" />
      <h2 class="star-title">¿Empezamos? ⭐</h2>
      <p class="star-parrafo star-parrafo--centro">No tiene que llegar sabiendo.<br />Solo tiene que empezar.</p>
      <a class="star-btn star-btn--brilla" href="/registro" id="wa-star-cierre">QUEREMOS INSCRIBIRNOS EN FIREHOUSE STAR</a>
      <p class="star-nota">Sábados 16:00–17:30 · Santa Corina 197, La Cisterna</p>
    </div>
  </section>

</Base>

<style>
/*
  Paleta Firehouse Star: se apoya en los tokens de marca (sin inventar
  colores nuevos). El amarillo pasa a ser el acento dominante —
  coherente con la estrella y con "sal brillando"— y los botones usan
  color sólido, sin degradados decorativos, según preferencia expresa.
*/

.star-eyebrow{
  font-family: var(--font-count); font-size: 11px; letter-spacing: .3em;
  color: var(--fire-yellow); text-transform: uppercase;
  display: flex; align-items: center; gap: 12px;
}
.star-eyebrow::before{ content:''; width:30px; height:3px; background: rgba(245,239,232,.38); transform: skewX(var(--tilt-sm)); }

.star-count{
  display: inline-flex; align-items: center; gap: 14px;
  font-family: var(--font-count); font-weight: 700; font-size: 14px; letter-spacing: .28em;
  color: var(--fire-yellow); margin-bottom: var(--e-2);
}
.star-count::before, .star-count::after{ content:''; width:30px; height:3px; background: var(--fire-yellow); transform: skewX(var(--tilt-sm)); }

.star-title{ font-family: var(--font-display); font-weight: 800; font-size: clamp(1.7rem, 3.6vw, 2.6rem); line-height: 1.05; margin-top: var(--e-3); }
.star-parrafo{ color: var(--txt-soft); max-width: var(--wrap-texto); margin-top: var(--e-3); font-size: clamp(1rem,1.5vw,1.15rem); line-height: 1.6; }
.star-parrafo--centro{ margin-inline: auto; text-align: center; }
.star-nota{ color: var(--txt-faint); font-size: 14px; margin-top: var(--e-3); max-width: var(--wrap-texto); }

/* Botón sólido — sin degradados, color con significado (amarillo = Star) */
.star-btn{
  display: inline-flex; align-items: center; justify-content: center; min-height: 48px;
  background: var(--fire-yellow); color: var(--ember); font-weight: 800; font-size: 16px;
  font-family: var(--font-display);
  padding: 14px 30px; border-radius: var(--radio); text-decoration: none;
  transition: transform var(--t-interfaz) ease, background var(--t-interfaz) ease;
}
.star-btn:hover{ background: #E6B000; transform: translateY(-2px); }
.star-btn:focus-visible{ outline: 3px solid var(--chalk); outline-offset: 3px; }

/* Brillo pulsante reservado a los dos CTA de mayor peso (hero y cierre) —
   referencia literal a "sal brillando", no decoración genérica */
.star-btn--brilla{ animation: star-brillo 2.6s ease-in-out infinite; }
.star-btn--brilla:hover{ animation-play-state: paused; }
@keyframes star-brillo{
  0%, 100% { box-shadow: 0 0 0 0 rgba(255,196,0,.55); }
  50%      { box-shadow: 0 0 0 10px rgba(255,196,0,0); }
}
.star-btn-quiet{ color: rgba(245,239,232,.78); font-size: 15px; text-decoration: underline; }
.star-hero__cta{ display: flex; flex-direction: column; align-items: center; gap: var(--e-2); margin-top: var(--e-5); }

/* ---- Hero ---- */
.star-hero{ position: relative; overflow: hidden; isolation: isolate; border-bottom: 3px solid var(--fire-yellow); }
.star-hero__fondo{ position: absolute; inset: 0; z-index: -1; }
.star-hero__fondo img{ position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
.star-hero__velo{
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse 70% 55% at 18% 12%, rgba(255,196,0,.24) 0%, rgba(255,196,0,0) 60%),
    linear-gradient(180deg, rgba(23,20,18,.72) 0%, rgba(23,20,18,.50) 45%, rgba(23,20,18,.92) 100%);
}
.star-hero__sparky-wrap{ position: absolute; right: 6%; bottom: 0; z-index: 1; animation: star-sparky-entra 900ms 300ms cubic-bezier(.22,.61,.36,1) both; }
@media (max-width: 700px){ .star-hero__sparky-wrap{ right: 4%; width: 72px; } }
@keyframes star-sparky-entra{
  0%   { transform: translateY(46px) scale(.7); opacity: 0; }
  60%  { transform: translateY(-8px) scale(1.04); opacity: 1; }
