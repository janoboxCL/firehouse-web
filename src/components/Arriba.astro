---
// Volver arriba. Aparece recién después de dos pantallas y no ocupa lugar antes.
---
<button class="arriba" id="arriba" type="button" aria-label="Volver al inicio de la página" hidden>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
</button>

<style>
.arriba{
  position:fixed; right:20px; bottom:20px; z-index:40;
  width:48px; height:48px; padding:12px;
  border:1.5px solid var(--hairline); border-radius:var(--radio);
  background:rgba(32,29,27,.92); backdrop-filter:blur(6px);
  color:var(--chalk); cursor:pointer;
  opacity:0; transform:translateY(8px);
  transition:opacity var(--t-interfaz) ease, transform var(--t-interfaz) ease,
             border-color var(--t-interfaz) ease;
}
.arriba[hidden]{ display:none; }
.arriba.visible{ opacity:1; transform:none; }
.arriba:hover{ border-color:var(--fire-yellow); color:var(--fire-yellow); }
.arriba:focus-visible{ outline:3px solid var(--fire-yellow); outline-offset:3px; }
.arriba svg{ width:100%; height:100%; display:block; }

@media (prefers-reduced-motion: reduce){
  .arriba{ transition:none; transform:none; }
}
</style>

<script is:inline>
  (() => {
    const b = document.getElementById('arriba');
    if (!b) return;
    const umbral = () => window.innerHeight * 2;
    const revisar = () => {
      const mostrar = window.scrollY > umbral();
      b.hidden = !mostrar;
      requestAnimationFrame(() => b.classList.toggle('visible', mostrar));
    };
    b.addEventListener('click', () => {
      const suave = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: suave ? 'smooth' : 'auto' });
    });
    revisar();
    window.addEventListener('scroll', revisar, { passive: true });
  })();
</script>
