---
import AdminBase from '../../layouts/AdminBase.astro';
import {
  CRM_ESTADOS,
  CRM_ESTADOS_LABEL,
  CRM_JOURNEYS,
  CRM_JOURNEYS_LABEL,
  PRIORIDAD_OPCIONES,
  INTERACCION_TIPOS,
  INTERACCION_TIPOS_LABEL,
  LIMITES,
} from '../../lib/crm/constants.ts';
---
<AdminBase titulo="Ficha del caso">
  <a href="/admin" class="ficha-volver">← Volver al listado</a>

  <div id="ficha-error" class="admin-error" hidden></div>
  <p id="ficha-cargando" class="admin-spinner">Cargando caso…</p>

  <div id="ficha-contenido" hidden>
    <div id="ficha-duplicado" class="admin-error ficha-duplicado" hidden>
      Posible registro duplicado: ya existe un apoderado con el mismo teléfono o correo.
    </div>

    <div class="ficha-grid">
      <div class="ficha-col">
        <section class="admin-card ficha-bloque">
          <h2 class="ficha-bloque__titulo">Atleta</h2>
          <dl class="ficha-datos" id="bloque-atleta"></dl>
        </section>

        <section class="admin-card ficha-bloque">
          <h2 class="ficha-bloque__titulo">Apoderado</h2>
          <dl class="ficha-datos" id="bloque-apoderado"></dl>
          <div class="ficha-acciones">
            <a id="btn-whatsapp" class="admin-btn" href="#" target="_blank" rel="noopener">WhatsApp</a>
            <a id="btn-email" class="admin-btn admin-btn--secundario" href="#">Email</a>
            <button type="button" id="btn-copiar-telefono" class="admin-btn admin-btn--secundario">Copiar teléfono</button>
          </div>
          <p class="ficha-whatsapp-nota">El botón de WhatsApp abre la conversación con un mensaje sugerido — puedes editarlo antes de enviarlo.</p>
        </section>
      </div>

      <div class="ficha-col">
        <section class="admin-card ficha-bloque">
          <h2 class="ficha-bloque__titulo">Gestión CRM</h2>
          <p id="ficha-sin-accion" class="ficha-aviso" hidden>Este caso no tiene próxima acción.</p>

          <form id="form-gestion">
            <div class="admin-campo">
              <label class="admin-label" for="g-journey">Categoría (journey)</label>
              <select id="g-journey" class="admin-select">
                {Object.values(CRM_JOURNEYS).map((v) => <option value={v}>{CRM_JOURNEYS_LABEL[v]}</option>)}
              </select>
              <p class="ficha-ayuda-journey">Si un caso quedó "Por clasificar", cámbialo aquí una vez que hables con la familia.</p>
            </div>
            <div class="admin-campo">
              <label class="admin-label" for="g-estado">Estado</label>
              <select id="g-estado" class="admin-select">
                {Object.values(CRM_ESTADOS).map((v) => <option value={v}>{CRM_ESTADOS_LABEL[v]}</option>)}
              </select>
            </div>
            <div class="admin-campo">
              <label class="admin-label" for="g-responsable">Responsable</label>
              <select id="g-responsable" class="admin-select">
                <option value="">Sin asignar</option>
              </select>
            </div>
            <div class="admin-campo">
              <label class="admin-label" for="g-proxima-accion">Próxima acción</label>
              <input id="g-proxima-accion" class="admin-input" type="text" maxlength={LIMITES.PROXIMA_ACCION_MAX} placeholder="Ej: Invitar a clase" />
            </div>
            <div class="admin-campo">
              <label class="admin-label" for="g-fecha">Fecha próxima acción</label>
              <input id="g-fecha" class="admin-input" type="datetime-local" />
            </div>
            <div class="admin-campo">
              <label class="admin-label" for="g-prioridad">Prioridad</label>
              <select id="g-prioridad" class="admin-select">
                {Object.values(PRIORIDAD_OPCIONES).map((v) => <option value={v}>{v === 'ALTA' ? 'Alta' : 'Normal'}</option>)}
              </select>
            </div>
            <button type="submit" id="btn-guardar-gestion" class="admin-btn">Guardar cambios</button>
            <p id="gestion-guardado" class="ficha-guardado" hidden>Cambios guardados.</p>
          </form>
        </section>
      </div>
    </div>

    <section class="admin-card ficha-bloque ficha-historial">
      <h2 class="ficha-bloque__titulo">Historial</h2>
      <ol id="ficha-timeline" class="ficha-timeline"></ol>

      <form id="form-interaccion" class="ficha-nueva-interaccion">
        <p class="ficha-bloque__subtitulo">+ Agregar nota / interacción</p>
        <div class="ficha-nueva-interaccion__fila">
          <select id="i-tipo" class="admin-select">
            {Object.values(INTERACCION_TIPOS).filter((v) => v !== 'CAMBIO_ESTADO').map((v) => (
              <option value={v}>{INTERACCION_TIPOS_LABEL[v]}</option>
            ))}
          </select>
        </div>
        <textarea id="i-nota" class="admin-textarea" maxlength={LIMITES.NOTA_INTERACCION_MAX} placeholder="Nota…" required></textarea>
        <p class="ficha-contador" id="i-contador">0 / {LIMITES.NOTA_INTERACCION_MAX}</p>
        <button type="submit" id="btn-agregar-interaccion" class="admin-btn admin-btn--secundario">Agregar</button>
      </form>
    </section>

    <section class="admin-card ficha-bloque ficha-peligro">
      <h2 class="ficha-bloque__titulo">Eliminar</h2>
      <p class="ficha-peligro__texto">
        Esto borra el registro definitivamente, incluyendo todo su historial de
        interacciones. No se puede deshacer.
      </p>
      <div class="ficha-acciones">
        <button type="button" id="btn-eliminar-atleta" class="admin-btn admin-btn--peligro">
          Eliminar este atleta y su caso
        </button>
        <button type="button" id="btn-eliminar-apoderado" class="admin-btn admin-btn--peligro">
          Eliminar todo el registro del apoderado
        </button>
      </div>
    </section>
  </div>
</AdminBase>

<script>
  import { iniciarFicha } from '../../scripts/admin-caso.ts';
  iniciarFicha();
</script>

<style is:global>
.ficha-nueva-interaccion{ border-top: 1px solid #EFEBE4; padding-top: 20px; }
.ficha-nueva-interaccion__fila{ max-width: 220px; margin-bottom: 10px; }
.ficha-contador{ font-size: 12px; color: #6B6259; text-align: right; margin: 6px 0 12px; }
.ficha-whatsapp-nota{ font-size: 12px; color: #6B6259; margin-top: 10px; }
</style>
