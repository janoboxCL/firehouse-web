---
import '../styles/tokens.css';
import '../styles/crm-paleta.css';

const { titulo, ocultarCabecera = false } = Astro.props;

// Secciones de uso diario (barra superior en escritorio; las cuatro primeras
// también van en la barra de pestañas del celular). El resto queda en «Más».
const PRINCIPALES = [
  { href: '/admin/clase-prueba', texto: 'Clase de hoy', icono: 'clase' },
  { href: '/admin/deportistas', texto: 'Deportistas', icono: 'deportistas' },
  { href: '/admin/asistencia', texto: 'Asistencia', icono: 'asistencia' },
  { href: '/admin/estadisticas', texto: 'Estadísticas', icono: 'estadisticas' },
  { href: '/admin', texto: 'Casos', icono: '' },
  { href: '/admin/pagos', texto: 'Pagos', icono: '' },
];
const SECUNDARIOS = [
  { href: '/admin/apoderados', texto: 'Contactos' },
  { href: '/admin/plantillas', texto: 'Plantillas' },
  { href: '/admin/concurso', texto: 'Concurso' },
  { href: '/admin/campana-2026', texto: 'Campaña 2026' },
  { href: '/admin/configuracion', texto: 'Configuración' },
  { href: '/admin/esquema', texto: 'Esquema de datos' },
];
const ruta = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/admin';
const activo = (href: string) => ruta === href;
// En el celular, «Más» también agrupa Casos y Pagos.
const masActivo = SECUNDARIOS.some((e) => activo(e.href)) || PRINCIPALES.slice(4).some((e) => activo(e.href));
const ICONOS: Record<string, string> = {
  clase: '<rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 10h18"></path><path d="m9 15 2 2 4-4"></path>',
  deportistas: '<circle cx="9" cy="8" r="3.5"></circle><path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5"></path><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14.7c1.9.6 3.1 2.4 3.5 5.3"></path>',
  asistencia: '<path d="M9 6h11M9 12h11M9 18h11"></path><path d="m3 6 1.5 1.5L7 5M3 12l1.5 1.5L7 11M3 18l1.5 1.5L7 17"></path>',
  estadisticas: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"></path>',
  mas: '<circle cx="5" cy="12" r="1.3"></circle><circle cx="12" cy="12" r="1.3"></circle><circle cx="19" cy="12" r="1.3"></circle>',
};
---
<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo} · Firehouse CRM</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;800&family=Instrument+Sans:wght@400;500&family=Space+Mono&display=swap" />
</head>
<body class="admin-tema">
  {!ocultarCabecera && (
    <header class="crm-top">
      <div class="crm-top__wrap">
        <a href="/admin" class="crm-top__marca">
          <picture>
            <source srcset="/logo.webp" type="image/webp" />
            <img src="/logo.png" alt="Firehouse Cheerleading All Stars" width="46" height="40" />
          </picture>
          <span class="crm-top__crm">CRM</span>
        </a>
        <nav class="crm-top__nav" aria-label="Secciones">
          {PRINCIPALES.map((e) => (
            <a href={e.href} class={`crm-top__link${activo(e.href) ? ' crm-top__link--activo' : ''}`} aria-current={activo(e.href) ? 'page' : undefined}>{e.texto}</a>
          ))}
        </nav>
        <details class="crm-mas" id="crm-mas">
          <summary class={`crm-mas__boton${SECUNDARIOS.some((e) => activo(e.href)) ? ' crm-top__link--activo' : ''}`}>
            Más
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
          </summary>
          <div class="crm-mas__panel">
            <p class="crm-mas__titulo">Más secciones</p>
            {PRINCIPALES.slice(4).map((e) => (
              <a href={e.href} class={`crm-mas__link crm-mas__link--movil${activo(e.href) ? ' crm-mas__link--activo' : ''}`} aria-current={activo(e.href) ? 'page' : undefined}>{e.texto}</a>
            ))}
            {SECUNDARIOS.map((e) => (
              <a href={e.href} class={`crm-mas__link${activo(e.href) ? ' crm-mas__link--activo' : ''}`} aria-current={activo(e.href) ? 'page' : undefined}>{e.texto}</a>
            ))}
            <div class="crm-mas__sesion">
              <span id="admin-usuario" class="crm-mas__usuario"></span>
              <button type="button" id="admin-logout" class="crm-mas__salir">Cerrar sesión</button>
            </div>
          </div>
        </details>
      </div>
    </header>
  )}
  <main class="admin-main">
    <slot />
  </main>
  {!ocultarCabecera && (
    <nav class="crm-tabs" aria-label="Secciones principales">
      {PRINCIPALES.slice(0, 4).map((e) => (
        <a href={e.href} class={`crm-tabs__item${activo(e.href) ? ' crm-tabs__item--activo' : ''}`} aria-current={activo(e.href) ? 'page' : undefined}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONOS[e.icono]}></svg>
          <span>{e.texto}</span>
        </a>
      ))}
      <button type="button" class={`crm-tabs__item${masActivo ? ' crm-tabs__item--activo' : ''}`} id="crm-tabs-mas" aria-controls="crm-mas" aria-expanded="false">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" set:html={ICONOS.mas}></svg>
        <span>Más</span>
      </button>
    </nav>
  )}
  <script>
    // Menú «Más»: se cierra al tocar fuera o con Escape; en el celular lo abre la pestaña «Más».
    const mas = document.querySelector<HTMLDetailsElement>('#crm-mas');
    const tab = document.querySelector<HTMLButtonElement>('#crm-tabs-mas');
    if (mas) {
      const sincronizar = () => tab?.setAttribute('aria-expanded', String(mas.open));
      mas.addEventListener('toggle', sincronizar);
      tab?.addEventListener('click', (e) => {
        e.stopPropagation();
        mas.open = !mas.open;
      });
      document.addEventListener('click', (e) => {
        if (mas.open && !mas.contains(e.target as Node) && e.target !== tab) mas.open = false;
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && mas.open) {
          mas.open = false;
          (tab && getComputedStyle(tab).display !== 'none' ? tab : mas.querySelector('summary'))?.focus();
        }
      });
    }
  </script>
</body>
</html>

<style is:global>
body.admin-tema{
  background: var(--crm-fondo);
  color: var(--ember);
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 1.5;
  margin: 0;
}
body.admin-tema h1, body.admin-tema h2, body.admin-tema h3{
  font-family: var(--font-display);
  color: var(--ember);
}
body.admin-tema a{ color: var(--fire-red); }
/* Enlaces con forma de botón: conservan el color del botón (antes heredaban el rojo de los enlaces). */
body.admin-tema a.admin-btn{ color: #fff; text-decoration: none; }
body.admin-tema a.admin-btn--whatsapp{ color: #08380F; }
body.admin-tema a.admin-btn--secundario{ color: var(--ember); }
body.admin-tema a.admin-btn--peligro{ color: var(--fire-red); }

.crm-top{ background: var(--crm-carbon); color: var(--crm-tiza); position: sticky; top: 0; z-index: 30; }
.crm-top__wrap{ max-width: 1280px; margin-inline: auto; padding: 0 24px; height: 60px; display: flex; align-items: center; gap: 28px; }
.crm-top__marca{ display: inline-flex; align-items: center; gap: 10px; text-decoration: none; flex-shrink: 0; min-height: 44px; }
.crm-top__marca img{ height: 40px; width: auto; display: block; }
body.admin-tema .crm-top__crm{
  font-family: var(--font-display); font-weight: 800; font-size: 13px; letter-spacing: .14em;
  color: var(--crm-tiza); border-left: 1px solid rgba(245,239,232,.25); padding-left: 10px;
}
.crm-top__nav{ display: flex; align-items: stretch; gap: 4px; height: 100%; flex: 1; min-width: 0; }
body.admin-tema .crm-top__link, body.admin-tema .crm-mas__boton{
  display: inline-flex; align-items: center; gap: 6px; padding: 0 12px; height: 100%;
  font-size: 14px; font-weight: 500; color: var(--crm-tiza-suave); text-decoration: none; white-space: nowrap;
  box-shadow: inset 0 -3px 0 transparent; transition: color var(--t-interfaz, 180ms), box-shadow var(--t-interfaz, 180ms);
}
body.admin-tema .crm-top__link:hover, body.admin-tema .crm-mas__boton:hover{ color: var(--crm-tiza); }
body.admin-tema .crm-top__link--activo{ color: #fff; font-weight: 700; box-shadow: inset 0 -3px 0 var(--crm-naranjo); }
.crm-top__link:focus-visible, .crm-mas__boton:focus-visible, .crm-top__marca:focus-visible{ outline: 2px solid var(--crm-naranjo); outline-offset: -4px; }
.crm-mas{ position: relative; height: 100%; margin-left: auto; }
.crm-mas__boton{ list-style: none; cursor: pointer; }
.crm-mas__boton::-webkit-details-marker{ display: none; }
.crm-mas[open] .crm-mas__boton svg{ transform: rotate(180deg); }
.crm-mas__panel{
  position: absolute; right: 0; top: calc(100% + 6px); width: 260px; box-sizing: border-box;
  background: var(--crm-superficie); color: var(--crm-carbon); border: 1px solid var(--crm-linea); border-radius: 14px;
  box-shadow: 0 16px 40px rgba(23,20,18,.22); padding: 8px; display: flex; flex-direction: column;
}
.crm-mas__titulo{ margin: 4px 10px 6px; font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--crm-texto-2); }
body.admin-tema .crm-mas__link{ display: flex; align-items: center; min-height: 44px; padding: 0 10px; border-radius: 9px; color: var(--crm-carbon); text-decoration: none; font-size: 15px; }
body.admin-tema .crm-mas__link:hover{ background: var(--crm-superficie-2); }
body.admin-tema .crm-mas__link--activo{ font-weight: 700; box-shadow: inset 3px 0 0 var(--crm-naranjo); background: var(--crm-superficie-2); }
.crm-mas__link--movil{ display: none !important; }
.crm-mas__sesion{ display: flex; align-items: center; justify-content: space-between; gap: 8px; border-top: 1px solid var(--crm-linea); margin-top: 6px; padding: 10px 10px 4px; }
.crm-mas__usuario{ font-size: 13px; color: var(--crm-texto-2); min-width: 0; overflow-wrap: anywhere; }
.crm-mas__salir{ flex-shrink: 0; min-height: 44px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--crm-borde); background: var(--crm-superficie); color: var(--crm-carbon); font: inherit; font-size: 13px; cursor: pointer; }
.crm-mas__salir:hover{ border-color: var(--crm-rojo); color: var(--crm-rojo); }
.crm-tabs{ display: none; }

/* Escritorio angosto: se ocultan Casos y Pagos de la barra y pasan a «Más». */
@media (max-width: 1080px){
  .crm-top__nav .crm-top__link:nth-child(n+5){ display: none; }
  .crm-mas__link--movil{ display: flex !important; }
}

/* Celular: barra superior delgada y pestañas fijas abajo. */
@media (max-width: 700px){
  .crm-top{ position: static; }
  .crm-top__wrap{ height: 52px; padding: 0 16px; }
  .crm-top__marca img{ height: 34px; }
  .crm-top__nav, .crm-mas__boton{ display: none !important; }
  .crm-mas{ position: static; height: auto; }
  .crm-mas__panel{
    position: fixed; left: 8px; right: 8px; top: auto; width: auto; z-index: 40;
    bottom: calc(70px + env(safe-area-inset-bottom, 0px));
    max-height: calc(100vh - 140px); overflow-y: auto;
  }
  .crm-tabs{
    display: grid; grid-template-columns: repeat(5, minmax(0, 1fr));
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 35;
    background: var(--crm-superficie); border-top: 1px solid var(--crm-linea);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  body.admin-tema .crm-tabs__item{
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px;
    min-height: 62px; padding: 0 2px; border: 0; background: transparent; font: inherit;
    font-size: 10.5px; font-weight: 600; color: var(--crm-texto-2); text-decoration: none; cursor: pointer; text-align: center;
  }
  body.admin-tema .crm-tabs__item span{ max-width: 100%; line-height: 1.15; letter-spacing: -.01em; hyphens: none; }
  body.admin-tema .crm-tabs__item--activo{ color: var(--crm-rojo); font-weight: 700; box-shadow: inset 0 3px 0 var(--crm-naranjo); }
  body.admin-tema{ padding-bottom: calc(66px + env(safe-area-inset-bottom, 0px)); }
  .admin-main{ padding: 16px 12px 48px; }
}

.admin-main{ max-width: 1280px; margin-inline: auto; padding: 28px 24px 64px; }

.admin-card{
  background: #fff; border: 1px solid var(--crm-linea); border-radius: 14px; padding: 20px;
}

.admin-btn{
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  background: var(--fire-red); color: #fff; border: none; border-radius: 10px;
  padding: 11px 20px; font-size: 14px; font-weight: 500; cursor: pointer;
  text-decoration: none; font-family: var(--font-body); min-height: 42px;
}
.admin-btn:hover{ background: var(--crm-rojo-hover); }
.admin-btn:disabled{ opacity: .6; cursor: not-allowed; }
.admin-btn[hidden]{ display: none; }
.admin-btn--secundario{
  background: #fff; color: var(--ember); border: 1px solid var(--crm-borde);
}
.admin-btn--secundario:hover{ border-color: var(--ember); background: #fff; }
.admin-btn--whatsapp{ background: #25D366; color: #08380F; font-weight: 600; }
.admin-btn--whatsapp:hover{ background: #1FB958; }
.admin-btn--peligro{ background: #fff; color: var(--fire-red); border: 1px solid rgba(191,7,2,.4); }
.admin-btn--peligro:hover{ background: rgba(191,7,2,.06); border-color: var(--fire-red); }

.admin-input, .admin-select, .admin-textarea{
  width: 100%; box-sizing: border-box; background: #fff; color: var(--ember);
  border: 1px solid var(--crm-borde); border-radius: 8px; padding: 10px 12px; font-size: 14px;
  font-family: var(--font-body); min-height: 40px;
}
.admin-textarea{ min-height: 80px; resize: vertical; }
.admin-input:focus-visible, .admin-select:focus-visible, .admin-textarea:focus-visible{
  outline: 2px solid var(--fire-red); outline-offset: 1px;
}
.admin-label{ display: block; font-size: 13px; font-weight: 500; color: var(--crm-texto-2); margin-bottom: 6px; }

.admin-badge{
  display: inline-flex; align-items: center; border-radius: 999px; padding: 3px 10px;
  font-size: 12px; font-weight: 500; white-space: nowrap;
}
.admin-badge--journey{ background: var(--crm-info-fondo); color: var(--crm-info); }
.admin-badge--estado-abierto{ background: var(--crm-pendiente-fondo); color: var(--crm-pendiente); }
.admin-badge--estado-cerrado-ok{ background: var(--crm-ok-fondo); color: var(--crm-ok); }
.admin-badge--estado-cerrado-no{ background: #F1EAE6; color: var(--crm-texto-2); }
.admin-badge--vencido{ background: var(--crm-alerta-fondo); color: var(--crm-alerta); }
.admin-badge--prioridad-alta{ background: var(--crm-alerta-fondo); color: var(--crm-alerta); }

.admin-spinner{ color: var(--crm-texto-2); font-size: 14px; padding: 24px 0; }
.admin-vacio{ color: var(--crm-texto-2); font-size: 14px; padding: 32px 0; text-align: center; }
.admin-intro{ font-size: 14px; color: var(--crm-texto-2); margin: 0 0 20px; max-width: 60ch; }
.admin-error{
  background: var(--crm-alerta-fondo); border: 1px solid #E8A6A6; color: #7A1414;
  border-radius: 10px; padding: 12px 14px; font-size: 14px; margin-bottom: 16px;
}
.admin-aviso-cerrado{
  background: #FBF3D9; border: 1px solid #E8D6A1; color: #6B5B1A;
  border-radius: 10px; padding: 12px 14px; font-size: 14px; margin-bottom: 16px;
}
.admin-aviso-cerrado code{ background: rgba(0,0,0,.06); padding: 1px 5px; border-radius: 4px; }

/* ---------------------------------------------------------------------------
   Estilos de "ficha" compartidos entre /admin/caso y /admin/apoderado — viven
   acá (y no en cada página) para que ambas fichas se vean consistentes.
--------------------------------------------------------------------------- */
.ficha-volver{ display: inline-block; margin-bottom: 16px; font-size: 14px; color: var(--crm-texto-2); text-decoration: none; }
.ficha-volver:hover{ color: var(--fire-red); }

.ficha-duplicado{ margin-bottom: 20px; }

.ficha-grid{ display: grid; grid-template-columns: 1.2fr 1fr; gap: 20px; align-items: start; }
.ficha-col{ display: flex; flex-direction: column; gap: 20px; min-width: 0; }

.ficha-bloque__titulo{ font-size: 1.1rem; margin: 0 0 16px; }
.ficha-bloque__subtitulo{ font-size: 14px; font-weight: 500; margin: 0 0 10px; }

.ficha-datos{ display: grid; grid-template-columns: auto 1fr; gap: 10px 18px; margin: 0; font-size: 14px; }
.ficha-datos dt{ color: var(--crm-texto-2); }
.ficha-datos dd{ margin: 0; font-weight: 500; min-width: 0; overflow-wrap: anywhere; }

.ficha-acciones{ display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
.ficha-whatsapp-nota{ font-size: 12px; color: var(--crm-texto-2); margin-top: 10px; }

.ficha-aviso{
  background: var(--crm-pendiente-fondo); color: var(--crm-pendiente); border-radius: 8px; padding: 10px 12px;
  font-size: 13px; margin-bottom: 16px;
}
.ficha-guardado{ color: var(--crm-ok); font-size: 13px; margin-top: 10px; }
.ficha-ayuda-journey{ font-size: 12px; color: var(--crm-texto-2); margin-top: 6px; }

.ficha-peligro{ margin-top: 20px; border-color: rgba(197,21,21,.25); }
.ficha-peligro__texto{ font-size: 13px; color: var(--crm-texto-2); margin: 0 0 14px; }

.ficha-historial{ margin-top: 20px; }
.ficha-timeline{ list-style: none; margin: 0 0 24px; padding: 0; }
.ficha-timeline li{ padding: 12px 0; border-bottom: 1px solid var(--crm-linea-suave); font-size: 14px; }
.ficha-timeline li:last-child{ border-bottom: none; }
.ficha-timeline__meta{ color: var(--crm-texto-2); font-size: 12px; }
.ficha-timeline__tipo{ font-weight: 500; }

.ficha-nueva-interaccion{ border-top: 1px solid var(--crm-linea-suave); padding-top: 20px; }
.ficha-nueva-interaccion__fila{ max-width: 220px; margin-bottom: 10px; }
.ficha-contador{ font-size: 12px; color: var(--crm-texto-2); text-align: right; margin: 6px 0 12px; }

/* Mini-tabla de atletas, reutilizada en el dashboard y en la ficha de apoderado */
.familia-card__atletas{ width: 100%; border-collapse: collapse; font-size: 14px; }
.familia-card__atletas th{
  text-align: left; padding: 8px 4px; font-size: 11px; text-transform: uppercase;
  letter-spacing: .04em; color: var(--crm-texto-2); border-bottom: 1px solid var(--crm-linea);
}
.familia-card__atletas td{
  padding: 12px 4px; border-top: 1px solid var(--crm-linea-suave); vertical-align: middle; cursor: pointer;
}
.familia-card__atletas tr:first-child td{ border-top: none; }
.familia-card__atletas tr:hover td{ background: var(--crm-superficie-2); }
.familia-card__atletas td:first-child{ font-weight: 500; }
.db-fila__vencido{ color: var(--fire-red); font-weight: 500; }

/* ---------------------------------------------------------------------------
   /admin/esquema — diagnóstico de la base de datos
--------------------------------------------------------------------------- */
.esq-acciones{ display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 20px; }
.esq-resumen{
  display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px;
  margin: 0 0 20px;
}
.esq-resumen > div{ background: #fff; border: 1px solid var(--crm-linea); border-radius: 10px; padding: 12px 14px; }
.esq-resumen dt{ font-size: 12px; color: var(--crm-texto-2); }
.esq-resumen dd{ margin: 4px 0 0; font-family: var(--font-display); font-weight: 800; font-size: 1.25rem; }
.esq-resumen dd.esq-resumen__texto{ font-family: var(--font-body); font-weight: 500; font-size: 14px; }
.esq-bloque{ margin-bottom: 20px; }
.esq-scroll{ overflow-x: auto; }
.esq-tabla{ width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 16px; }
.esq-tabla th{
  text-align: left; padding: 8px 6px; font-size: 12px; font-weight: 500; color: var(--crm-texto-2);
  border-bottom: 1px solid var(--crm-linea); white-space: nowrap;
}
.esq-tabla td{ padding: 8px 6px; border-top: 1px solid var(--crm-linea-suave); vertical-align: top; }
.esq-num{ text-align: right; font-variant-numeric: tabular-nums; }
.esq-detalle{ border-top: 1px solid var(--crm-linea-suave); }
.esq-detalle:first-child{ border-top: none; }
