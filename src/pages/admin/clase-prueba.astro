---
import AdminBase from '../../layouts/AdminBase.astro';
---
<AdminBase titulo="Clase de prueba">
  <div class="cp-header">
    <h1 class="db-titulo">Clase de hoy</h1>
    <button type="button" id="cp-btn-visita-rapida" class="admin-btn admin-btn--secundario cp-btn-visita">+ Visita rápida</button>
  </div>
  <p class="admin-intro cp-intro">
    Marca a quienes llegaron y presiona <strong>Grabar asistencia</strong>. Con <strong>⋯</strong> ves el
    contacto, cambias la fecha, registras la talla y envías mensajes.
  </p>

  <div id="cp-error" class="admin-error" hidden></div>
  <p id="cp-visita-guardada" class="ficha-guardado" hidden></p>

  <section class="admin-card cp-visita-form" id="cp-visita-form-wrap" hidden>
    <h2 class="ficha-bloque__titulo">Visita rápida</h2>
    <p class="admin-intro">
      Para alguien que llegó a probar sin haberse registrado antes. Queda marcado
      como asistió hoy mismo — más adelante le enviamos un link para completar
      el resto del registro.
    </p>
    <form id="cp-form-visita">
      <div class="cp-visita-grid">
        <div class="admin-campo">
          <label class="admin-label" for="vr-apoderado-nombre">Nombre del apoderado</label>
          <input id="vr-apoderado-nombre" class="admin-input" type="text" required />
        </div>
        <div class="admin-campo">
          <label class="admin-label" for="vr-apoderado-apellidos">Apellidos del apoderado</label>
          <input id="vr-apoderado-apellidos" class="admin-input" type="text" />
        </div>
        <div class="admin-campo">
          <label class="admin-label" for="vr-telefono">Teléfono</label>
          <input id="vr-telefono" class="admin-input" type="tel" placeholder="9 1234 5678" required />
        </div>
        <div class="admin-campo">
          <label class="admin-label" for="vr-email">Correo</label>
          <input id="vr-email" class="admin-input" type="email" required />
        </div>
      </div>
      <div class="admin-campo">
        <label class="admin-label" for="vr-nota">Nota</label>
        <textarea id="vr-nota" class="admin-textarea" placeholder='Ej: "Dos niñas de 12 y 10 años"' required></textarea>
      </div>
      <label class="cp-consentimiento">
        <input type="checkbox" id="vr-consentimiento" required />
        Confirmo que el apoderado autorizó verbalmente que Firehouse lo contacte.
      </label>
      <div class="ficha-acciones">
        <button type="submit" class="admin-btn">Registrar visita</button>
        <button type="button" id="cp-btn-cancelar-visita" class="admin-btn admin-btn--secundario">Cancelar</button>
      </div>
    </form>
  </section>

 <div id="cp-programa" class="fh-programa" aria-label="Programa"></div>
  <div class="cp-herramientas">
    <input id="cp-buscar" class="admin-input cp-buscar" type="search" placeholder="Buscar alumna, apoderado o teléfono" aria-label="Buscar" />
    <div id="cp-filtro" class="cp-filtro" role="group" aria-label="Filtrar"></div>
    <select id="cp-orden" class="admin-select cp-orden" aria-label="Ordenar por"></select>
  </div>
  <div id="cp-aviso-asistencia" class="admin-aviso-cerrado" hidden></div>
  <div id="cp-aviso-mensajes" class="admin-aviso-cerrado" hidden></div>

  <section class="admin-card cp-lista-wrap">
    <p id="cp-cargando" class="admin-spinner">Cargando…</p>
    <p id="cp-vacio" class="admin-vacio" hidden>No hay clases de prueba agendadas todavía.</p>
    <div id="cp-grupos"></div>
  </section>

  <div id="cp-barra-asistencia" class="cp-barra" role="status" aria-live="polite" hidden>
    <span id="cp-barra-texto" class="cp-barra__texto"></span>
    <button type="button" id="cp-barra-grabar" class="admin-btn cp-barra__grabar">Grabar asistencia</button>
  </div>

  <dialog id="cp-dialogo-correo" class="cp-dialogo" aria-labelledby="cp-dialogo-titulo">
    <h2 id="cp-dialogo-titulo" class="ficha-bloque__titulo">Revisa el correo antes de enviarlo</h2>
    <p class="cp-dialogo__dato">Para: <strong id="cp-correo-para"></strong></p>
    <p class="cp-dialogo__dato">Asunto: <strong id="cp-correo-asunto"></strong></p>
    <iframe id="cp-correo-previa" class="cp-dialogo__previa" title="Vista previa del correo" sandbox=""></iframe>
    <div class="ficha-acciones">
      <button type="button" id="cp-correo-enviar" class="admin-btn">Enviar correo</button>
      <button type="button" id="cp-correo-cancelar" class="admin-btn admin-btn--secundario">Cancelar</button>
    </div>
  </dialog>

  <dialog id="cp-dialogo-grupo" class="cp-dialogo cp-dialogo--grupo" aria-labelledby="cp-grupo-titulo">
    <h2 id="cp-grupo-titulo" class="ficha-bloque__titulo">Enviar correo al grupo</h2>
    <div class="cp-grupo-cols">
      <div class="cp-grupo-izq">
        <label class="admin-label" for="cp-grupo-plantilla">Mensaje</label>
        <select id="cp-grupo-plantilla" class="admin-select"></select>
        <div class="cp-grupo__barra">
          <span class="admin-label">Familias</span>
          <span>
            <button type="button" id="cp-grupo-todos" class="cp-link-fecha">Todas</button>
            <button type="button" id="cp-grupo-ninguno" class="cp-link-fecha">Ninguna</button>
          </span>
        </div>
        <ul id="cp-grupo-lista" class="cp-grupo__lista"></ul>
        <label class="cp-grupo__copia">
          <input type="checkbox" id="cp-grupo-copia" checked />
          <span>Enviar una copia con el resumen a quienes hoy reciben las copias de los correos del panel (en vez de una copia por cada familia)</span>
        </label>
      </div>
      <div class="cp-grupo-der">
        <p class="cp-dialogo__dato">Vista previa: <strong id="cp-grupo-previa-para"></strong></p>
        <p class="cp-dialogo__dato">Asunto: <strong id="cp-grupo-previa-asunto"></strong></p>
        <iframe id="cp-grupo-previa" class="cp-dialogo__previa" title="Vista previa del correo" sandbox=""></iframe>
        <p id="cp-grupo-previa-link" class="cp-fecha__nota" hidden>El link de pago de cada familia se crea al enviar (y prepara sus cargos Star).</p>
      </div>
    </div>
    <div id="cp-grupo-progreso" class="cp-grupo__progreso" hidden>
      <progress id="cp-grupo-barra" value="0" max="1"></progress>
      <span id="cp-grupo-progreso-texto"></span>
    </div>
    <div class="ficha-acciones">
      <button type="button" id="cp-grupo-enviar" class="admin-btn">Enviar</button>
      <button type="button" id="cp-grupo-cerrar" class="admin-btn admin-btn--secundario">Cerrar</button>
    </div>
  </dialog>
</AdminBase>

<script>
  import { iniciarClasePrueba } from '../../scripts/admin-clase-prueba.ts';
  iniciarClasePrueba();
</script>

<style is:global>
.cp-header{ display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
.cp-lista-wrap{ padding: 20px; }

.cp-visita-form{ margin: 16px 0 20px; }
.cp-visita-grid{ display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
.cp-consentimiento{
  display: flex; align-items: flex-start; gap: 10px; font-size: 13px; color: var(--crm-texto-2);
  margin: 16px 0; cursor: pointer;
}
.cp-consentimiento input{ margin-top: 3px; width: 18px; height: 18px; accent-color: var(--fire-red); flex-shrink: 0; }

.cp-grupo{ margin-bottom: 28px; }
.cp-grupo:last-child{ margin-bottom: 0; }
.cp-grupo__titulo{
  font-family: var(--font-display); font-weight: 800; font-size: 1.2rem;
  margin: 0; color: var(--ember);
}
.cp-grupo__sub{ margin: 2px 0 0; font-size: 13px; color: var(--crm-texto-2); }
.cp-grupo__conteo{ display: flex; align-items: center; gap: 10px; flex: 1 1 220px; max-width: 360px; }
.cp-grupo__barra{ flex: 1; height: 8px; border-radius: 999px; background: var(--crm-linea-suave); overflow: hidden; }
.cp-grupo__barra-relleno{ display: block; height: 100%; width: 0; border-radius: 999px; background: var(--crm-ok); transition: width var(--t-interfaz, 180ms); }
.cp-grupo__conteo-texto{ font-size: 14px; font-weight: 700; white-space: nowrap; font-variant-numeric: tabular-nums; }
.cp-grupo__accion{
  background: none; border: 0; padding: 6px 2px; min-height: 36px; font: inherit; font-size: 13px; font-weight: 600;
  color: var(--crm-texto); text-decoration: underline; text-underline-offset: 3px; cursor: pointer;
}
.cp-grupo__accion:hover{ color: var(--crm-rojo); }

.cp-lista{ border: 1px solid var(--crm-linea); border-radius: 12px; overflow: hidden; background: #fff; }
.cp-fila{ border-top: 1px solid var(--crm-linea-suave); }
.cp-fila:first-child{ border-top: 0; }
.cp-fila--presente{ background: #F1F8F2; }
.cp-fila__principal{ display: flex; align-items: center; min-height: 60px; }
.cp-fila__marca{ flex: 1; min-width: 0; display: flex; align-items: center; gap: 14px; padding: 8px 4px 8px 14px; cursor: pointer; }
.cp-check{ flex-shrink: 0; width: 26px; height: 26px; margin: 0; accent-color: var(--crm-ok); cursor: pointer; }
.cp-check:disabled{ cursor: not-allowed; }
.cp-fila__textos{ display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.cp-fila__nombre{ color: var(--ember, #171412); font-weight: 600; font-size: 16px; line-height: 1.3; overflow-wrap: anywhere; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.cp-fila__detalle{ font-size: 13px; line-height: 1.4; color: var(--crm-texto-2); }
.cp-kit{ white-space: nowrap; }
.cp-tipo{ font-weight: 700; }
.cp-tipo--star{ color: var(--crm-star-texto); }
.cp-tipo--prueba{ color: var(--crm-prueba); }
.cp-kit{ color: var(--crm-pendiente); font-weight: 600; }
.cp-fila__mas{
  flex-shrink: 0; width: 48px; height: 48px; margin-right: 4px; border: 0; border-radius: 10px;
  background: transparent; color: var(--crm-texto-2); display: flex; align-items: center; justify-content: center; cursor: pointer;
}
.cp-fila__mas:hover, .cp-fila--abierta .cp-fila__mas{ background: var(--crm-fondo); color: var(--ember, #171412); }
.cp-fila__panel{ padding: 4px 16px 16px 54px; display: flex; flex-direction: column; gap: 10px; }
.cp-fila__panel[hidden]{ display: none; }
.cp-fila__contacto{ margin: 0; font-size: 14px; color: var(--crm-texto); }
.cp-fila__contacto a{ color: var(--crm-rojo); }
.cp-fila__nota{ font-size: 13px; color: var(--ember); margin: 0; font-style: italic; }

.cp-barra{
  position: fixed; left: 50%; bottom: 16px; transform: translateX(-50%); z-index: 20;
  width: min(560px, calc(100vw - 24px)); box-sizing: border-box;
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  padding: 10px 10px 10px 18px; border-radius: 14px; background: var(--ember, #171412); color: #fff;
  box-shadow: 0 10px 30px rgba(23,20,18,.3);
}
.cp-barra[hidden]{ display: none; }
.cp-barra__texto{ flex: 1; min-width: 0; font-size: 14px; font-weight: 600; line-height: 1.3; }
.cp-barra__grabar{ flex-shrink: 0; min-height: 48px; padding: 0 18px; font-size: 15px; font-weight: 700; white-space: nowrap; }
.cp-barra__grabar[hidden]{ display: none; }
.cp-barra--ok{ background: var(--crm-ok); }
.cp-barra--error{ background: #7A1414; }
body.cp-con-barra .cp-lista-wrap{ margin-bottom: 96px; }
.cp-mensajes{ border-top: 1px solid var(--crm-linea-suave); padding-top: 12px; }
.cp-mensajes__campos{ display: flex; flex-wrap: wrap; align-items: flex-end; gap: 12px; }
.cp-mensajes__campos .admin-label{ font-size: 12px; margin-bottom: 4px; }
.cp-select-talla{ min-width: 130px; }
.cp-mensajes__plantilla{ flex: 1 1 220px; }
.cp-mensajes__plantilla .admin-select{ width: 100%; }
.cp-mensajes__aviso{ margin: 10px 0 0; font-size: 13px; color: var(--crm-rojo); }
.cp-mensajes__aviso--ok{ color: var(--crm-ok); font-weight: 600; }
.cp-mensajes__botones{ display: flex; flex-wrap: wrap; gap: 8px; }
.cp-enviados{ display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
.cp-enviados:empty{ display: none; }
.cp-enviado{ font-size: 12px; padding: 3px 10px; border-radius: 999px; background: var(--crm-ok); color: #fff; }
.cp-enviado--correo{ background: var(--crm-info); }

.cp-dialogo{
  width: min(640px, calc(100vw - 24px)); max-height: calc(100vh - 32px); padding: 20px;
  border: none; border-radius: 16px; box-shadow: 0 20px 60px rgba(0,0,0,.35);
}
.cp-dialogo::backdrop{ background: rgba(23,20,18,.6); }
.cp-dialogo--grupo{ width: min(1080px, calc(100vw - 24px)); }
.cp-grupo-cols{ display: grid; gap: 20px; grid-template-columns: minmax(280px, 1fr) minmax(300px, 1.2fr); align-items: start; margin-top: 8px; }
@media (max-width: 760px){ .cp-grupo-cols{ grid-template-columns: 1fr; } }
.cp-grupo-izq .admin-select{ width: 100%; }
.cp-grupo__barra{ display: flex; justify-content: space-between; align-items: center; margin: 14px 0 4px; }
.cp-grupo__barra .admin-label{ margin: 0; }
.cp-grupo__lista{ list-style: none; margin: 0; padding: 0; max-height: 46vh; overflow-y: auto; border: 1px solid var(--crm-linea); border-radius: 10px; }
.cp-grupo__item{ display: flex; justify-content: space-between; gap: 8px; padding: 8px 10px; border-top: 1px solid var(--crm-linea-suave); font-size: 13px; }
.cp-grupo__item:first-child{ border-top: 0; }
.cp-grupo__item--previa{ background: #FFF8E1; }
.cp-grupo__item--no{ color: #8C847B; }
.cp-grupo__check{ display: flex; gap: 8px; align-items: flex-start; cursor: pointer; min-width: 0; }
.cp-grupo__check input{ margin-top: 3px; width: 16px; height: 16px; accent-color: var(--fire-red); flex-shrink: 0; }
.cp-grupo__check small{ color: var(--crm-texto-2); overflow-wrap: anywhere; }
.cp-grupo__nota{ display: block; color: var(--crm-pendiente) !important; }
.cp-grupo__lado{ display: flex; flex-direction: column; align-items: flex-end; gap: 2px; flex-shrink: 0; }
.cp-grupo__ok{ color: var(--crm-ok); font-weight: 700; font-size: 12px; white-space: nowrap; }
.cp-grupo__error{ color: var(--crm-rojo); font-weight: 700; font-size: 12px; max-width: 160px; text-align: right; }
.cp-grupo__copia{ display: flex; gap: 8px; align-items: flex-start; margin: 12px 0 0; font-size: 13px; color: var(--crm-texto); cursor: pointer; }
.cp-grupo__copia input{ margin-top: 2px; width: 16px; height: 16px; accent-color: var(--fire-red); flex-shrink: 0; }
.cp-grupo__progreso{ display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 14px 0 0; font-size: 13px; }
.cp-grupo__progreso[hidden], .cp-fecha[hidden]{ display: none; }
.cp-grupo__progreso progress{ width: 220px; accent-color: var(--fire-red); }
.cp-grupo__cabecera{ display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 12px; margin-bottom: 12px; }
.cp-grupo__cabecera .cp-grupo__titulo{ margin: 0; }
.cp-grupo__correo{ padding: 8px 14px; font-size: 13px; }
.cp-grupo__botones{ display: flex; flex-wrap: wrap; gap: 8px; }
.cp-herramientas{ display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px; margin: 0 0 16px; }
.cp-buscar{ flex: 1 1 220px; max-width: 320px; }
.cp-orden{ width: auto; max-width: 260px; }
.cp-filtro{ display: flex; flex-wrap: wrap; gap: 6px; }
.cp-chip{ border: 1px solid var(--crm-linea); background: #fff; border-radius: 999px; padding: 6px 12px; font: inherit; font-size: 13px; cursor: pointer; color: var(--crm-texto); }
.cp-chip[aria-pressed="true"]{ background: var(--ember, #171412); border-color: var(--ember, #171412); color: #fff; }
.cp-link-fecha{ background: none; border: 0; padding: 0 2px; font: inherit; font-size: 13px; color: var(--crm-rojo); text-decoration: underline; cursor: pointer; }
.cp-fecha{ border-top: 1px solid var(--crm-linea-suave); padding-top: 10px; }
.cp-fecha__campos{ display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.cp-fecha__campos .admin-btn{ padding: 8px 14px; font-size: 13px; }
.cp-fecha__nota{ font-size: 12px; color: var(--crm-texto-2); margin: 6px 0 0; }
.cp-dialogo__dato{ margin: 0 0 6px; font-size: 14px; color: var(--crm-texto-2); overflow-wrap: anywhere; }
.cp-dialogo__dato strong{ color: var(--ember, #171412); }
.cp-dialogo__previa{
  display: block; width: 100%; height: min(60vh, 560px); margin: 12px 0 16px;
  border: 1px solid var(--crm-linea); border-radius: 12px; background: #171412;
}
@media (max-width: 600px){
  .cp-fila__panel{ padding-left: 14px; }
  /* Que la lista aparezca antes: la explicación se omite y los filtros van en una fila deslizable. */
  .cp-intro{ display: none; }
  .cp-herramientas{ gap: 8px; margin-bottom: 12px; }
  .cp-header{ flex-wrap: nowrap; }
  .cp-btn-visita{ flex-shrink: 0; padding: 0 14px; }
  .cp-buscar{ flex: 1 1 55%; max-width: none; min-width: 0; }
  .cp-filtro{ flex-wrap: nowrap; overflow-x: auto; width: 100%; padding-bottom: 2px; scrollbar-width: none; }
  .cp-filtro::-webkit-scrollbar{ display: none; }
  .cp-chip{ flex-shrink: 0; min-height: 44px; white-space: nowrap; }
  .cp-orden{ flex: 1 1 40%; max-width: none; min-width: 0; order: 1; }
  .cp-filtro{ order: 2; }
  .cp-grupo__accion{ min-height: 44px; padding: 0 6px; }
  .cp-grupo__botones{ gap: 4px 14px; }
  .cp-lista-wrap{ padding: 12px; }
  .cp-intro{ font-size: 14px; }
}

@media (max-width: 700px){
  /* La barra de grabar queda sobre las pestañas del celular. */
  .cp-barra{ bottom: calc(74px + env(safe-area-inset-bottom, 0px)); }
}
</style>

