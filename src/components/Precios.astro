---
import Etiqueta from './Etiqueta.astro';
import { whatsapp } from '../data/sitio.js';
const alEntrar = [
  { nombre:'Matrícula',   valor:'$10.000', incluye:'Se paga una sola vez, al inscribirse', cuando:'Al entrar' },
  { nombre:'Mensualidad', valor:'$30.000', incluye:'De marzo a diciembre',                 cuando:'Cada mes' },
];
const enLaTemporada = [
  { nombre:'Tenida de entrenamiento', valor:'$30.000', incluye:'Polera, colet y cinta de competencia', cuando:'Al inicio' },
  { nombre:'Traje de competencia',    valor:'$100.000',incluye:'Sirve dos temporadas si la talla acompaña',                cuando:'Mitad de año' },
  { nombre:'Pack de competencias',    valor:'$150.000',incluye:'2 showcase y 3 torneos, uno regional', cuando:'Antes de octubre' },
];
---
<section class="section precios" id="precios">
  <div class="wrap">
    <div class="reveal">
      <Etiqueta texto="Los costos" />
      <h2 class="section__title">Todo lo que se paga en una temporada</h2>
      <p class="section__intro">
        Este es el esquema completo de costos de una temporada. Lo mostramos entero desde el
        principio para que no aparezcan sorpresas después.
      </p>
    </div>

    <div class="grupo reveal">
      <h3 class="grupo__titulo">Para empezar</h3>
      <ul class="tabla">
        {alEntrar.map(i => (
          <li class="fila">
            <div class="fila__nombre">
              <p class="fila__titulo">{i.nombre}</p>
              <p class="fila__incluye">{i.incluye}</p>
            </div>
            <p class="fila__valor">{i.valor}</p>
            <p class="fila__cuando">{i.cuando}</p>
          </li>
        ))}
      </ul>
      <p class="grupo__nota">Esto es todo lo que se necesita para entrar y empezar a entrenar.</p>
    </div>

    <div class="grupo reveal">
      <h3 class="grupo__titulo">Durante la temporada</h3>
      <ul class="tabla">
        {enLaTemporada.map(i => (
          <li class="fila">
            <div class="fila__nombre">
              <p class="fila__titulo">{i.nombre}</p>
              <p class="fila__incluye">{i.incluye}</p>
            </div>
            <p class="fila__valor">{i.valor}</p>
            <p class="fila__cuando">{i.cuando}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="escalonado reveal">
      <h3>No se paga todo junto</h3>
      <p>
        Cada ítem aparece en el momento del año en que se necesita, y quien entra a mitad
        de temporada asume solo los que quedan por delante. El calendario de pagos lo
        conversamos caso a caso.
      </p>
    </div>

    <p class="precios__aviso reveal">
        La matrícula y la mensualidad son los valores vigentes de la temporada. La tenida, el traje
        y el pack de competencias son referenciales y pueden variar según el proveedor y el
        campeonato, aunque la variación suele ser pequeña.
    </p>

    <div class="precios__ventajas">
      <div class="ventaja reveal">
        <h3>El segundo año cuesta menos</h3>
        <p>Si la talla sigue funcionando, el traje puede usarse también la temporada siguiente: quien continúa se ahorra $100.000.</p>
      </div>
      <div class="ventaja reveal">
        <h3>De a dos cuesta menos</h3>
        <p>Si inscribes a dos —hermanos, primos o amigos— tenemos un valor especial.</p>
        <a class="enlace" id="wa-home-dosalumnos" href={whatsapp('dosAlumnos')} target="_blank" rel="noopener">Consultar el valor para dos</a>
      </div>
    </div>

    <div class="precios__cierre reveal">
      <p class="precios__frase">Antes de pagar nada, ven a conocernos.</p>
      <p class="precios__sub">La primera clase es gratis y no compromete a nada.</p>
      <a class="btn-sec" id="wa-home-precios" href={whatsapp('precios')} target="_blank" rel="noopener">Ven a una clase de prueba gratis</a>
    </div>
  </div>
</section>

<style>
.grupo{ margin-top:var(--e-6); }
.grupo__titulo{
  font-family:var(--font-body); font-weight:500;
  font-size:14px; letter-spacing:.14em; text-transform:uppercase;
  color:var(--fire-yellow);
}
.grupo__nota{ margin-top:var(--e-2); color:var(--txt-faint); font-size:15px; }

.escalonado{
  margin-top:var(--e-6); padding:var(--e-5);
  background:var(--ember-deep);
  border-left:var(--regla) solid var(--fire-red);
}
.escalonado h3{ font-size:clamp(1.3rem, 2.2vw, 1.7rem); color:var(--fire-yellow); }
.escalonado p{ color:var(--txt-soft); max-width:var(--wrap-texto); margin-top:var(--e-2); line-height:1.6; }

.tabla{ list-style:none; margin:var(--e-3) 0 0; padding:0; }
.fila{
  display:grid; grid-template-columns:1fr auto 180px;
  gap:var(--e-4); align-items:center;
  padding:var(--e-3) 0;
  border-bottom:0.5px solid var(--hairline);
}
.fila:first-child{ border-top:0.5px solid var(--hairline); }
.fila__titulo{ font-family:var(--font-display); font-weight:800; font-size:clamp(1.1rem, 1.8vw, 1.35rem); }
.fila__incluye{ color:var(--txt-faint); font-size:14.5px; margin-top:2px; }
.fila__valor{
  font-family:var(--font-count); font-weight:700;
  font-size:clamp(1.2rem, 2.2vw, 1.6rem); color:var(--fire-yellow);
  font-variant-numeric:tabular-nums; white-space:nowrap;
}
.fila__cuando{
  font-family:var(--font-body); font-size:13px; letter-spacing:.12em;
  text-transform:uppercase; color:var(--txt-faint); text-align:right;
}

.precios__aviso{
  margin-top:var(--e-4); color:var(--txt-soft);
  max-width:var(--wrap-texto); line-height:1.6; font-size:16px;
}

.precios__ventajas{ display:grid; grid-template-columns:1fr 1fr; gap:var(--e-3); margin-top:var(--e-6); }
.ventaja{ background:var(--ember-deep); padding:var(--e-4); border-left:var(--regla) solid var(--mat-blue); }
.ventaja h3{ font-size:clamp(1.15rem, 1.9vw, 1.4rem); color:var(--fire-yellow); }
.ventaja p{ color:var(--txt-soft); margin-top:var(--e-1); line-height:1.55; }
.enlace{ display:inline-block; margin-top:var(--e-2); color:var(--chalk); font-size:15px; }

.precios__cierre{ margin-top:var(--e-7); text-align:center; }
.precios__frase{
  font-family:var(--font-display); font-weight:800;
  font-size:clamp(1.6rem, 3.2vw, 2.4rem); line-height:1.05;
}
.precios__sub{ color:var(--txt-soft); margin-top:var(--e-1); }
.precios__cierre .btn-sec{ margin-top:var(--e-3); }
.precios__ver{ margin-top:var(--e-3); }

@media (max-width:820px){
  .fila{ grid-template-columns:1fr auto; gap:var(--e-2); }
  .fila__cuando{ grid-column:1 / -1; text-align:left; }
  .precios__ventajas{ grid-template-columns:1fr; }
}
</style>
