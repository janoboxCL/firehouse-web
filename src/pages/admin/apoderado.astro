---
import AdminBase from '../../layouts/AdminBase.astro';
import { LIMITES } from '../../lib/crm/constants.ts';
---
<AdminBase titulo="Ficha de apoderado">
  <a href="/admin" class="ficha-volver">← Volver al listado</a>

  <div id="ap-error" class="admin-error" hidden></div>
  <p id="ap-cargando" class="admin-spinner">Cargando…</p>

  <div id="ap-contenido" hidden>
    <div id="ap-duplicado" class="admin-error ficha-duplicado" hidden>
      Posible registro duplicado: ya existe otro contacto con el mismo teléfono o correo.
      Puedes fusionarlos desde <a href="/admin/apoderados">Contactos</a>.
    </div>

    <div class="ficha-grid">
      <div class="ficha-col">
        <section class="admin-card ficha-bloque">
          <h2 class="ficha-bloque__titulo">Apoderado</h2>
          <dl class="ficha-datos" id="ap-datos"></dl>
          <div class="ficha-acciones">
            <a id="ap-btn-whatsapp" class="admin-btn admin-btn--whatsapp" href="#" target="_blank" rel="noopener">💬 WhatsApp</a>
            <a id="ap-btn-email" class="admin-btn admin-btn--secundario" href="#">Email</a>
            <button type="button" id="ap-btn-copiar" class="admin-btn admin-btn--secundario">Copiar teléfono</button>
          </div>

          <div class="ap-plantilla">
            <p class="ap-plantilla__titulo">✉️ Enviar un mensaje</p>
            <label class="admin-label" for="ap-select-plantilla">Elegir plantilla</label>
            <select id="ap-select-plantilla" class="admin-select">
              <option value="">Elegir plantilla…</option>
            </select>
            <div class="ap-plantilla__acciones">
              <button type="button" id="ap-btn-plantilla-whatsapp" class="admin-btn admin-btn--whatsapp" disabled>💬 Abrir WhatsApp</button>
              <button type="button" id="ap-btn-plantilla-email" class="admin-btn admin-btn--secundario" disabled>✉️ Enviar por correo</button>
            </div>
            <p id="ap-plantilla-estado" class="ficha-guardado" hidden></p>
          </div>
        </section>

        <section class="admin-card ficha-bloque">
          <h2 class="ficha-bloque__titulo">Notas de la familia</h2>
          <p class="admin-intro">
            Bitácora aparte del historial de cada atleta — para anotar algo que aplica
            a toda la familia (ej. "ambas niñas vinieron hoy").
          </p>
          <ol id="ap-notas" class="ficha-timeline"></ol>
          <form id="ap-form-nota">
            <textarea id="ap-nota-texto" class="admin-textarea" maxlength={LIMITES.NOTA_INTERACCION_MAX} placeholder="Nota sobre la familia…" required></textarea>
            <button type="submit" class="admin-btn admin-btn--secundario">Agregar nota</button>
          </form>
        </section>
      </div>

      <div class="ficha-col">
        <section class="admin-card ficha-bloque">
          <h2 class="ficha-bloque__titulo">Atletas</h2>
          <table class="familia-card__atletas" id="ap-atletas-tabla">
            <thead>
              <tr>
                <th>Atleta</th>
                <th>Journey</th>
                <th>Estado</th>
                <th>Próxima acción</th>
                <th>Fecha</th>
                <th>Responsable</th>
              </tr>
            </thead>
            <tbody id="ap-atletas-body"></tbody>
          </table>
        </section>

        <section class="admin-card ficha-bloque" id="cu-seccion">
          <div class="cu-cabecera">
            <h2 class="ficha-bloque__titulo">Cuenta y pagos</h2>
            <div class="cu-link" id="cu-link"></div>
          </div>
          <div id="cu-error" class="admin-error" hidden></div>
          <p id="cu-ok" class="ficha-guardado" hidden></p>
          <div id="cu-preparar" class="cu-preparar"></div>
          <div class="cu-scroll">
            <table class="cu-tabla">
              <thead><tr><th></th><th>Deportista</th><th>Concepto</th><th class="cu-num">Monto</th><th class="cu-num">Saldo</th><th>Vence</th><th>Estado</th><th></th></tr></thead>
              <tbody id="cu-cargos"></tbody>
            </table>
          </div>
          <p id="cu-sin-cargos" class="admin-vacio" hidden>Esta familia aún no tiene cargos.</p>
          <form id="cu-form-manual" class="cu-manual" novalidate>
            <p class="cu-manual__titulo">Registrar pago en efectivo o transferencia</p>
            <div class="cu-manual__campos">
              <select id="cu-medio" class="admin-select" aria-label="Medio de pago">
                <option value="EFECTIVO">Efectivo</option>
                <option value="TRANSFERENCIA">Transferencia</option>
              </select>
              <input id="cu-referencia" class="admin-input" maxlength="200" placeholder="Referencia (opcional)" aria-label="Referencia" />
              <button type="submit" id="cu-registrar" class="admin-btn" disabled>Selecciona cargos</button>
            </div>
          </form>
          <h3 class="ficha-bloque__subtitulo">Pagos</h3>
          <ul id="cu-pagos" class="cu-pagos"></ul>
        </section>

        <section class="admin-card ficha-bloque ficha-peligro">
          <h2 class="ficha-bloque__titulo">Eliminar</h2>
          <p class="ficha-peligro__texto">
            Elimina todo el registro de este apoderado, incluyendo sus atletas, casos
            e historial. No se puede deshacer.
          </p>
          <button type="button" id="ap-btn-eliminar" class="admin-btn admin-btn--peligro">
            Eliminar todo el registro
          </button>
        </section>
      </div>
    </div>
  </div>
</AdminBase>

<script>
  import { iniciarFichaApoderado } from '../../scripts/admin-apoderado-ficha.ts';
  iniciarFichaApoderado();
</script>

<style is:global>
.ap-plantilla{
  margin-top: 20px; padding: 16px; border-radius: 12px;
  background: #FAF8F4; border: 1px solid #EFEBE4;
}
.ap-plantilla__titulo{ font-weight: 600; margin: 0 0 12px; font-size: 14px; }
.ap-plantilla__acciones{ display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
#ap-form-nota{ border-top: 1px solid #EFEBE4; padding-top: 16px; margin-top: 4px; }
#ap-form-nota textarea{ margin-bottom: 10px; }
.familia-card__atletas tr{ cursor: pointer; }

.cu-cabecera{ display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; }
.cu-link{ display: flex; flex-wrap: wrap; gap: 8px; }
.cu-link .admin-btn, .cu-preparar .admin-btn{ min-height: 36px; padding: 8px 14px; font-size: 13px; }
.cu-preparar{ display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0; }
.cu-preparar:empty{ display: none; }
.cu-scroll{ overflow-x: auto; }
.cu-tabla{ width: 100%; border-collapse: collapse; font-size: 13px; margin-top: 8px; }
.cu-tabla th{ text-align: left; font-weight: 500; color: #6B6259; font-size: 12px; padding: 8px 6px; border-bottom: 1px solid #E4DFD6; white-space: nowrap; }
.cu-tabla td{ padding: 9px 6px; border-top: 1px solid #EFEBE4; vertical-align: middle; }
.cu-tabla input[type=checkbox]{ width: 18px; height: 18px; accent-color: var(--fire-red); }
.cu-num{ text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
.cu-vencido{ color: #C51515; font-weight: 600; }
.cu-estado{ display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 11px; font-weight: 700; color: #fff; }
.cu-estado--pagado{ background: #1E7A3C; }
.cu-estado--pendiente{ background: #B07800; }
.cu-estado--parcial{ background: #1B4FA8; }
.cu-estado--anulado{ background: #8A7F7B; }
.cu-anular{ background: none; border: 0; color: #C51515; font: inherit; font-size: 12px; text-decoration: underline; cursor: pointer; }
.cu-manual{ margin: 16px 0; padding-top: 14px; border-top: 1px solid #EFEBE4; }
.cu-manual__titulo{ font-size: 14px; font-weight: 600; margin: 0 0 8px; }
.cu-manual__campos{ display: flex; flex-wrap: wrap; gap: 10px; }
.cu-manual__campos .admin-input{ flex: 1 1 200px; }
.cu-pagos{ list-style: none; padding: 0; margin: 0; }
.cu-pagos li{ border-top: 1px solid #EFEBE4; padding: 10px 0; font-size: 13px; }
.cu-pagos li:first-child{ border-top: 0; }
</style>
