---
import Base from '../layouts/Base.astro';
import Etiqueta from '../components/Etiqueta.astro';
import { whatsapp } from '../data/sitio.js';

const titulo = 'Campaña Firehouse 2026 | Sobres digitales Blaze y Nova';
const descripcion =
  'Apoya a Firehouse eligiendo tu sobre digital Blaze, Nova o la colección completa. Recibe tu colección y participa en la promoción 2026.';

// ⚠️ Los premios 2, 3 y 4 de esta página son de ejemplo mientras se cierra la
// consulta a Flow y se redactan las bases de la promoción. Igual que se hizo
// con /sorteo, la dejamos fuera de buscadores (noindex) hasta tener todo
// definitivo — saca noindex recién cuando premios y bases estén cerrados.
const noindex = true;

const productos = [
  {
    id: 'blaze',
    nombre: 'Sobre Blaze',
    precioTexto: '$3.000',
    img: 'campana2026-blaze',
    alt: 'Sobres digitales Firehouse 2026 de Blaze',
    contenido: ['4 láminas coleccionables de Blaze', '2 stickers digitales PNG', 'Wallpaper vertical 9:16', 'Lámina imprimible A4', 'Portada digital del sobre'],
    cta: '❤️‍🔥 Quiero apoyar con Blaze',
  },
  {
    id: 'nova',
    nombre: 'Sobre Nova',
    precioTexto: '$3.000',
    img: 'campana2026-nova',
    alt: 'Sobres digitales Firehouse 2026 de Nova',
    contenido: ['4 láminas coleccionables de Nova', '2 stickers digitales PNG', 'Wallpaper vertical 9:16', 'Lámina imprimible A4', 'Portada digital del sobre'],
    cta: '❤️‍🔥 Quiero apoyar con Nova',
  },
  {
    id: 'blaze-nova',
    nombre: 'Pack Blaze + Nova',
    precioTexto: '$5.000',
    img: 'campana2026-pack',
    alt: 'Pack digital Firehouse 2026 de Blaze y Nova',
    contenido: ['Todo el Sobre Blaze', 'Todo el Sobre Nova', '+ contenido exclusivo Blaze + Nova'],
    cta: '❤️‍🔥 Quiero apoyar con ambos',
    destacado: true,
  },
];

const pasos = [
  { n: 1, titulo: 'Elige tu sobre', desc: 'Blaze, Nova o la colección completa.' },
  { n: 2, titulo: 'Recibe tu colección', desc: 'Descarga tus láminas, stickers y contenido digital Firehouse.' },
  { n: 3, titulo: 'Además, participa', desc: 'Recibes automáticamente tu código de participación promocional y podrás seguir el sorteo en vivo.' },
];

// Detalle completo por producto para "¿Qué recibes en tu sobre?". Separado
// del arreglo `productos` de arriba a propósito: ahí las tarjetas de
// selección se mantienen cortas y escaneables; acá va el desglose completo.
const detalle = [
  {
    id: 'blaze',
    nombre: 'Sobre Digital Blaze',
    precioTexto: '$3.000',
    img: 'campana2026-preview-blaze',
    alt: 'Muestra de láminas digitales coleccionables de Blaze',
    grupos: [
      { titulo: '4 láminas coleccionables de Blaze', items: ['Blaze clásico', 'Blaze celebrando', 'Blaze "Team Firehouse"', 'Blaze edición especial 2026'] },
      { titulo: '2 stickers digitales PNG de Blaze', items: ['Fondo transparente', 'Pensados para WhatsApp / Stories'] },
      { titulo: '1 wallpaper para celular', items: ['Formato vertical 9:16'] },
      { titulo: '1 lámina imprimible', items: ['Formato A4 / PDF'] },
      { titulo: '1 portada digital del sobre', items: ['Imagen del pack Blaze para guardar como parte de la colección'] },
    ],
  },
  {
    id: 'nova',
    nombre: 'Sobre Digital Nova',
    precioTexto: '$3.000',
    img: 'campana2026-preview-nova',
    alt: 'Muestra de láminas digitales coleccionables de Nova',
    grupos: [
      { titulo: '4 láminas coleccionables de Nova', items: ['Nova clásica', 'Nova celebrando', 'Nova "Team Firehouse"', 'Nova edición especial 2026'] },
      { titulo: '2 stickers digitales PNG de Nova', items: ['Fondo transparente', 'Pensados para WhatsApp / Stories'] },
      { titulo: '1 wallpaper para celular', items: ['Formato vertical 9:16'] },
      { titulo: '1 lámina imprimible', items: ['Formato A4 / PDF'] },
      { titulo: '1 portada digital del sobre', items: ['Imagen del pack Nova para guardar como parte de la colección'] },
    ],
  },
  {
    id: 'blaze-nova',
    nombre: 'Pack Blaze + Nova',
    precioTexto: '$5.000',
    img: 'campana2026-pack',
    alt: 'Pack digital Firehouse 2026 de Blaze y Nova',
    grupos: [
      { titulo: 'Todo el Sobre Blaze', items: ['4 láminas + 2 stickers + wallpaper + imprimible'] },
      { titulo: 'Todo el Sobre Nova', items: ['4 láminas + 2 stickers + wallpaper + imprimible'] },
      { titulo: '+ Contenido exclusivo Blaze + Nova', items: ['2 láminas dúo Blaze + Nova', '1 wallpaper conjunto', '1 lámina especial "Firehouse 2026"', '2 stickers dúo', '1 portada exclusiva Blaze + Nova'] },
    ],
  },
];
---
<Base
  titulo={titulo}
  descripcion={descripcion}
  ruta="/campana-2026"
  noindex={noindex}
  minimal={true}
  ogImagen="/media/campana2026-og.jpg"
  etiquetaMinima="Campaña 2026"
  mensajeWhatsappMinima="campana2026"
>
  <div class="camp2026">

    <!-- HERO -->
    <section class="camp-hero">
      <div class="wrap camp-hero__fila">
        <div class="camp-hero__texto">
          <h1 class="camp-hero__titulo">Campaña Firehouse 2026</h1>
          <p class="camp-hero__tagline">Ayúdanos a llegar más lejos esta temporada 🔥</p>
          <p class="camp-hero__bajada">
            Apoya a nuestras niñas y niños eligiendo uno de nuestros sobres digitales de
            Blaze y Nova. Recibe tu colección Firehouse y además participa por increíbles
            premios.
          </p>
          <div class="camp-hero__precios">
            <span class="camp-hero__precio">🔥 Blaze <strong>$3.000</strong></span>
            <span class="camp-hero__precio">⚡ Nova <strong>$3.000</strong></span>
            <span class="camp-hero__precio camp-hero__precio--destacado">🔥⚡ Colección completa <strong>$5.000</strong></span>
          </div>
          <a class="btn camp-hero__cta" href="#campana-elegir">❤️‍🔥 Quiero apoyar</a>
          <a class="btn-quiet camp-hero__ver" href="#campana-elegir">Ver la colección ↓</a>
        </div>
        <div class="camp-hero__visual">
          <picture class="camp-mascota camp-mascota--hero">
            <source srcset="/media/campana2026-hero.webp" type="image/webp" />
            <img src="/media/campana2026-hero.jpg" alt="Blaze y Nova junto a los tres sobres digitales de la Campaña Firehouse 2026" width="760" height="950" loading="eager" />
          </picture>
        </div>
      </div>
    </section>

    <!-- POR QUÉ HACEMOS ESTA CAMPAÑA -->
    <section class="section camp-porque" id="campana-por-que">
      <div class="wrap reveal">
        <Etiqueta texto="Nuestra causa" />
        <h2 class="section__title">¿Por qué hacemos esta campaña?</h2>
        <p class="section__intro">
          Cada sobre adquirido ayuda a apoyar las actividades deportivas y competitivas de
          nuestras niñas y niños durante la temporada Firehouse 2026.
        </p>
        <p class="camp-porque__referido" id="campReferidoBanner" hidden>
          ❤️‍🔥 <span id="campReferidoTexto">Estás apoyando al deportista que te compartió este enlace</span>
        </p>
      </div>
    </section>

    <!-- CONTADOR -->
    <section class="section camp-contador-sec">
      <div class="wrap">
        <div class="camp-contador reveal">
          <div class="camp-contador__principal">
            <p class="camp-contador__meta">🔥 Nuestra meta: 800 sobres Firehouse</p>
            <div id="campContInicio" class="camp-contador__inicio">
              <p>Ayúdanos a llegar a nuestra meta de 800 sobres 🔥</p>
            </div>
            <div id="campContNormal" class="camp-contador__normal" hidden>
              <div class="camp-contador__fila">
                <span class="camp-contador__num" id="campContNum">0</span>
                <span class="camp-contador__total">/ 800</span>
              </div>
              <p class="camp-contador__label">sobres Firehouse adquiridos</p>
              <div class="camp-contador__barra"><div class="camp-contador__relleno" id="campContFill"></div></div>
            </div>
            <p class="camp-contador__tagline">Cada sobre nos acerca un poco más a nuestra meta ❤️‍🔥</p>
          </div>
          <div class="camp-contador__desglose">
            <div><span class="camp-contador__mini">🔥</span><span id="campContBlaze">0</span><p>Blaze</p></div>
            <div><span class="camp-contador__mini">⚡</span><span id="campContNova">0</span><p>Nova</p></div>
            <div><span class="camp-contador__mini">🔥⚡</span><span id="campContPack">0</span><p>Blaze + Nova</p></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ELIGE TU SOBRE -->
    <section class="section camp-productos" id="campana-elegir">
      <div class="wrap">
        <div class="reveal">
          <Etiqueta texto="La colección 2026" />
          <h2 class="section__title">Elige tu sobre</h2>
        </div>

        <div class="camp-productos__grid">
          {productos.map((p) => (
            <div class:list={['camp-producto', { 'camp-producto--destacado': p.destacado }]}>
              {p.destacado && <span class="camp-producto__badge">Colección completa</span>}
              <picture class="camp-producto__img">
                <source srcset={`/media/${p.img}.webp`} type="image/webp" />
                <img src={`/media/${p.img}.jpg`} alt={p.alt} width="560" height="700" loading="lazy" />
              </picture>
              <p class="camp-producto__nombre">{p.nombre}</p>
              <ul class="camp-producto__lista">
                {p.contenido.map((item) => <li>{item}</li>)}
              </ul>
              <p class="camp-producto__precio">{p.precioTexto}</p>
              <button type="button" class="camp-producto__btn" data-camp-producto={p.id}>{p.cta}</button>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- QUÉ RECIBES (detalle completo) -->
    <section class="section camp-detalle-sec" id="campana-contenido">
      <div class="wrap">
        <div class="reveal">
          <Etiqueta texto="Mira lo que viene dentro" />
          <h2 class="section__title">¿Qué recibes en tu sobre?</h2>
          <p class="section__intro">
            Cada sobre incluye una colección digital Firehouse descargable, diseñada
            especialmente para la campaña 2026.
          </p>
        </div>
        <div class="camp-detalle__lista">
          {detalle.map((d) => (
            <div class="camp-detalle">
              <div class="camp-detalle__cabecera">
                <picture class="camp-detalle__img">
                  <source srcset={`/media/${d.img}.webp`} type="image/webp" />
                  <img src={`/media/${d.img}.jpg`} alt={d.alt} width="140" height="175" loading="lazy" />
                </picture>
                <div>
                  <p class="camp-detalle__nombre">{d.nombre}</p>
                  <p class="camp-detalle__precio">{d.precioTexto}</p>
                </div>
              </div>
              <div class="camp-detalle__grupos">
                {d.grupos.map((g) => (
                  <div class="camp-detalle__grupo">
                    <p class="camp-detalle__grupo-titulo">🔥 {g.titulo}</p>
                    <ul class="camp-detalle__sub">
                      {g.items.map((it) => <li>{it}</li>)}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CÓMO FUNCIONA -->
    <section class="section camp-pasos">
      <div class="wrap">
        <div class="reveal">
          <Etiqueta texto="Paso a paso" />
          <h2 class="section__title">Cómo funciona</h2>
        </div>
        <ol class="camp-pasos__lista">
          {pasos.map((p) => (
            <li class="camp-paso">
              <span class="camp-paso__num">{p.n}</span>
              <div>
                <p class="camp-paso__titulo">{p.titulo}</p>
                <p class="camp-paso__desc">{p.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- PROMOCIÓN Y PREMIOS -->
    <section class="section camp-premios" id="campana-premios">
      <div class="wrap">
        <div class="reveal">
          <Etiqueta texto="Y además" />
          <h2 class="section__title">Tu sobre incluye una participación</h2>
          <p class="section__intro">
            Al adquirir uno de los productos participantes recibes, sin costo adicional,
            una participación en la promoción Firehouse 2026, conforme a sus bases.
          </p>
        </div>
        <div class="camp-premio camp-premio--principal">
          <p class="camp-premio__tag">Premio 1</p>
          <p class="camp-premio__titulo">$200.000 en efectivo</p>
          <p class="camp-premio__desc">Para gastar en lo que quieras</p>
        </div>
        <p class="camp-premios__teaser">🎁 Más premios por anunciarse antes del lanzamiento oficial de la campaña.</p>
      </div>
    </section>

    <!-- SORTEO -->
    <section class="section camp-sorteo" id="campana-sorteo">
      <div class="wrap">
        <div class="reveal">
          <Etiqueta texto="El sorteo" />
          <h2 class="section__title">Sorteo en vivo</h2>
        </div>
        <div class="camp-sorteo__card">
          <p class="camp-sorteo__fecha">Sábado 12 de diciembre · Instagram Live</p>
          <p class="camp-sorteo__texto">
            El sorteo se realiza en vivo por <strong>@firehouse.cheer</strong>, entre todas
            las participaciones válidamente registradas conforme a las bases — se realiza
            en la fecha publicada, se alcance o no la meta comercial. Un testigo acompaña
            el sorteo y el video queda publicado como respaldo.
          </p>
        </div>
      </div>
    </section>

    <!-- COMPARTIR -->
    <section class="section camp-compartir" id="campana-compartir">
      <div class="wrap">
        <div class="reveal">
          <Etiqueta texto="Ayúdanos a llegar más lejos" />
          <h2 class="section__title">Comparte la campaña</h2>
          <p class="section__intro">Mientras más personas conozcan nuestra colección, más cerca estaremos de nuestra meta.</p>
        </div>
        <div class="camp-compartir__botones">
          <a class="btn" href="#" data-camp-compartir="whatsapp">Compartir por WhatsApp</a>
          <a class="btn" href="#" data-camp-compartir="instagram">Compartir en Instagram</a>
        </div>
        <p class="camp-ayuda">
          ¿Dudas antes de participar?
          <a href={whatsapp('campana2026')} target="_blank" rel="noopener">Escríbenos por WhatsApp →</a>
        </p>
      </div>
    </section>

    <!-- PARTICIPACIÓN SIN COMPRA (bajo peso visual, a propósito) -->
    <section class="camp-gratis" id="campana-gratis">
      <div class="wrap camp-gratis__fila reveal">
        <p class="camp-gratis__texto">
          <strong>Modalidad de participación sin compra.</strong> La promoción también
          contempla una modalidad gratuita de participación conforme a sus bases.
        </p>
        <button type="button" class="btn-quiet camp-gratis__link" id="campGratisBtn">Consultar modalidad →</button>
      </div>
    </section>

    <!-- TRANSPARENCIA -->
    <section class="camp-transparencia">
      <div class="wrap">
        <p class="camp-transparencia__titulo">Transparencia Firehouse</p>
        <ul class="camp-transparencia__lista">
          <li><a href="/campana-2026/bases">Bases de la promoción</a></li>
          <li><a href="#campana-gratis">Participación sin compra</a></li>
          <li><a href="#campana-premios">Premios</a></li>
          <li><a href="#campana-sorteo">Fecha del sorteo</a></li>
          <li><span>Resultados</span><em>(se publican después del sorteo)</em></li>
          <li><a href="/privacidad">Política de privacidad</a></li>
          <li><a href={whatsapp('campana2026')} target="_blank" rel="noopener">Contacto</a></li>
          <li><span>Información del organizador</span><em>(por definir)</em></li>
        </ul>
        <p class="camp-transparencia__pie">Organizado por Firehouse Cheer.</p>
      </div>
    </section>

    <!-- CARRITO FIJO: oculto hasta que se elige un sobre -->
    <div class="camp-cart" id="campCart">
      <div class="wrap camp-cart__fila">
        <div class="camp-cart__chips" id="campCartChips"></div>
        <div class="camp-cart__pagar">
          <p class="camp-cart__total" id="campCartTotal">$0</p>
          <button type="button" class="btn" id="campCartPagar">Continuar al pago</button>
        </div>
      </div>
    </div>

    <!-- AVISO (pago en validación / participación gratuita) -->
    <div class="camp-aviso" id="campAviso" hidden>
      <div class="camp-aviso__fondo" id="campAvisoFondo"></div>
      <div class="camp-aviso__caja" role="dialog" aria-modal="true" aria-labelledby="campAvisoTitulo">
        <button type="button" class="camp-aviso__cerrar" id="campAvisoCerrar" aria-label="Cerrar">×</button>
        <h3 id="campAvisoTitulo">Medio de pago en proceso de validación</h3>
        <p class="camp-aviso__resumen" id="campAvisoResumen" hidden></p>
        <p id="campAvisoTexto">Estamos terminando de habilitar el pago en línea. Vuelve a intentarlo en unos días.</p>
        <a class="btn camp-aviso__wa" id="campAvisoWa" href={whatsapp('campana2026Pago')} target="_blank" rel="noopener">Escríbenos por WhatsApp</a>
      </div>
    </div>

    <!-- enlaces de WhatsApp con mensaje distinto según el aviso que los abrió -->
    <a href={whatsapp('campana2026Pago')} id="campAvisoWaPago" hidden>·</a>
    <a href={whatsapp('campana2026Gratis')} id="campAvisoWaGratis" hidden>·</a>

    <div class="camp-toast" id="campToast"></div>
  </div>
</Base>

<script>
  import { iniciarCampana2026 } from '../scripts/campana2026.ts';
  iniciarCampana2026();
</script>

<style is:global>
  .camp2026{ background:#000; }

  /* ---------- HERO ---------- */
  .camp-hero{ position:relative; overflow:hidden; padding:var(--e-6) 0 var(--e-5); }
  .camp-hero::before{
    content:''; position:absolute; top:-220px; left:50%; width:900px; height:760px;
    transform:translateX(-50%);
    background:radial-gradient(ellipse 50% 50% at 50% 50%, rgba(197,21,21,.55), rgba(255,196,0,.28) 45%, transparent 72%);
    filter:blur(10px); pointer-events:none;
  }
  .camp-hero__fila{
    position:relative; z-index:1; display:flex; flex-direction:column;
    align-items:center; text-align:center; gap:var(--e-5);
  }
  .camp-hero__texto{ max-width:var(--wrap-texto); }
  .camp-hero__visual{ width:100%; max-width:380px; }
  .camp-hero__titulo{ font-size:clamp(2.3rem, 7.2vw, 3.6rem); line-height:1.04; max-width:15ch; margin:0 auto var(--e-2); }
  .camp-hero__tagline{
    font-family:var(--font-display); font-weight:700; font-size:clamp(1.05rem, 2vw, 1.25rem);
    color:var(--fire-yellow); margin:0 auto var(--e-3);
  }
  .camp-hero__bajada{
    color:var(--txt-soft); max-width:46ch; margin:0 auto var(--e-4);
    font-size:clamp(1.05rem, 1.6vw, 1.2rem);
  }
  .camp-hero__precios{ display:flex; gap:10px; flex-wrap:wrap; margin-bottom:var(--e-3); justify-content:center; }
  .camp-hero__precio{
    font-family:var(--font-body); font-size:14px; color:var(--txt-soft);
    background:var(--ember-deep); border:1px solid var(--hairline); border-radius:99px; padding:6px 14px;
  }
  .camp-hero__precio strong{ font-family:var(--font-count); color:var(--chalk); }
  .camp-hero__precio--destacado{ background:rgba(255,196,0,.12); border-color:var(--fire-yellow); color:var(--chalk); font-weight:600; }
  .camp-hero__precio--destacado strong{ color:var(--fire-yellow); }
  .camp-hero__cta{ display:block; margin:0 auto; transform:rotate(var(--tilt-xl)); }
  .camp-hero__ver{ display:block; margin-top:var(--e-3); }
  @media (min-width:900px){
    .camp-hero__fila{ flex-direction:row; align-items:center; text-align:left; gap:var(--e-7); }
    .camp-hero__texto{ flex:1.15; max-width:none; }
    .camp-hero__visual{ flex:.85; max-width:420px; }
    .camp-hero__titulo{ max-width:none; margin:0 0 10px; font-size:clamp(2.8rem, 4.8vw, 4.2rem); }
    .camp-hero__tagline{ margin:0 0 var(--e-3); }
    .camp-hero__bajada{ margin:0 0 var(--e-4); }
    .camp-hero__precios{ justify-content:flex-start; }
    .camp-hero__cta{ margin:0; display:inline-block; }
    .camp-hero__ver{ display:inline-block; margin:var(--e-2) 0 0 var(--e-3); }
  }
  .camp-mascota{ display:block; width:100%; height:auto; }
  .camp-mascota img{ display:block; width:100%; height:auto; }
  .camp-mascota--hero{ max-width:360px; margin:0 auto; filter:drop-shadow(0 22px 30px rgba(0,0,0,.7)); }
  @media (min-width:900px){ .camp-mascota--hero{ max-width:100%; } }

  /* ---------- POR QUÉ ---------- */
  .camp-porque__referido{
    margin-top:var(--e-3); font-size:14px; color:var(--fire-yellow);
    background:rgba(255,196,0,.08); border:1px solid rgba(255,196,0,.3);
    padding:12px 16px; border-radius:12px; display:inline-block;
  }

  /* ---------- CONTADOR ---------- */
  .camp-contador{
    padding:var(--e-4); background:var(--ember-deep);
    border:1px solid var(--hairline); border-radius:12px;
  }
  .camp-contador__meta{ font-family:var(--font-count); font-size:13px; color:var(--fire-yellow); text-align:center; margin-bottom:10px; }
  .camp-contador__inicio p{
    margin:0; font-family:var(--font-display); font-weight:700; font-size:15px;
    color:var(--chalk); text-align:center;
  }
  .camp-contador__fila{ display:flex; justify-content:center; align-items:baseline; gap:8px; margin-bottom:10px; }
  .camp-contador__num{ font-family:var(--font-count); font-weight:700; font-size:clamp(2.2rem, 9vw, 3rem); color:var(--fire-yellow); line-height:1; }
  .camp-contador__total{ font-family:var(--font-count); font-size:15px; color:var(--txt-faint); }
  .camp-contador__label{ font-size:14px; color:var(--txt-faint); text-align:center; }
  .camp-contador__barra{ margin-top:14px; height:10px; background:var(--hairline); border-radius:var(--radio); overflow:hidden; }
