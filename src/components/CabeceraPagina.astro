---
import Etiqueta from './Etiqueta.astro';

/*
  Cabecera de página interior. Cada página trae su propio objeto gráfico
  y su color de acento, para que se note de inmediato que es otra sección.
*/
const { etiqueta, titulo, bajada, objeto = null, acento = 'amarillo', ruta } = Astro.props;
---
<nav class="migas" aria-label="Ruta">
  <div class="wrap">
    <a href="/">Inicio</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{ruta}</span>
  </div>
</nav>

<section class:list={['cabecera', `cabecera--${acento}`]}>
  <div class="wrap cabecera__fila">
    <div class="reveal">
      <Etiqueta texto={etiqueta} />
      <h1 class="cabecera__titulo">{titulo}</h1>
      <p class="cabecera__bajada">{bajada}</p>
      <div class="cabecera__accion"><slot /></div>
    </div>

    {objeto === 'megafono' && (
      <svg class="objeto" viewBox="0 0 120 120" aria-hidden="true">
        <path d="M18 46h20l52-26v80L38 74H18a8 8 0 0 1-8-8V54a8 8 0 0 1 8-8Z" fill="none" stroke="currentColor" stroke-width="5" stroke-linejoin="round"/>
        <path d="M38 74v26a6 6 0 0 0 6 6h10a6 6 0 0 0 6-6V86" fill="none" stroke="currentColor" stroke-width="5" stroke-linejoin="round"/>
        <path d="M102 46c8 5 8 23 0 28" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
      </svg>
    )}

    {objeto === 'mono' && (
      <svg class="objeto" viewBox="0 0 120 120" aria-hidden="true">
        <path d="M52 60 14 34c-6-4-12 1-10 8l8 34c1 7 8 10 13 6l27-22Z" fill="none" stroke="currentColor" stroke-width="5" stroke-linejoin="round"/>
        <path d="M68 60l38-26c6-4 12 1 10 8l-8 34c-1 7-8 10-13 6L68 60Z" fill="none" stroke="currentColor" stroke-width="5" stroke-linejoin="round"/>
        <rect x="50" y="46" width="20" height="28" rx="6" fill="none" stroke="currentColor" stroke-width="5"/>
        <path d="M60 78v28" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
      </svg>
    )}

    {objeto === 'etiqueta' && (
      <svg class="objeto" viewBox="0 0 120 120" aria-hidden="true">
        <path d="M60 12h44a4 4 0 0 1 4 4v44L58 110a6 6 0 0 1-8 0L12 72a6 6 0 0 1 0-8L60 12Z" fill="none" stroke="currentColor" stroke-width="5" stroke-linejoin="round"/>
        <circle cx="88" cy="32" r="8" fill="currentColor"/>
        <path d="M46 58h22M40 72h22M56 50v30" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
      </svg>
    )}
  </div>
</section>

<style>
.migas{
  border-bottom:0.5px solid var(--hairline);
  font-family:var(--font-count); font-size:12px; letter-spacing:.1em;
  color:var(--txt-faint);
}
.migas .wrap{ display:flex; gap:10px; padding-block:14px; }
.migas a{ color:var(--txt-soft); text-decoration:none; }
.migas a:hover{ color:var(--fire-yellow); }
.migas [aria-current]{ color:var(--fire-yellow); }

.cabecera{
  position:relative; overflow:hidden;
  padding:var(--e-8) 0 var(--e-7);
  border-bottom:var(--regla) solid var(--acento);
}
.cabecera--amarillo{ --acento:var(--fire-yellow); }
.cabecera--azul{ --acento:var(--mat-blue); }
.cabecera--rojo{ --acento:var(--fire-red); }

.cabecera__fila{ position:relative; display:flex; align-items:center; gap:var(--e-6); }

.cabecera__titulo{
  font-size:clamp(2.1rem, 5vw, 3.7rem);
  max-width:18ch; margin-top:var(--e-3);
}
.cabecera__bajada{
  color:var(--txt-soft); max-width:60ch;
  margin-top:var(--e-3); font-size:clamp(1.05rem, 1.6vw, 1.3rem); line-height:1.55;
}
.cabecera__accion{ margin-top:var(--e-5); }
.cabecera__accion:empty{ display:none; }

.objeto{
  flex:none; width:200px; height:auto;
  color:var(--acento); opacity:.16;
  transform:rotate(-6deg);
}

@media (max-width:900px){
  .cabecera__fila{ gap:var(--e-3); }
  .objeto{
    position:absolute; right:-30px; top:50%;
    transform:translateY(-50%) rotate(-6deg);
    width:150px; opacity:.10;
  }
}
</style>
