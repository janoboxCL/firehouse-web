---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { whatsapp } from '../data/sitio.js';

const titulo = 'Cheerleading en San Miguel, Santiago | Firehouse Cheer — clase de prueba gratis';
const descripcion = 'Academia de cheerleading en San Miguel para niñas y niños desde los 4 años. Sin experiencia previa y todos nuestros equipos compiten. Agenda una clase de prueba gratis por WhatsApp.';

const anio = [
  { n:'01', meses:'Marzo · Abril',       desde:3,  hasta:4,  hito:'Todo comienza.',        titulo:'Se parte de cero',     texto:'Llegan los que empiezan. Se arman los equipos del año y se trabajan las bases: coordinación, volteretas, confianza. Nadie llega sabiendo.' },
  { n:'02', meses:'Mayo · Junio',        desde:5,  hasta:6,  hito:'Se construye la base.', titulo:'Se sube la exigencia', texto:'Entrenamiento avanzado. Aparecen los stunts, las progresiones más complejas y el trabajo real de equipo.' },
  { n:'03', meses:'Julio a Septiembre',  desde:7,  hasta:9,  hito:'Toma forma la rutina.', titulo:'La coreografía',       texto:'Se monta la rutina de la temporada y se prepara la competencia. Es la etapa más intensa y la que más une al grupo.' },
  { n:'04', meses:'Octubre · Noviembre', desde:10, hasta:11, hito:'Se compite.',           titulo:'Los campeonatos',      texto:'Showcase y torneos. Todos los equipos compiten. Es lo que se estuvo preparando todo el año.', cumbre:true },
  { n:'05', meses:'Diciembre · Enero',   desde:12, hasta:1,  hito:'Se consolida.',         titulo:'Cierre y refuerzo',    texto:'Se cierra la temporada, se celebra lo conseguido y se refuerza lo que quedó pendiente.' },
];
---
<Base titulo={titulo} descripcion={descripcion} ruta="">
  <Hero />

  <section class="section" id="el-anio">
    <div class="wrap">
      <div class="reveal">
        <p class="count">5 · 6 · 7 · 8</p>
        <h2 class="section__title">Un año en Firehouse</h2>
      </div>
      <p class="section__intro reveal">
        El cheerleading tiene una temporada, como cualquier deporte de competencia.
        Esto es lo que pasa entre marzo y enero.
      </p>

      <ol class="anio">
        {anio.map(e => (
          <li class={`etapa reveal${e.cumbre ? ' etapa--cumbre' : ''}`} data-desde={e.desde} data-hasta={e.hasta}>
            {e.cumbre && (
              <svg class="etapa__copa" viewBox="0 0 100 120" aria-hidden="true">
                <path d="M28 12h44v26a22 22 0 0 1-44 0V12Z" fill="none" stroke="currentColor" stroke-width="4"/>
                <path d="M28 18H16a12 12 0 0 0 12 20M72 18h12a12 12 0 0 1-12 20" fill="none" stroke="currentColor" stroke-width="4"/>
                <path d="M50 60v22M34 96h32M30 108h40" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="square"/>
                <path d="M40 82h20v14H40z" fill="none" stroke="currentColor" stroke-width="4"/>
                <path d="m50 20 3.4 7 7.6 1-5.5 5.4 1.3 7.6L50 37.4 43.2 41l1.3-7.6L39 28l7.6-1L50 20Z" fill="currentColor"/>
              </svg>
            )}
            <div class="etapa__marca">
              <span class="etapa__n">{e.n}<i>/05</i></span>
              <p class="etapa__meses">{e.meses}</p>
            </div>
            <div class="etapa__cuerpo">
              <p class="etapa__hito">{e.hito}</p>
              <h3 class="etapa__titulo">{e.titulo}</h3>
              <p class="etapa__texto">{e.texto}</p>
              <span class="etapa__aqui">● Estamos acá</span>
            </div>
          </li>
        ))}
      </ol>

      <div class="anio__nota reveal">
        <h3>¿Cuándo es el mejor momento para entrar?</h3>
        <p>
          Se puede entrar en cualquier momento del año. Cuál es el mejor depende de cada deportista.
        </p>
        <p>
          <strong>Si parte de cero</strong>, lo ideal es sumarse en las etapas iniciales — marzo y abril,
          o diciembre y enero. Ahí el equipo completo está construyendo bases y nadie va más adelante que nadie.
        </p>
        <p>
          <strong>Si llega mientras se monta la coreografía</strong>, también funciona. Los coaches trabajan
          aparte con quien se incorpora hasta nivelarlo, y esta temporada se sumaron niñas y niños sin
          ninguna experiencia que se integraron sin problema.
        </p>
        <p>
          <strong>En plena temporada de campeonatos</strong> la incorporación es posible, y rinde mejor
          con algo de experiencia previa.
        </p>
        <p>
          Escríbenos y te decimos con franqueza qué conviene según su edad y lo que ya sabe hacer.
        </p>
        <p><a class="btn" href={whatsapp('anio')} target="_blank" rel="noopener">Ven a una clase de prueba gratis</a></p>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const m = new Date().getMonth() + 1;
      document.querySelectorAll('.etapa').forEach(el => {
        const d = +el.dataset.desde, h = +el.dataset.hasta;
        const dentro = d <= h ? (m >= d && m <= h) : (m >= d || m <= h);
        if (dentro) el.classList.add('etapa--ahora');
      });
    })();
  </script>
</Base>

<style>
.anio{ list-style:none; margin:64px 0 0; padding:0; }

/* Progresión ascendente: la temporada avanza hacia la derecha y culmina en los campeonatos */
@media (min-width:821px){
  .etapa:nth-child(1){ margin-left:0; }
  .etapa:nth-child(2){ margin-left:18px; }
  .etapa:nth-child(3){ margin-left:36px; }
  .etapa:nth-child(4){ margin-left:54px; margin-right:-18px; }
  .etapa:nth-child(5){ margin-left:36px; }
}

.etapa{
  position:relative;
  display:grid;
  grid-template-columns:minmax(230px, 300px) 1fr;
  gap:44px;
  align-items:center;
  padding:44px 44px;
  background:var(--ember-deep);
  clip-path:polygon(0 0, 100% 34px, 100% 100%, 0 calc(100% - 34px));
  margin-bottom:-12px;
}
.etapa:nth-child(even){
  clip-path:polygon(0 34px, 100% 0, 100% calc(100% - 34px), 0 100%);
}

.etapa__n{
  display:block;
  font-family:var(--font-count); font-weight:700;
  font-size:13px; letter-spacing:.22em; color:var(--fire-red);
}
.etapa__n i{ font-style:normal; color:var(--ash); }

.etapa__meses{
  font-family:var(--font-display); font-weight:800;
  font-size:clamp(1.9rem, 3.4vw, 2.9rem);
  line-height:1.02; letter-spacing:-.02em;
  color:var(--chalk); margin-top:10px;
}

/* Nivel 3: la frase que da sentido a la etapa */
.etapa__hito{
  font-family:var(--font-display); font-weight:800;
  font-size:clamp(1.35rem, 2.2vw, 1.9rem);
  color:var(--fire-yellow); line-height:1.1;
}
.etapa__titulo{
  font-size:clamp(1rem, 1.4vw, 1.15rem);
  font-family:var(--font-body); font-weight:500;
  letter-spacing:.14em; text-transform:uppercase;
  color:var(--txt-faint); margin-top:10px;
}
.etapa__texto{ color:var(--txt-soft); max-width:56ch; margin-top:12px; }

.etapa__aqui{
  display:none;
  margin-top:20px;
  background:var(--fire-yellow); color:#241512;
  font-family:var(--font-body); font-weight:500; font-size:12.5px;
  letter-spacing:.08em; padding:9px 22px;
  transform:skewX(var(--tilt-sm));
}
.etapa--ahora .etapa__aqui{ display:inline-block; }

/* Copa: adorno de la banda de campeonatos */
.etapa__copa{
  position:absolute; right:34px; top:50%;
  transform:translateY(-50%) rotate(-8deg);
  width:230px; height:auto;
  color:rgba(255,255,255,.13);
  pointer-events:none;
}
.etapa--ahora .etapa__meses{ color:var(--fire-yellow); }
.etapa--cumbre.etapa--ahora .etapa__hito{ color:var(--fire-yellow); }

/* El clímax: único bloque rojo de la sección */
.etapa--cumbre{ background:var(--fire-red); padding-block:70px; overflow:hidden; }
.etapa--cumbre .etapa__n{ color:rgba(255,255,255,.75); }
.etapa--cumbre .etapa__n i{ color:rgba(255,255,255,.45); }
.etapa--cumbre .etapa__meses{ color:#fff; font-size:clamp(2.1rem, 3.9vw, 3.3rem); }
.etapa--cumbre .etapa__hito{ color:#fff; font-size:clamp(1.6rem, 2.7vw, 2.3rem); }
.etapa--cumbre .etapa__titulo{ color:rgba(255,255,255,.72); }
.etapa--cumbre .etapa__texto{ color:rgba(255,255,255,.92); }
.etapa--cumbre.etapa--ahora .etapa__meses{ color:var(--fire-yellow); }
.etapa--cumbre.etapa--ahora .etapa__hito{ color:var(--fire-yellow); }

.anio__nota{
  margin-top:80px; padding:44px;
  background:var(--ember-deep);
  border-left:5px solid var(--mat-blue);
}
.anio__nota h3{ font-size:1.5rem; }
.anio__nota p{ color:var(--txt-soft); max-width:62ch; margin-top:14px; }
.anio__nota strong{ color:var(--chalk); font-weight:500; }

@media (max-width:820px){
  .etapa{ grid-template-columns:1fr; gap:18px; padding:34px 24px; clip-path:none; margin-bottom:8px; }
  .etapa:nth-child(even){ clip-path:none; }
  .etapa__copa{ width:130px; right:-14px; opacity:.7; }
}
</style>
