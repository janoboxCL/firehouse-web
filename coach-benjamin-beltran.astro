---
import Base from '../layouts/Base.astro';
import Etiqueta from '../components/Etiqueta.astro';
import BandaFoto from '../components/BandaFoto.astro';
import { whatsapp } from '../data/sitio.js';

const titulo = 'Coach Benjamín Beltrán | Head coach de Firehouse Cheer';
const descripcion = 'Benjamín Beltrán compite en cheerleading desde 1998 y entrena desde 2001. Dirigió el mismo programa escolar durante diecinueve temporadas y formó entrenadores en Brasil durante diez años. Head coach de Firehouse Cheer All Stars.';

const cifras = [
  { n: '27', t: 'años en el cheerleading' },
  { n: '19', t: 'temporadas dirigiendo un mismo colegio' },
  { n: '4.º', t: 'del mundo · USASF 2008' },
  { n: '10', t: 'años formando entrenadores en Brasil' },
];

const entrenador = [
  { a:'2001', t:'Primeros pasos al otro lado del mat',
    d:'Asistente del entrenador Elian Miranda en las municipalidades de Maipú y Cerrillos.' },
  { a:'2002', t:'Su primer equipo a cargo',
    d:'Dirige el Senior Escuela de la Universidad de Las Américas, el semillero de la selección universitaria.' },
  { a:'2003', t:'Su primera selección escolar',
    d:'Colegio Santa Margarita de Escocia, Ñuñoa. Tres temporadas construyendo una escuela desde cero.' },
  { a:'2006', b:'2025', t:'Diecinueve temporadas en el mismo colegio',
    d:'Al mando de las selecciones del Colegio Alicante del Rosal. Casi dos décadas consolidando un programa con resultados nacionales e internacionales.' },
  { a:'2013', t:'Podio en Orlando',
    d:'3.er lugar en Medium Varsity Cheer, AmeriCheer, con una selección formada solo por alumnos del colegio.' },
  { a:'2023', t:'Vuelve al mundial, veinte años después',
    d:'Con Cyclone Diamonds, reuniendo alumnos y exalumnos del mismo colegio para competir otra vez en Estados Unidos.' },
];

const deportista = [
  { a:'1998', t:'Tenía quince años',
    d:'Sus primeros entrenamientos en el equipo de barras del Colegio Alberto Widmer.' },
  { a:'2000', t:'Universidad de Las Américas',
    d:'Se incorpora al equipo universitario, donde compite durante una década.' },
  { a:'2005', t:'Tornado All Star',
    d:'Uno de los primeros clubes chilenos en el formato que hoy se conoce como All Star.' },
  { a:'2007', t:'Su primer mundial',
    d:'Con Tornado Wildcats representa a Chile en el Mundial USASF: 10.º lugar internacional y 2.º en la Copa de Naciones.' },
  { a:'2010', t:'Cierra su etapa competitiva',
    d:'Última participación como deportista, para dedicarse por completo a entrenar.' },
];

const preguntas = [
  { p: '¿Quién entrena a los equipos de Firehouse?',
    r: 'Benjamín Beltrán es el head coach. Compite en cheerleading desde 1998 y entrena desde 2001. Dirigió las selecciones del Colegio Alicante del Rosal durante diecinueve temporadas y participó en cuatro mundiales USASF, como deportista y como entrenador.' },
  { p: '¿Qué experiencia tiene entrenando niñas y niños?',
    r: 'Más de veinte años en programas escolares, trabajando con deportistas desde que empiezan hasta que llegan a competir internacionalmente.' },
  { p: '¿Ha formado a otros entrenadores?',
    r: 'Sí. Entre 2008 y 2018 participó anualmente en cursos y camps de capacitación para entrenadores en Brasil, invitado por la União Brasileira de Cheerleading.' },
];
---
<Base titulo={titulo} descripcion={descripcion} ruta="/coach-benjamin-beltran"
      preguntas={preguntas} miga="Coach Benjamín Beltrán">

  <nav class="migas" aria-label="Ruta">
    <div class="wrap">
      <a href="/">Inicio</a><span aria-hidden="true">/</span><span aria-current="page">Coach Benjamín Beltrán</span>
    </div>
  </nav>

  <section class="cab">
    <div class="wrap cab__fila">
      <div class="reveal">
        <Etiqueta texto="Head coach" />
        <h1 class="cab__titulo">Benjamín Beltrán</h1>
        <p class="cab__bajada">
          Empezó a competir a los quince años, en 1998. Sigue en el tapete.
        </p>
        <p class="cab__sub">
          Entrena desde 2001 y dirigió el mismo programa escolar durante diecinueve
          temporadas seguidas.
        </p>
      </div>
      <picture class="cab__foto reveal">
        <source srcset="/media/coach-retrato.webp" type="image/webp" />
        <img src="/media/coach-retrato.jpg" alt="Benjamín Beltrán, head coach de Firehouse Cheer, con una deportista de la academia" width="900" height="1200" />
      </picture>
    </div>
  </section>

  <section class="section significa">
    <div class="wrap reveal">
      <Etiqueta texto="Qué significa para tu hija" />
      <p class="significa__texto">
        Diecinueve años en un mismo colegio significan que cientos de familias lo dejaron a cargo
        de sus hijos y volvieron a hacerlo cada año. Y diez años enseñando a entrenadores en Brasil
        significan que no solo sabe competir: sabe explicar cómo se llega.
      </p>
      <ul class="cifras">
        {cifras.map(c => (
          <li class="cifra"><span class="cifra__n">{c.n}</span><span class="cifra__t">{c.t}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section linea">
    <div class="wrap">
      <div class="reveal">
        <Etiqueta texto="Como entrenador" />
        <h2 class="section__title">Veinticinco años formando equipos</h2>
      </div>

      <ol class="hitos">
        {entrenador.slice(0, 4).map(h => (
          <li class="hito reveal">
            <p class="hito__a">{h.a}{h.b && <i>—{h.b}</i>}</p>
            <div><h3>{h.t}</h3><p>{h.d}</p></div>
          </li>
        ))}
      </ol>

      <div class="cumbre reveal">
        <svg class="cumbre__copa" viewBox="0 0 100 120" aria-hidden="true">
          <path d="M28 12h44v26a22 22 0 0 1-44 0V12Z" fill="none" stroke="currentColor" stroke-width="4"/>
          <path d="M28 18H16a12 12 0 0 0 12 20M72 18h12a12 12 0 0 1-12 20" fill="none" stroke="currentColor" stroke-width="4"/>
          <path d="M50 60v22M34 96h32M30 108h40" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="square"/>
        </svg>
        <div class="cumbre__texto">
          <p class="cumbre__pais">2008 · Estados Unidos</p>
          <h3>4.º lugar del mundo</h3>
          <p>
            El primer equipo chileno de categoría junior en competir en Estados Unidos. Mundial
            USASF, con una selección formada exclusivamente por alumnos del colegio: los tres
            primeros puestos fueron para equipos estadounidenses, y Chile quedó como el mejor
            equipo internacional de la categoría.
          </p>
        </div>
        <picture class="cumbre__foto">
          <source srcset="/media/coach-competencia.webp" type="image/webp" />
          <img src="/media/coach-competencia.jpg" alt="Benjamín Beltrán compitiendo en el tapete durante un campeonato internacional" width="1600" height="900" loading="lazy" />
        </picture>
      </div>

      <ol class="hitos">
        {entrenador.slice(4).map(h => (
          <li class="hito reveal">
            <p class="hito__a">{h.a}</p>
            <div><h3>{h.t}</h3><p>{h.d}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <BandaFoto src="/media/coach-metodo.jpg"
             alt="Benjamín Beltrán hablando con el equipo de Firehouse sentado en círculo sobre el tapete"
             frase="Nadie ejecuta un movimiento antes de dominar el anterior." alto="medio" foco="center 55%" />

  <section class="section brasil">
    <div class="wrap reveal">
      <Etiqueta texto="Brasil · 2008-2018" />
      <h2 class="section__title">Diez años formando entrenadores</h2>
      <p class="brasil__texto">
        En 2008, invitado por Rodrigo Gonsalves, participa como formador en una de las primeras
        capacitaciones para entrenadores organizadas por la União Brasileira de Cheerleading.
      </p>
      <p class="brasil__texto">
        Lo que empezó como una invitación se transformó en una década de cursos, camps y jornadas
        en Porto Alegre, São Paulo y Río de Janeiro, durante los años en que el cheerleading
        brasileño recién se estaba construyendo.
      </p>
    </div>
  </section>

  <section class="section linea linea--dep">
    <div class="wrap">
      <div class="reveal">
        <Etiqueta texto="Como deportista" />
        <h2 class="section__title">De dónde viene</h2>
      </div>
      <ol class="hitos">
        {deportista.map(h => (
          <li class="hito reveal">
            <p class="hito__a">{h.a}</p>
            <div><h3>{h.t}</h3><p>{h.d}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section cita">
    <div class="wrap reveal">
      <blockquote>
        <p class="cita__texto">
          “Me desarrollé principalmente como base, destacando además por mi aporte coreográfico
          y sentido de equipo. Desde mis años como deportista busqué ser un apoyo para mis
          entrenadores y dejar una identidad propia en cada equipo del que formé parte.”
        </p>
        <cite>Benjamín Beltrán</cite>
      </blockquote>
    </div>
  </section>

  <section class="section hoy">
    <div class="wrap">
      <div class="reveal">
        <Etiqueta texto="Hoy" />
        <h2 class="section__title">Hoy, en Firehouse</h2>
        <p class="hoy__texto">
          Después de dos décadas en programas escolares y cuatro mundiales, dirige los equipos
          de Firehouse Cheer All Stars en La Cisterna, junto al coach Nicolás.
        </p>
      </div>
      <picture class="hoy__foto reveal">
        <source srcset="/media/coach-hoy.webp" type="image/webp" />
        <img src="/media/coach-hoy.jpg" alt="El plantel completo de Firehouse Cheer con sus entrenadores en el gimnasio" width="1600" height="780" loading="lazy" />
      </picture>
    </div>
  </section>

  <section class="section cierre">
    <div class="wrap reveal">
      <p class="cierre__frase">Ven a conocerlo entrenando.</p>
      <p class="cierre__sub">La primera clase es gratis y la dirige él.</p>
      <a class="btn" href={whatsapp('hero')} target="_blank" rel="noopener" id="wa-coach-cierre">Ven a una clase de prueba gratis</a>
    </div>
  </section>
</Base>

<style>
.migas{ border-bottom:0.5px solid var(--hairline); font-family:var(--font-count); font-size:12px; letter-spacing:.1em; color:var(--txt-faint); }
.migas .wrap{ display:flex; gap:10px; padding-block:var(--e-2); }
.migas a{ color:var(--txt-soft); text-decoration:none; }
.migas a:hover{ color:var(--fire-yellow); }
.migas [aria-current]{ color:var(--fire-yellow); }

.cab{ padding:var(--e-8) 0 var(--e-7); border-bottom:var(--regla) solid var(--mat-blue); }
.cab__fila{ display:flex; align-items:center; gap:var(--e-6); }
.cab__titulo{ font-size:clamp(2.4rem, 6vw, 4.4rem); margin-top:var(--e-3); }
.cab__bajada{
  font-family:var(--font-display); font-weight:800;
  font-size:clamp(1.2rem, 2.4vw, 1.8rem); line-height:1.15;
  color:var(--fire-yellow); margin-top:var(--e-3); max-width:22ch;
}
.cab__sub{ color:var(--txt-soft); max-width:46ch; margin-top:var(--e-2); line-height:1.6; }
.cab__foto{ flex:none; width:300px; }
.cab__foto img{ width:100%; height:auto; }

.significa{ background:var(--ember-deep); }
.significa__texto{ color:var(--txt-soft); max-width:var(--wrap-texto); margin-top:var(--e-3); font-size:clamp(1.05rem,1.6vw,1.25rem); line-height:1.6; }

.cifras{
  list-style:none; margin:var(--e-6) 0 0; padding:0;
  display:grid; grid-template-columns:repeat(auto-fit,minmax(190px,1fr)); gap:2px;
  background:var(--hairline);
}
.cifra{ background:var(--ember); padding:var(--e-4) var(--e-3); position:relative; overflow:hidden; }
.cifra::before{ content:''; position:absolute; left:0; top:0; width:100%; height:4px; background:var(--fire-red); }
.cifra__n{ display:block; font-family:var(--font-display); font-weight:800; font-size:clamp(3.2rem,6vw,4.6rem); line-height:.88; color:var(--fire-yellow); font-variant-numeric:tabular-nums; letter-spacing:-.02em; }
.cifra__t{ display:block; color:var(--txt-soft); font-size:14.5px; margin-top:var(--e-2); line-height:1.4; max-width:20ch; }

.hitos{ list-style:none; margin:var(--e-5) 0 0; padding:0; }
.hito{ display:flex; gap:var(--e-4); padding:var(--e-3) 0; border-bottom:0.5px solid var(--hairline); align-items:flex-start; }
.hito:first-child{ border-top:0.5px solid var(--hairline); }
.hito__a{ font-family:var(--font-display); font-weight:800; font-size:clamp(1.9rem,3.6vw,2.8rem); line-height:.95; color:rgba(245,239,232,.34); min-width:5.6ch; font-variant-numeric:tabular-nums; }
.hito__a i{ display:block; font-style:normal; font-size:.5em; }
.hito h3{ font-size:clamp(1.1rem,1.9vw,1.4rem); color:var(--fire-yellow); }
.hito p{ color:var(--txt-soft); max-width:62ch; margin-top:6px; line-height:1.6; }

.cumbre{ position:relative; overflow:hidden; background:var(--fire-red); padding:var(--e-6) var(--e-5); margin:var(--e-4) 0; display:flex; gap:var(--e-5); align-items:center; }
.cumbre__copa{ position:absolute; left:38%; top:50%; transform:translateY(-50%) rotate(-8deg); width:200px; color:rgba(255,255,255,.14); pointer-events:none; }
.cumbre__texto{ position:relative; flex:1; }
.cumbre__pais{ font-family:var(--font-count); font-size:12px; letter-spacing:.2em; text-transform:uppercase; color:rgba(255,255,255,.82); }
.cumbre h3{ font-size:clamp(1.7rem,3.4vw,2.6rem); margin-top:var(--e-1); }
.cumbre__texto p:last-child{ color:rgba(255,255,255,.94); margin-top:var(--e-2); max-width:52ch; line-height:1.6; }
.cumbre__foto{ flex:none; width:300px; }
.cumbre__foto img{ width:100%; height:auto; display:block; }

.brasil__texto{ color:var(--txt-soft); max-width:var(--wrap-texto); margin-top:var(--e-3); line-height:1.65; }

.linea--dep{ background:var(--ember-deep); }

.cita blockquote{ margin:0; border-left:var(--regla) solid var(--fire-yellow); padding-left:var(--e-5); }
.cita__texto{ font-family:var(--font-display); font-weight:800; font-size:clamp(1.3rem,2.6vw,2rem); line-height:1.25; max-width:34ch; }
.cita cite{ display:block; margin-top:var(--e-3); font-style:normal; font-family:var(--font-count); font-size:12.5px; letter-spacing:.14em; text-transform:uppercase; color:var(--fire-yellow); }

.hoy__texto{ color:var(--txt-soft); max-width:var(--wrap-texto); margin-top:var(--e-3); line-height:1.6; }
.hoy__foto{ display:block; margin-top:var(--e-5); }
.hoy__foto img{ width:100%; height:auto; display:block; }

.cierre{ background:var(--ember-deep); text-align:center; }
.cierre__frase{ font-family:var(--font-display); font-weight:800; font-size:clamp(1.6rem,3.2vw,2.4rem); line-height:1.05; }
.cierre__sub{ color:var(--txt-soft); margin-top:var(--e-1); }
.cierre .btn{ margin-top:var(--e-3); }

@media (max-width:900px){
  .cifras{ grid-template-columns:1fr 1fr; }
  .cab__fila{ flex-direction:column-reverse; align-items:flex-start; gap:var(--e-4); }
  .cab__foto{ width:210px; }
  .cumbre{ flex-direction:column; align-items:flex-start; padding:var(--e-5) var(--e-4); }
  .cumbre__foto{ width:100%; }
  .cumbre__copa{ left:auto; right:-26px; width:130px; }
  .hito{ flex-direction:column; gap:var(--e-1); }
  .hito__a{ font-size:2rem; }
  .cita blockquote{ padding-left:var(--e-3); }
}
</style>
