---
import '../styles/tokens.css';

const { titulo, ocultarCabecera = false } = Astro.props;
---
<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo} · Firehouse CRM</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;800&family=Instrument+Sans:wght@400;500&family=Space+Mono&display=swap" />
</head>
<body class="admin-tema">
  {!ocultarCabecera && (
    <header class="admin-header">
      <div class="admin-header__wrap">
        <a href="/admin" class="admin-header__marca">Firehouse <span>CRM</span></a>
        <nav class="admin-header__nav">
          <a href="/admin/clase-prueba" class="admin-header__link">Clase de prueba</a>
          <a href="/admin/concurso" class="admin-header__link">Concurso</a>
          <a href="/admin/campana-2026" class="admin-header__link">Campaña 2026</a>
          <a href="/admin/configuracion" class="admin-header__link">Configuración</a>
          <a href="/admin/plantillas" class="admin-header__link">Plantillas</a>
          <a href="/admin/apoderados" class="admin-header__link">Contactos</a>
          <a href="/admin/esquema" class="admin-header__link">Esquema</a>
          <span id="admin-usuario" class="admin-header__usuario"></span>
          <button type="button" id="admin-logout" class="admin-header__logout">Cerrar sesión</button>
        </nav>
      </div>
    </header>
  )}
  <main class="admin-main">
    <slot />
  </main>
</body>
</html>

<style is:global>
body.admin-tema{
  background: #F4F1EC;
  color: var(--ember);
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 1.5;
  margin: 0;
}
body.admin-tema h1, body.admin-tema h2, body.admin-tema h3{
  font-family: var(--font-display);
  color: var(--ember);
}
body.admin-tema a{ color: var(--fire-red); }

.admin-header{
  background: #fff; border-bottom: 1px solid #E4DFD6;
  position: sticky; top: 0; z-index: 10;
}
.admin-header__wrap{
  max-width: 1280px; margin-inline: auto; padding: 14px 24px;
  display: flex; align-items: center; justify-content: space-between;
}
.admin-header__marca{
  font-family: var(--font-display); font-weight: 800; font-size: 1.1rem;
  color: var(--ember); text-decoration: none;
}
.admin-header__marca span{ color: var(--fire-red); }
.admin-header__nav{ display: flex; align-items: center; gap: 16px; }
.admin-header__link{ font-size: 13px; color: var(--ember); text-decoration: none; }
.admin-header__link:hover{ color: var(--fire-red); }
.admin-header__usuario{ font-size: 13px; color: #6B6259; }
.admin-header__logout{
  background: none; border: 1px solid #D8D2C8; border-radius: 999px;
  padding: 8px 16px; font-size: 13px; cursor: pointer; color: var(--ember);
}
.admin-header__logout:hover{ border-color: var(--fire-red); color: var(--fire-red); }

.admin-main{ max-width: 1280px; margin-inline: auto; padding: 28px 24px 64px; }

.admin-card{
  background: #fff; border: 1px solid #E4DFD6; border-radius: 14px; padding: 20px;
}

.admin-btn{
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  background: var(--fire-red); color: #fff; border: none; border-radius: 10px;
  padding: 11px 20px; font-size: 14px; font-weight: 500; cursor: pointer;
  text-decoration: none; font-family: var(--font-body); min-height: 42px;
}
.admin-btn:hover{ background: #a91111; }
.admin-btn:disabled{ opacity: .6; cursor: not-allowed; }
.admin-btn[hidden]{ display: none; }
.admin-btn--secundario{
  background: #fff; color: var(--ember); border: 1px solid #D8D2C8;
}
.admin-btn--secundario:hover{ border-color: var(--ember); background: #fff; }
.admin-btn--whatsapp{ background: #25D366; color: #08380F; font-weight: 600; }
.admin-btn--whatsapp:hover{ background: #1FB958; }
.admin-btn--peligro{ background: #fff; color: var(--fire-red); border: 1px solid rgba(197,21,21,.4); }
.admin-btn--peligro:hover{ background: rgba(197,21,21,.06); border-color: var(--fire-red); }

.admin-input, .admin-select, .admin-textarea{
  width: 100%; box-sizing: border-box; background: #fff; color: var(--ember);
  border: 1px solid #D8D2C8; border-radius: 8px; padding: 10px 12px; font-size: 14px;
  font-family: var(--font-body); min-height: 40px;
}
.admin-textarea{ min-height: 80px; resize: vertical; }
.admin-input:focus-visible, .admin-select:focus-visible, .admin-textarea:focus-visible{
  outline: 2px solid var(--fire-red); outline-offset: 1px;
}
.admin-label{ display: block; font-size: 13px; font-weight: 500; color: #6B6259; margin-bottom: 6px; }

.admin-badge{
  display: inline-flex; align-items: center; border-radius: 999px; padding: 3px 10px;
  font-size: 12px; font-weight: 500; white-space: nowrap;
}
.admin-badge--journey{ background: #E9EEF9; color: #1B4FA8; }
.admin-badge--estado-abierto{ background: #FFF3D6; color: #8A5A00; }
.admin-badge--estado-cerrado-ok{ background: #E3F3E5; color: #1E7A34; }
.admin-badge--estado-cerrado-no{ background: #F1EAE6; color: #6B6259; }
.admin-badge--vencido{ background: #FBE3E3; color: #A91111; }
.admin-badge--prioridad-alta{ background: #FBE3E3; color: #A91111; }

.admin-spinner{ color: #6B6259; font-size: 14px; padding: 24px 0; }
.admin-vacio{ color: #6B6259; font-size: 14px; padding: 32px 0; text-align: center; }
.admin-intro{ font-size: 14px; color: #6B6259; margin: 0 0 20px; max-width: 60ch; }
.admin-error{
  background: #FBE3E3; border: 1px solid #E8A6A6; color: #7A1414;
  border-radius: 10px; padding: 12px 14px; font-size: 14px; margin-bottom: 16px;
}
.admin-aviso-cerrado{
  background: #FBF3D9; border: 1px solid #E8D6A1; color: #6B5B1A;
  border-radius: 10px; padding: 12px 14px; font-size: 14px; margin-bottom: 16px;
}
.admin-aviso-cerrado code{ background: rgba(0,0,0,.06); padding: 1px 5px; border-radius: 4px; }

/* ---------------------------------------------------------------------------
   Estilos de "ficha" compartidos entre /admin/caso y /admin/apoderado — viven
   acá (y no en cada página) para que ambas fichas se vean consistentes.
--------------------------------------------------------------------------- */
.ficha-volver{ display: inline-block; margin-bottom: 16px; font-size: 14px; color: #6B6259; text-decoration: none; }
.ficha-volver:hover{ color: var(--fire-red); }

.ficha-duplicado{ margin-bottom: 20px; }

.ficha-grid{ display: grid; grid-template-columns: 1.2fr 1fr; gap: 20px; align-items: start; }
.ficha-col{ display: flex; flex-direction: column; gap: 20px; }

.ficha-bloque__titulo{ font-size: 1.1rem; margin: 0 0 16px; }
.ficha-bloque__subtitulo{ font-size: 14px; font-weight: 500; margin: 0 0 10px; }

.ficha-datos{ display: grid; grid-template-columns: auto 1fr; gap: 10px 18px; margin: 0; font-size: 14px; }
.ficha-datos dt{ color: #6B6259; }
.ficha-datos dd{ margin: 0; font-weight: 500; }

.ficha-acciones{ display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
.ficha-whatsapp-nota{ font-size: 12px; color: #6B6259; margin-top: 10px; }

.ficha-aviso{
  background: #FFF3D6; color: #8A5A00; border-radius: 8px; padding: 10px 12px;
  font-size: 13px; margin-bottom: 16px;
}
.ficha-guardado{ color: #1E7A34; font-size: 13px; margin-top: 10px; }
.ficha-ayuda-journey{ font-size: 12px; color: #6B6259; margin-top: 6px; }

.ficha-peligro{ margin-top: 20px; border-color: rgba(197,21,21,.25); }
.ficha-peligro__texto{ font-size: 13px; color: #6B6259; margin: 0 0 14px; }

.ficha-historial{ margin-top: 20px; }
.ficha-timeline{ list-style: none; margin: 0 0 24px; padding: 0; }
.ficha-timeline li{ padding: 12px 0; border-bottom: 1px solid #EFEBE4; font-size: 14px; }
.ficha-timeline li:last-child{ border-bottom: none; }
.ficha-timeline__meta{ color: #6B6259; font-size: 12px; }
.ficha-timeline__tipo{ font-weight: 500; }

.ficha-nueva-interaccion{ border-top: 1px solid #EFEBE4; padding-top: 20px; }
.ficha-nueva-interaccion__fila{ max-width: 220px; margin-bottom: 10px; }
.ficha-contador{ font-size: 12px; color: #6B6259; text-align: right; margin: 6px 0 12px; }

/* Mini-tabla de atletas, reutilizada en el dashboard y en la ficha de apoderado */
.familia-card__atletas{ width: 100%; border-collapse: collapse; font-size: 14px; }
.familia-card__atletas th{
  text-align: left; padding: 8px 4px; font-size: 11px; text-transform: uppercase;
  letter-spacing: .04em; color: #6B6259; border-bottom: 1px solid #E4DFD6;
}
.familia-card__atletas td{
  padding: 12px 4px; border-top: 1px solid #EFEBE4; vertical-align: middle; cursor: pointer;
}
.familia-card__atletas tr:first-child td{ border-top: none; }
.familia-card__atletas tr:hover td{ background: #FAF8F4; }
.familia-card__atletas td:first-child{ font-weight: 500; }
.db-fila__vencido{ color: var(--fire-red); font-weight: 500; }

/* ---------------------------------------------------------------------------
   /admin/esquema — diagnóstico de la base de datos
--------------------------------------------------------------------------- */
.esq-acciones{ display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 20px; }
.esq-resumen{
  display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px;
  margin: 0 0 20px;
}
.esq-resumen > div{ background: #fff; border: 1px solid #E4DFD6; border-radius: 10px; padding: 12px 14px; }
.esq-resumen dt{ font-size: 12px; color: #6B6259; }
.esq-resumen dd{ margin: 4px 0 0; font-family: var(--font-display); font-weight: 800; font-size: 1.25rem; }
.esq-resumen dd.esq-resumen__texto{ font-family: var(--font-body); font-weight: 500; font-size: 14px; }
.esq-bloque{ margin-bottom: 20px; }
.esq-scroll{ overflow-x: auto; }
.esq-tabla{ width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 16px; }
.esq-tabla th{
  text-align: left; padding: 8px 6px; font-size: 12px; font-weight: 500; color: #6B6259;
  border-bottom: 1px solid #E4DFD6; white-space: nowrap;
}
.esq-tabla td{ padding: 8px 6px; border-top: 1px solid #EFEBE4; vertical-align: top; }
.esq-num{ text-align: right; font-variant-numeric: tabular-nums; }
.esq-detalle{ border-top: 1px solid #EFEBE4; }
.esq-detalle:first-child{ border-top: none; }
.esq-detalle summary{
  display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px;
  padding: 12px 0; cursor: pointer; font-size: 14px;
}
.esq-detalle summary:focus-visible{ outline: 2px solid var(--fire-red); outline-offset: 2px; }
.esq-detalle__nombre{ font-weight: 500; }
.esq-detalle__meta{ color: #6B6259; font-size: 13px; }

/* ---------------------------------------------------------------------------
   /admin/configuracion — programas, precios y periodos de inscripción
--------------------------------------------------------------------------- */
.cfg-seccion{ margin-top: 20px; }
.cfg-ayuda{ font-size: 13px; color: #6B6259; margin: -8px 0 16px; max-width: 70ch; }
.prg-cabecera{ display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px; margin-bottom: 8px; }
.prg-temporada{ min-width: 160px; }
.prg-tabla .admin-input{ max-width: 150px; }
.prg-tabla td{ vertical-align: middle; }
.prg-estado{ display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
.prg-estado__item{ border: 1px solid #EFEBE4; border-radius: 10px; padding: 14px; }
.prg-estado__programa{ font-weight: 600; margin: 0 0 8px; }
.prg-estado__detalle{ font-size: 13px; color: #6B6259; margin: 8px 0 0; }
.prg-periodos{ list-style: none; margin: 0 0 20px; padding: 0; }
.prg-periodo{ border-top: 1px solid #EFEBE4; padding: 14px 0; }
.prg-periodo:first-child{ border-top: none; }
.prg-periodo__cabecera{ display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
.prg-periodo__nombre{ font-weight: 500; margin: 0; }
.prg-periodo__fechas{
  display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 8px 16px;
  margin: 10px 0; font-size: 13px;
}
.prg-periodo__fechas dt{ color: #6B6259; }
.prg-periodo__fechas dd{ margin: 2px 0 0; font-weight: 500; }
.prg-periodo__acciones{ display: flex; flex-wrap: wrap; gap: 8px; }
.prg-periodo__acciones .admin-btn{ min-height: 36px; padding: 8px 14px; font-size: 13px; }
.prg-form-periodo{ border-top: 1px solid #E4DFD6; padding-top: 20px; }
.prg-campos{ display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 14px; margin-bottom: 14px; }

@media (max-width: 700px){
  .admin-header__wrap{ flex-wrap: wrap; gap: 10px; }
  .admin-header__nav{ flex-wrap: wrap; gap: 8px 14px; }
}
@media (max-width: 900px){
  .ficha-grid{ grid-template-columns: 1fr; }
}
.fm-form{ display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; align-items: end; }
.fm-cargo{ margin: 6px 0 0; font-weight: 600; }
.fm-vista{ font-size: 13px; color: #6B6259; margin: 14px 0 0; }
.fm-vista span{ color: var(--ember, #171412); font-style: italic; }
/* ---------------------------------------------------------------------------
   Selector de programa (dashboard y clase de prueba)
--------------------------------------------------------------------------- */
.fh-programa{ display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 16px; padding: 4px; background: #fff; border: 1px solid #E4DFD6; border-radius: 12px; width: fit-content; max-width: 100%; }
.fh-programa__tab{ display: inline-flex; align-items: center; gap: 8px; border: 0; background: transparent; border-radius: 9px; padding: 9px 14px; font: inherit; font-size: 14px; font-weight: 500; color: #6B6259; cursor: pointer; }
.fh-programa__tab:hover{ background: #F5EFE8; }
.fh-programa__tab:focus-visible{ outline: 2px solid var(--fire-red); outline-offset: 2px; }
.fh-programa__tab[aria-selected="true"]{ color: #fff; background: var(--ember, #171412); }
.fh-programa__tab--all_star[aria-selected="true"]{ background: var(--mat-blue, #1B4FA8); }
.fh-programa__tab--star[aria-selected="true"]{ background: var(--fire-yellow, #FFC400); color: var(--ember, #171412); }
.fh-programa__tab--sin_programa[aria-selected="true"]{ background: #6B6259; }
.fh-programa__conteo{ font-size: 12px; font-weight: 700; min-width: 22px; padding: 1px 7px; border-radius: 999px; background: rgba(0,0,0,.08); text-align: center; }
.fh-programa__tab[aria-selected="true"] .fh-programa__conteo{ background: rgba(255,255,255,.25); }
.fh-programa__tab--star[aria-selected="true"] .fh-programa__conteo{ background: rgba(0,0,0,.12); }
.fh-badge-programa{ display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 11px; font-weight: 700; white-space: nowrap; }
.fh-badge-programa--star{ background: var(--fire-yellow, #FFC400); color: var(--ember, #171412); }
.fh-badge-programa--all_star{ background: var(--mat-blue, #1B4FA8); color: #fff; }
@media (max-width: 700px){
  .familia-card__atletas thead{ display: none; }
  .familia-card__atletas, .familia-card__atletas tbody, .familia-card__atletas tr, .familia-card__atletas td{
    display: block; width: 100%;
  }
  .familia-card__atletas tr{ padding: 10px 0; border-top: 1px solid #EFEBE4; }
  .familia-card__atletas td{ border: none; padding: 2px 0; }
}
</style>
