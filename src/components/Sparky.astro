---
/*
  SPARKY — arte final.
  ---------------------------------------------------------------
  Usa las ilustraciones definitivas en /public/media/star/. El prop
  `pose` sigue siendo la referencia de qué gesto va en cada sección:

    idle     → parado, neutro (secciones informativas)
    wave     → saludando con una pata (hero)
    dizzy    → mareado / intentando algo (escenas de aprendizaje)
    excited  → celebrando, brazos arriba (CTA, logros)
    tired    → tirado, agotado (cierre divertido)

  Prop `size`: ancho en px. El alto se ajusta solo según la imagen real
  (cada pose tiene su propia proporción, ya no un viewBox fijo).
*/
const {
  pose = 'idle', size = 120, flip = false,
  class: claseExtra = '', alt = 'Sparky, la mascota de Firehouse',
} = Astro.props;

const base = `/media/star/sparky-${pose}`;
---
<picture
  class:list={['sparky', claseExtra]}
  style={`--sparky-size:${size}px; --sparky-flip:${flip ? -1 : 1}`}
>
  <source srcset={`${base}.webp`} type="image/webp" />
  <img src={`${base}.png`} alt={alt} loading="lazy" decoding="async" />
</picture>

<style>
.sparky{
  --sparky-size: 120px;
  --sparky-flip: 1;
  display: inline-block;
  width: var(--sparky-size);
  max-width: 100%;
  transform: scaleX(var(--sparky-flip));
  filter: drop-shadow(0 6px 10px rgba(23,20,18,.45));
}
.sparky img{ display: block; width: 100%; height: auto; }

/* ---- animación de entrada (hero) ---- */
@keyframes sparky-entra{
  0%   { transform: scaleX(var(--sparky-flip)) translateY(46px) scale(.7); opacity: 0; }
  60%  { transform: scaleX(var(--sparky-flip)) translateY(-8px) scale(1.04); opacity: 1; }
  80%  { transform: scaleX(var(--sparky-flip)) translateY(3px) scale(.99); }
  100% { transform: scaleX(var(--sparky-flip)) translateY(0) scale(1); }
}
.sparky--entrada{ animation: sparky-entra 900ms 300ms cubic-bezier(.22,.61,.36,1) both; }

@keyframes sparky-flota{
  0%, 100% { transform: scaleX(var(--sparky-flip)) translateY(0); }
  50%      { transform: scaleX(var(--sparky-flip)) translateY(-6px); }
}
.sparky--flota{ animation: sparky-flota 3.2s ease-in-out infinite; }

@keyframes sparky-salta{
  0%, 100% { transform: scaleX(var(--sparky-flip)) translateY(0) scale(1); }
  30%      { transform: scaleX(var(--sparky-flip)) translateY(-14px) scale(1.03); }
  50%      { transform: scaleX(var(--sparky-flip)) translateY(0) scale(.98); }
  65%      { transform: scaleX(var(--sparky-flip)) translateY(-4px) scale(1.01); }
}
.sparky--salta{ animation: sparky-salta 1.8s ease-in-out infinite; }

@media (prefers-reduced-motion: reduce){
  .sparky--entrada, .sparky--flota, .sparky--salta{ animation: none; }
}
</style>
