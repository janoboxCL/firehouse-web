---
import { sitio, whatsapp } from '../data/sitio.js';
---
<footer class="pie">
  <div class="wrap pie__grid">
    <div class="pie__marca">
      <picture>
        <source srcset="/logo.webp" type="image/webp" />
        <img class="pie__logo" src="/logo.png" alt="Firehouse Cheerleading All Stars" width="275" height="240" />
      </picture>
      <span class="pie__firma">Firehouse<sup>®</sup> · The One and Only</span>
      <span class="pie__lugar">{sitio.calle}, {sitio.comuna} · {sitio.ciudad}</span>
    </div>

    <nav class="pie__col" aria-label="Páginas">
      <p class="pie__rotulo">Páginas</p>
      <a href="/">Inicio</a>
      <a href="/clases-cheerleading-santiago">Entrenamientos</a>
      <a href="/clase-de-prueba">Clase de prueba</a>
      <a href="/precios">Precios</a>
      <a href="/coach-benjamin-beltran">El coach</a>
    </nav>

    <nav class="pie__col" aria-label="Secciones del inicio">
      <p class="pie__rotulo">En el inicio</p>
      <a href="/#equipos">Los equipos</a>
      <a href="/#el-anio">Un año en Firehouse</a>
      <a href="/#preguntas">Preguntas frecuentes</a>
      <a href="/#contacto">Contacto y mapa</a>
    </nav>

    <nav class="pie__col" aria-label="Contacto">
      <p class="pie__rotulo">Escríbenos</p>
      <a id="wa-pie" href={whatsapp('contacto')} target="_blank" rel="noopener">WhatsApp</a>
      <a id="ig-pie" href={sitio.instagram} target="_blank" rel="noopener">Instagram</a>
      <a id="correo-pie" href={`mailto:${sitio.correo}`}>Correo</a>
    </nav>
  </div>
</footer>

<style>
.pie{ border-top:0.5px solid var(--hairline); padding:var(--e-7) 0 var(--e-6); font-size:14px; }

.pie__grid{
  display:grid; grid-template-columns:1.4fr 1fr 1fr 1fr;
  gap:var(--e-5); align-items:start;
}

.pie__marca{ display:flex; flex-direction:column; gap:var(--e-1); }
.pie__logo{ height:64px; width:auto; opacity:.55; margin-bottom:var(--e-2); }
.pie__firma{
  font-family:var(--font-display); font-weight:800;
  font-size:13px; letter-spacing:.16em; text-transform:uppercase;
  color:var(--txt-soft);
}
.pie__firma sup{ font-size:.6em; letter-spacing:0; }
.pie__lugar{ color:var(--txt-faint); font-size:13.5px; }

.pie__col{ display:flex; flex-direction:column; gap:10px; }
.pie__rotulo{
  font-family:var(--font-body); font-size:12px; font-weight:500;
  letter-spacing:.14em; text-transform:uppercase; color:var(--fire-yellow);
  margin-bottom:2px;
}
.pie__col a{ color:var(--txt-faint); text-decoration:none; }
.pie__col a:hover{ color:var(--chalk); }

@media (max-width:900px){
  .pie__grid{ grid-template-columns:1fr 1fr; gap:var(--e-4); }
  .pie__marca{ grid-column:1 / -1; }
}
@media (max-width:520px){
  .pie__grid{ grid-template-columns:1fr; }
}
</style>
