---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ClasePrueba from '../components/ClasePrueba.astro';
import Semana from '../components/Semana.astro';
import Equipos from '../components/Equipos.astro';
import Precios from '../components/Precios.astro';
import Contacto from '../components/Contacto.astro';
import Etiqueta from '../components/Etiqueta.astro';
import BandaFoto from '../components/BandaFoto.astro';
import Faq from '../components/Faq.astro';
import Testimonios from '../components/Testimonios.astro';
import Coach from '../components/Coach.astro';
import QueEs from '../components/QueEs.astro';
import { whatsapp } from '../data/sitio.js';

const titulo = 'Clases de cheerleading en Santiago | Clase de prueba gratis';
const descripcion = 'Clases de cheerleading en Santiago para niñas y niños desde los 4 años. Se empieza sin experiencia y todos nuestros equipos compiten. En La Cisterna, a pasos del Metro Lo Ovalle. La primera clase es gratis.';

// Cada pregunta tiene su respuesta visible en la página. Google penaliza
// el schema de FAQ que no corresponde a contenido real.
const preguntas = [
  { p: '¿Desde qué edad se puede entrar a Firehouse?',
    r: 'Desde los 4 años. Los equipos se arman por edad cada temporada y todos entrenan el cheerleading completo.' },
  { p: '¿Hay que tener experiencia previa para empezar?',
    r: 'No. Se empieza sin saber nada: los equipos se arman con quienes llegan y las bases se trabajan desde cero.' },
  { p: '¿Cuándo es el mejor momento para entrar?',
    r: 'Se puede entrar en cualquier momento del año. Si se parte de cero, lo ideal es sumarse en las etapas iniciales (marzo y abril, o diciembre y enero). Durante la coreografía también funciona: los coaches trabajan aparte con quien se incorpora hasta nivelarlo.' },
  { p: '¿La clase de prueba tiene costo?',
    r: 'No. La primera clase es gratis y sin compromiso: es una clase real con el equipo que corresponde por edad y con los mismos coaches que lo entrenan. No es una audición y no se evalúa a nadie.' },
  { p: '¿Cuánto cuesta una temporada de cheerleading?',
    r: 'La matrícula es de $10.000 por una vez y la mensualidad de $30.000 entre marzo y diciembre. Durante la temporada se suman la tenida de entrenamiento, el uniforme de competencia y el pack de competencias, cada uno en el momento del año en que se necesita.' },
  { p: '¿Los niños también pueden hacer cheerleading?',
    r: 'Sí. El cheerleading competitivo contempla categorías mixtas y en Firehouse entrenan niñas y niños.' },
];

const anio = [
  { n:'1', meses:'marzo — abril',       desde:3,  hasta:4,  hito:'Empieza la temporada.', titulo:'Bases y regreso',      texto:'Se arman los equipos del año y conviven dos caminos. Para quienes llegan por primera vez son las primeras bases: coordinación, volteretas, confianza. Para quienes vuelven de la temporada anterior es retomar el trabajo y afinar la técnica que ya traen, y son quienes le muestran a los que recién llegan cómo se entrena acá. Nadie llega sabiendo y nadie termina de aprender.' },
  { n:'2', meses:'mayo — junio',        desde:5,  hasta:6,  hito:'Se construye la base.', titulo:'Se sube la exigencia', texto:'El entrenamiento avanza. Aparecen los stunts, las progresiones más complejas y el trabajo real de equipo.' },
  { n:'3', meses:'julio — septiembre',  desde:7,  hasta:9,  hito:'Toma forma la rutina.', titulo:'La coreografía',       texto:'Se monta la rutina de la temporada y se prepara la competencia. Es la etapa más intensa y la que más une al grupo.' },
  { n:'4', meses:'octubre — noviembre', desde:10, hasta:11, hito:'Se compite.',           titulo:'Los campeonatos',      texto:'Showcase y torneos. Llega el momento de mostrar todo lo que el equipo preparó durante el año.', cumbre:true },
  { n:'5', meses:'diciembre — enero',   desde:12, hasta:1,  hito:'Se consolida.',         titulo:'Cierre y refuerzo',    texto:'Se cierra la temporada, se celebra lo conseguido y se refuerzan las habilidades que van a seguir creciendo.' },
];
---
<Base titulo={titulo} descripcion={descripcion} ruta="" preguntas={preguntas}>
  <Hero />

  <QueEs />

  <ClasePrueba />

  <Semana />

  <BandaFoto src="/media/banda-equipo.jpg" alt="Deportistas de Firehouse durante un entrenamiento"
             frase="Nadie llega sabiendo. Todos entrenan para competir." alto="medio" />

  <section class="section anio-seccion" id="el-anio">
    <div class="wrap">
      <div class="reveal">
        <Etiqueta texto="5 · 6 · 7 · 8" />
        <h2 class="section__title">Un año en Firehouse</h2>
      </div>
      <p class="section__intro reveal">
        El cheerleading tiene una temporada, como cualquier deporte de competencia.
        Esto es lo que pasa entre marzo y enero.
      </p>

      <ol class="anio">
        {anio.map(e => (
          <li class={`etapa reveal${e.cumbre ? ' etapa--cumbre' : ''}`} data-desde={e.desde} data-hasta={e.hasta}>
            {e.cumbre && (
              <svg class="etapa__copa" viewBox="0 0 100 120" aria-hidden="true">
                <path d="M28 12h44v26a22 22 0 0 1-44 0V12Z" fill="none" stroke="currentColor" stroke-width="4"/>
                <path d="M28 18H16a12 12 0 0 0 12 20M72 18h12a12 12 0 0 1-12 20" fill="none" stroke="currentColor" stroke-width="4"/>
                <path d="M50 60v22M34 96h32M30 108h40" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="square"/>
                <path d="M40 82h20v14H40z" fill="none" stroke="currentColor" stroke-width="4"/>
                <path d="m50 20 3.4 7 7.6 1-5.5 5.4 1.3 7.6L50 37.4 43.2 41l1.3-7.6L39 28l7.6-1L50 20Z" fill="currentColor"/>
              </svg>
            )}
            <div class="etapa__marca">
              <span class="etapa__n"><i>Etapa</i> {e.n} <i>/ 5</i></span>
              <p class="etapa__meses">{e.meses}</p>
            </div>
            <div class="etapa__cuerpo">
              <p class="etapa__hito">{e.hito}</p>
              <h3 class="etapa__titulo">{e.titulo}</h3>
              <p class="etapa__texto">{e.texto}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="anio__nota reveal">
        <svg class="anio__calendario" viewBox="0 0 120 110" aria-hidden="true">
          <rect x="6" y="18" width="108" height="86" rx="4" fill="none" stroke="currentColor" stroke-width="4"/>
          <path d="M6 42h108M32 6v22M88 6v22" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
          <path d="M28 58h14M53 58h14M78 58h14M28 80h14M78 80h14" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
          <rect x="49" y="72" width="22" height="16" rx="2" fill="currentColor"/>
        </svg>
        <h3>¿Cuándo es el mejor momento para entrar?</h3>
        <p class="nota__entrada">
          Se puede entrar en cualquier momento del año. Cuál es el mejor depende de cada deportista.
        </p>

        <h4>Si parte de cero</h4>
        <p>
          Lo ideal es sumarse en las etapas iniciales — marzo y abril, o diciembre y enero.
          Ahí resulta más fácil construir las bases junto al resto del equipo.
        </p>

        <h4>Si se suma durante la coreografía</h4>
        <p>
          También funciona. Los coaches trabajan aparte con quien se incorpora hasta nivelarlo:
          esta temporada se sumaron niñas y niños sin ninguna experiencia y se integraron bien
          al proceso.
        </p>

        <h4>Si llega durante los campeonatos</h4>
        <p>
          La incorporación es posible, y rinde mejor con algo de experiencia previa.
        </p>

        <p class="nota__cierre">
          Escríbenos y te decimos con franqueza qué conviene según su edad y lo que ya sabe hacer.
        </p>
        <p class="nota__accion"><a class="cta-texto" id="wa-home-anio" href={whatsapp('anio')} target="_blank" rel="noopener">Ven a una clase de prueba gratis</a></p>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const m = new Date().getMonth() + 1;
      document.querySelectorAll('.etapa').forEach(el => {
        const d = +el.dataset.desde, h = +el.dataset.hasta;
        const dentro = d <= h ? (m >= d && m <= h) : (m >= d || m <= h);
        if (dentro) {
          el.classList.add('etapa--ahora');
          el.setAttribute('aria-current', 'step');
          const marca = document.createElement('span');
          marca.className = 'etapa__aqui';
          marca.textContent = '● Estamos acá';
          el.querySelector('.etapa__cuerpo')?.appendChild(marca);
        }
      });
    })();
  </script>

  <Equipos />

  <BandaFoto src="/media/banda-competencia.jpg" alt="El equipo de Firehouse en competencia"
             alto="bajo" />

  <Precios />

  <Testimonios />

  <BandaFoto src="/media/banda-cierre.jpg"
             alt="El equipo de Firehouse junto a su coach después de un entrenamiento"
             alto="medio" foco="center 38%" />

  <Faq preguntas={preguntas} titulo="Lo que nos preguntan siempre" />

  <Coach />

  <Contacto />
</Base>

<style>
.anio-seccion{ background:var(--ember); }
.anio{ list-style:none; margin:var(--e-6) 0 0; padding:0; }



.etapa{
  position:relative;
  display:grid;
  grid-template-columns:minmax(230px, 300px) 1fr;
  gap:44px;
  align-items:center;
  padding:44px 44px;
  background:var(--ember-deep);
  clip-path:polygon(0 0, 100% 34px, 100% 100%, 0 calc(100% - 34px));
  margin-bottom:14px;
}
.etapa:nth-child(even){
  clip-path:polygon(0 34px, 100% 0, 100% calc(100% - 34px), 0 100%);
}

.etapa__n{
  display:block;
  font-family:var(--font-count); font-weight:700;
  font-size:13px; letter-spacing:.22em; color:var(--txt-faint);
  font-variant-numeric:tabular-nums;
  min-width:6ch;
}
.etapa__n i{ font-style:normal; color:var(--ash); letter-spacing:.14em; }

.etapa__meses{
  font-family:var(--font-display); font-weight:800;
  font-size:clamp(1.9rem, 3.4vw, 2.9rem);
  line-height:1.02; letter-spacing:-.02em;
  color:var(--chalk); margin-top:10px;
}

/* Nivel 3: la frase que da sentido a la etapa */
.etapa__hito{
  font-family:var(--font-display); font-weight:800;
  font-size:clamp(1.35rem, 2.2vw, 1.9rem);
  color:var(--fire-yellow); line-height:1.1;
}
.etapa__titulo{
  font-size:clamp(1rem, 1.4vw, 1.15rem);
  font-family:var(--font-body); font-weight:500;
  letter-spacing:.14em; text-transform:uppercase;
  color:var(--txt-faint); margin-top:10px;
}
.etapa__texto{ color:var(--txt-soft); max-width:62ch; margin-top:var(--e-2); line-height:1.6; }

.etapa__aqui{
  margin-top:20px;
  background:var(--fire-yellow); color:#1C1A18;
  font-family:var(--font-body); font-weight:500; font-size:12.5px;
  letter-spacing:.08em; padding:9px 22px;
  transform:skewX(var(--tilt-sm));
}
.etapa__aqui{ display:inline-block; }

/* Copa: adorno de la banda de campeonatos */
.etapa__copa{
  position:absolute; right:34px; top:50%;
  transform:translateY(-50%) rotate(-8deg);
  width:230px; height:auto;
  color:rgba(255,255,255,.13);
  pointer-events:none;
}
.etapa--ahora .etapa__meses{ color:var(--fire-yellow); }
.etapa--cumbre.etapa--ahora .etapa__hito{ color:var(--fire-yellow); }

/* El clímax: único bloque rojo de la sección */
.etapa--cumbre{ background:var(--fire-red); padding-block:70px; overflow:hidden; }
.etapa--cumbre .etapa__n{ color:rgba(255,255,255,.7); }
.etapa--cumbre .etapa__n i{ color:rgba(255,255,255,.45); }
.etapa--cumbre .etapa__meses{ color:#fff; font-size:clamp(2.1rem, 3.9vw, 3.3rem); }
.etapa--cumbre .etapa__hito{ color:#fff; font-size:clamp(1.6rem, 2.7vw, 2.3rem); }
.etapa--cumbre .etapa__titulo{ color:rgba(255,255,255,.72); }
.etapa--cumbre .etapa__texto{ color:rgba(255,255,255,.92); }
.etapa--cumbre.etapa--ahora .etapa__meses{ color:var(--fire-yellow); }
.etapa--cumbre.etapa--ahora .etapa__hito{ color:var(--fire-yellow); }

.anio__nota{
  position:relative; overflow:hidden;
  margin-top:var(--e-8); padding:var(--e-6);
  background:var(--ember-deep);
  border-left:var(--regla) solid var(--mat-blue);
}
.anio__calendario{
  position:absolute; right:40px; top:50%;
  transform:translateY(-50%) rotate(-6deg);
  width:190px; height:auto;
  color:rgba(245,239,232,.06);
  pointer-events:none;
}
.anio__nota > *{ position:relative; }
.anio__nota h3{ font-size:clamp(1.6rem, 2.9vw, 2.2rem); color:var(--fire-yellow); max-width:18ch; }
.anio__nota p{ color:var(--txt-soft); max-width:var(--wrap-texto); margin-top:var(--e-1); line-height:1.6; }
.anio__nota h4{
  font-family:var(--font-body); font-weight:500;
  font-size:14px; letter-spacing:.12em; text-transform:uppercase;
  color:var(--fire-yellow); margin:var(--e-4) 0 0;
}
.nota__entrada{ font-size:1.12rem; }
.nota__cierre{ margin-top:var(--e-4) !important; color:var(--chalk) !important; }
.nota__accion{ margin-top:var(--e-5) !important; }


@media (max-width:820px){
  .etapa{ grid-template-columns:1fr; gap:18px; padding:34px 24px; clip-path:none; margin-bottom:8px; }
  .etapa:nth-child(even){ clip-path:none; }
  .etapa__copa{ width:130px; right:-14px; opacity:.7; }
  .anio__calendario{ width:120px; right:-18px; }
}
</style>
