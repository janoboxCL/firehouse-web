---
import Etiqueta from './Etiqueta.astro';
import { testimonios, resumen } from '../data/testimonios.js';
const hay = testimonios.length > 0;
---
{hay && (
<section class="section testi" id="testimonios">
  <div class="wrap">
    <div class="testi__cabecera reveal">
      <div>
        <Etiqueta texto="Qué dicen las familias" />
        <h2 class="section__title">Lo que cuentan los apoderados</h2>
      </div>

      {resumen.nota && (
        <div class="nota">
          <p class="nota__cifra">{resumen.nota}</p>
          <p class="nota__estrellas" aria-hidden="true">★★★★★</p>
          <p class="nota__pie">{resumen.cantidad} reseñas en Google</p>
        </div>
      )}
    </div>

    <div class="testi__lista">
      {testimonios.map(t => (
        <blockquote class:list={['cita', 'reveal', t.destacado && 'cita--destacada']}>
          <p class="cita__texto">{t.texto}</p>
          <cite class="cita__autor">{t.autor}</cite>
        </blockquote>
      ))}
    </div>

    {resumen.enlace && (
      <p class="testi__ver reveal">
        <a class="cta-texto" href={resumen.enlace} target="_blank" rel="noopener" id="google-resenas">
          Ver las reseñas en Google
        </a>
      </p>
    )}
  </div>
</section>
)}

<style>
.testi{ background:var(--ember-deep); }

.testi__cabecera{
  display:flex; align-items:flex-end; justify-content:space-between;
  gap:var(--e-5); flex-wrap:wrap;
}

.nota{ text-align:center; flex:none; }
.nota__cifra{
  font-family:var(--font-display); font-weight:800;
  font-size:clamp(3rem, 7vw, 5rem); line-height:.9;
  color:var(--fire-yellow); font-variant-numeric:tabular-nums;
}
.nota__estrellas{ color:var(--fire-yellow); letter-spacing:.22em; font-size:15px; margin-top:var(--e-1); }
.nota__pie{ color:var(--txt-faint); font-family:var(--font-count); font-size:12.5px; letter-spacing:.1em; margin-top:6px; }

.testi__lista{ display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:var(--e-3); margin-top:var(--e-6); align-items:stretch; }

.cita{
  position:relative; margin:0; display:flex; flex-direction:column;
  background:var(--ember); padding:var(--e-5) var(--e-4) var(--e-4);
  clip-path:polygon(0 0, 100% 20px, 100% 100%, 0 calc(100% - 20px));
}
.cita::before{
  content:'”';
  position:absolute; top:-6px; left:var(--e-4);
  font-family:var(--font-display); font-weight:800; font-size:5rem; line-height:1;
  color:var(--fire-red); opacity:.5;
}
.cita__texto{
  position:relative;
  font-family:var(--font-display); font-weight:800;
  font-size:clamp(1.1rem, 1.9vw, 1.4rem); line-height:1.28;
}
.cita__autor{
  display:block; margin-top:auto; padding-top:var(--e-3); font-style:normal;
  font-family:var(--font-count); font-size:12.5px; letter-spacing:.14em;
  text-transform:uppercase; color:var(--fire-yellow);
}

/* La reseña más fuerte ocupa el ancho completo y sube de escala */
.cita--destacada{ grid-column:1 / -1; padding:var(--e-6) var(--e-5) var(--e-5); }
.cita--destacada .cita__texto{ font-size:clamp(1.4rem, 3vw, 2.2rem); line-height:1.18; max-width:26ch; }
.cita--destacada::before{ font-size:7rem; }

.testi__ver{ margin-top:var(--e-4); }

@media (max-width:820px){
  .testi__lista{ grid-template-columns:1fr; }
  .cita{ clip-path:none; }
  .testi__cabecera{ align-items:flex-start; }
}
</style>
