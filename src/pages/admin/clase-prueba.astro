---
import AdminBase from '../../layouts/AdminBase.astro';
---
<AdminBase titulo="Clase de prueba">
  <a href="/admin" class="ficha-volver">← Volver al listado de casos</a>
  <div class="cp-header">
    <h1 class="db-titulo">Clases de prueba y primeras clases</h1>
    <button type="button" id="cp-btn-visita-rapida" class="admin-btn admin-btn--secundario">+ Agregar visita rápida</button>
  </div>
  <p class="admin-intro">
    Quiénes vienen a una clase de prueba o a su primera clase de Firehouse Star, agrupados por
    fecha. Registra la talla, envía los mensajes por WhatsApp o por correo (a una familia o a todo
    el grupo de una fecha), cambia la fecha si alguien no puede venir y marca la asistencia.
  </p>

  <div id="cp-error" class="admin-error" hidden></div>
  <p id="cp-visita-guardada" class="ficha-guardado" hidden></p>

  <section class="admin-card cp-visita-form" id="cp-visita-form-wrap" hidden>
    <h2 class="ficha-bloque__titulo">Visita rápida</h2>
    <p class="admin-intro">
      Para alguien que llegó a probar sin haberse registrado antes. Queda marcado
      como asistió hoy mismo — más adelante le enviamos un link para completar
      el resto del registro.
    </p>
    <form id="cp-form-visita">
      <div class="cp-visita-grid">
        <div class="admin-campo">
          <label class="admin-label" for="vr-apoderado-nombre">Nombre del apoderado</label>
          <input id="vr-apoderado-nombre" class="admin-input" type="text" required />
        </div>
        <div class="admin-campo">
          <label class="admin-label" for="vr-apoderado-apellidos">Apellidos del apoderado</label>
          <input id="vr-apoderado-apellidos" class="admin-input" type="text" />
        </div>
        <div class="admin-campo">
          <label class="admin-label" for="vr-telefono">Teléfono</label>
          <input id="vr-telefono" class="admin-input" type="tel" placeholder="9 1234 5678" required />
        </div>
        <div class="admin-campo">
          <label class="admin-label" for="vr-email">Correo</label>
          <input id="vr-email" class="admin-input" type="email" required />
        </div>
      </div>
      <div class="admin-campo">
        <label class="admin-label" for="vr-nota">Nota</label>
        <textarea id="vr-nota" class="admin-textarea" placeholder='Ej: "Dos niñas de 12 y 10 años"' required></textarea>
      </div>
      <label class="cp-consentimiento">
        <input type="checkbox" id="vr-consentimiento" required />
        Confirmo que el apoderado autorizó verbalmente que Firehouse lo contacte.
      </label>
      <div class="ficha-acciones">
        <button type="submit" class="admin-btn">Registrar visita</button>
        <button type="button" id="cp-btn-cancelar-visita" class="admin-btn admin-btn--secundario">Cancelar</button>
      </div>
    </form>
  </section>

 <div id="cp-programa" class="fh-programa" aria-label="Programa"></div>
  <div id="cp-aviso-mensajes" class="admin-aviso-cerrado" hidden></div>

  <section class="admin-card cp-lista-wrap">
    <p id="cp-cargando" class="admin-spinner">Cargando…</p>
    <p id="cp-vacio" class="admin-vacio" hidden>No hay clases de prueba agendadas todavía.</p>
    <div id="cp-grupos"></div>
  </section>

  <dialog id="cp-dialogo-correo" class="cp-dialogo" aria-labelledby="cp-dialogo-titulo">
    <h2 id="cp-dialogo-titulo" class="ficha-bloque__titulo">Revisa el correo antes de enviarlo</h2>
    <p class="cp-dialogo__dato">Para: <strong id="cp-correo-para"></strong></p>
    <p class="cp-dialogo__dato">Asunto: <strong id="cp-correo-asunto"></strong></p>
    <iframe id="cp-correo-previa" class="cp-dialogo__previa" title="Vista previa del correo" sandbox=""></iframe>
    <div class="ficha-acciones">
      <button type="button" id="cp-correo-enviar" class="admin-btn">Enviar correo</button>
      <button type="button" id="cp-correo-cancelar" class="admin-btn admin-btn--secundario">Cancelar</button>
    </div>
  </dialog>

  <dialog id="cp-dialogo-grupo" class="cp-dialogo cp-dialogo--grupo" aria-labelledby="cp-grupo-titulo">
    <h2 id="cp-grupo-titulo" class="ficha-bloque__titulo">Enviar correo al grupo</h2>
    <div class="cp-grupo-cols">
      <div class="cp-grupo-izq">
        <label class="admin-label" for="cp-grupo-plantilla">Mensaje</label>
        <select id="cp-grupo-plantilla" class="admin-select"></select>
        <div class="cp-grupo__barra">
          <span class="admin-label">Familias</span>
          <span>
            <button type="button" id="cp-grupo-todos" class="cp-link-fecha">Todas</button>
            <button type="button" id="cp-grupo-ninguno" class="cp-link-fecha">Ninguna</button>
          </span>
        </div>
        <ul id="cp-grupo-lista" class="cp-grupo__lista"></ul>
        <label class="cp-grupo__copia">
          <input type="checkbox" id="cp-grupo-copia" checked />
          <span>Enviar una copia con el resumen a quienes hoy reciben las copias de los correos del panel (en vez de una copia por cada familia)</span>
        </label>
      </div>
      <div class="cp-grupo-der">
        <p class="cp-dialogo__dato">Vista previa: <strong id="cp-grupo-previa-para"></strong></p>
        <p class="cp-dialogo__dato">Asunto: <strong id="cp-grupo-previa-asunto"></strong></p>
        <iframe id="cp-grupo-previa" class="cp-dialogo__previa" title="Vista previa del correo" sandbox=""></iframe>
        <p id="cp-grupo-previa-link" class="cp-fecha__nota" hidden>El link de pago de cada familia se crea al enviar (y prepara sus cargos Star).</p>
      </div>
    </div>
    <div id="cp-grupo-progreso" class="cp-grupo__progreso" hidden>
      <progress id="cp-grupo-barra" value="0" max="1"></progress>
      <span id="cp-grupo-progreso-texto"></span>
    </div>
    <div class="ficha-acciones">
      <button type="button" id="cp-grupo-enviar" class="admin-btn">Enviar</button>
      <button type="button" id="cp-grupo-cerrar" class="admin-btn admin-btn--secundario">Cerrar</button>
    </div>
  </dialog>
</AdminBase>

<script>
  import { iniciarClasePrueba } from '../../scripts/admin-clase-prueba.ts';
  iniciarClasePrueba();
</script>

<style is:global>
.cp-header{ display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
.cp-lista-wrap{ padding: 20px; }

.cp-visita-form{ margin: 16px 0 20px; }
.cp-visita-grid{ display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
.cp-consentimiento{
  display: flex; align-items: flex-start; gap: 10px; font-size: 13px; color: #6B6259;
  margin: 16px 0; cursor: pointer;
}
.cp-consentimiento input{ margin-top: 3px; width: 18px; height: 18px; accent-color: var(--fire-red); flex-shrink: 0; }

.cp-grupo{ margin-bottom: 24px; }
.cp-grupo:last-child{ margin-bottom: 0; }
.cp-grupo__titulo{
  font-family: var(--font-display); font-weight: 800; font-size: 1.1rem;
  margin: 0 0 12px; color: var(--ember);
}

.cp-fila{
  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px;
  padding: 14px 16px; border: 1px solid #E4DFD6; border-radius: 12px; margin-bottom: 10px;
}
.cp-fila--asistio{ background: #E3F3E5; border-color: #BFE2C4; }
.cp-fila__info{ min-width: 0; }
.cp-fila__nombre{ font-weight: 600; margin: 0; }
.cp-fila__detalle{ font-size: 13px; color: #6B6259; margin: 2px 0 0; }
.cp-fila__nota{ font-size: 13px; color: var(--ember); margin: 6px 0 0; font-style: italic; }
.cp-fila__accion{ flex-shrink: 0; }
.cp-fila__confirmado{ color: #1E7A34; font-weight: 600; font-size: 14px; white-space: nowrap; }
.cp-etiqueta-star{
  display: inline-block; margin-left: 6px; padding: 2px 8px; border-radius: 999px;
  background: var(--fire-yellow, #FFC400); color: var(--ember, #171412); font-size: 11px; font-weight: 700; vertical-align: middle;
}
.cp-etiqueta-general{
  display: inline-block; margin-left: 6px; padding: 2px 8px; border-radius: 999px;
  background: #E4DFD6; color: var(--ember, #171412); font-size: 11px; font-weight: 700; vertical-align: middle;
}
.cp-pago{ display: inline-block; margin-left: 4px; padding: 2px 8px; border-radius: 999px; font-size: 11px; font-weight: 700; vertical-align: middle; color: #fff; }
.cp-pago--ok{ background: #1E7A3C; }
.cp-pago--pendiente{ background: #B07800; }
.cp-mensajes{ flex-basis: 100%; border-top: 1px solid #EFEBE4; padding-top: 12px; }
.cp-fila--asistio .cp-mensajes{ border-top-color: #BFE2C4; }
.cp-mensajes__campos{ display: flex; flex-wrap: wrap; align-items: flex-end; gap: 12px; }
.cp-mensajes__campos .admin-label{ font-size: 12px; margin-bottom: 4px; }
.cp-select-talla{ min-width: 130px; }
.cp-mensajes__plantilla{ flex: 1 1 220px; }
.cp-mensajes__plantilla .admin-select{ width: 100%; }
.cp-mensajes__aviso{ margin: 10px 0 0; font-size: 13px; color: var(--fire-red, #C51515); }
.cp-mensajes__aviso--ok{ color: #1E7A34; font-weight: 600; }
.cp-mensajes__botones{ display: flex; flex-wrap: wrap; gap: 8px; }
.cp-enviados{ display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
.cp-enviados:empty{ display: none; }
.cp-enviado{ font-size: 12px; padding: 3px 10px; border-radius: 999px; background: #1E7A3C; color: #fff; }
.cp-enviado--correo{ background: #1B4FA8; }

.cp-dialogo{
  width: min(640px, calc(100vw - 24px)); max-height: calc(100vh - 32px); padding: 20px;
  border: none; border-radius: 16px; box-shadow: 0 20px 60px rgba(0,0,0,.35);
}
.cp-dialogo::backdrop{ background: rgba(23,20,18,.6); }
.cp-dialogo--grupo{ width: min(1080px, calc(100vw - 24px)); }
.cp-grupo-cols{ display: grid; gap: 20px; grid-template-columns: minmax(280px, 1fr) minmax(300px, 1.2fr); align-items: start; margin-top: 8px; }
@media (max-width: 760px){ .cp-grupo-cols{ grid-template-columns: 1fr; } }
.cp-grupo-izq .admin-select{ width: 100%; }
.cp-grupo__barra{ display: flex; justify-content: space-between; align-items: center; margin: 14px 0 4px; }
.cp-grupo__barra .admin-label{ margin: 0; }
.cp-grupo__lista{ list-style: none; margin: 0; padding: 0; max-height: 46vh; overflow-y: auto; border: 1px solid #E4DFD6; border-radius: 10px; }
.cp-grupo__item{ display: flex; justify-content: space-between; gap: 8px; padding: 8px 10px; border-top: 1px solid #EFEBE4; font-size: 13px; }
.cp-grupo__item:first-child{ border-top: 0; }
.cp-grupo__item--previa{ background: #FFF8E1; }
.cp-grupo__item--no{ color: #8C847B; }
.cp-grupo__check{ display: flex; gap: 8px; align-items: flex-start; cursor: pointer; min-width: 0; }
.cp-grupo__check input{ margin-top: 3px; width: 16px; height: 16px; accent-color: var(--fire-red); flex-shrink: 0; }
.cp-grupo__check small{ color: #6B6259; overflow-wrap: anywhere; }
.cp-grupo__nota{ display: block; color: #8A5A00 !important; }
.cp-grupo__lado{ display: flex; flex-direction: column; align-items: flex-end; gap: 2px; flex-shrink: 0; }
.cp-grupo__ok{ color: #1E7A34; font-weight: 700; font-size: 12px; white-space: nowrap; }
.cp-grupo__error{ color: #C51515; font-weight: 700; font-size: 12px; max-width: 160px; text-align: right; }
.cp-grupo__copia{ display: flex; gap: 8px; align-items: flex-start; margin: 12px 0 0; font-size: 13px; color: #3D3630; cursor: pointer; }
.cp-grupo__copia input{ margin-top: 2px; width: 16px; height: 16px; accent-color: var(--fire-red); flex-shrink: 0; }
.cp-grupo__progreso{ display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 14px 0 0; font-size: 13px; }
.cp-grupo__progreso[hidden], .cp-fecha[hidden]{ display: none; }
.cp-grupo__progreso progress{ width: 220px; accent-color: var(--fire-red); }
.cp-grupo__cabecera{ display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 12px; margin-bottom: 12px; }
.cp-grupo__cabecera .cp-grupo__titulo{ margin: 0; }
.cp-grupo__correo{ padding: 8px 14px; font-size: 13px; }
.cp-link-fecha{ background: none; border: 0; padding: 0 2px; font: inherit; font-size: 13px; color: var(--fire-red, #C51515); text-decoration: underline; cursor: pointer; }
.cp-fecha{ flex-basis: 100%; border-top: 1px solid #EFEBE4; padding-top: 10px; }
.cp-fecha__campos{ display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.cp-fecha__campos .admin-btn{ padding: 8px 14px; font-size: 13px; }
.cp-fecha__nota{ font-size: 12px; color: #6B6259; margin: 6px 0 0; }
.cp-dialogo__dato{ margin: 0 0 6px; font-size: 14px; color: #6B6259; overflow-wrap: anywhere; }
.cp-dialogo__dato strong{ color: var(--ember, #171412); }
.cp-dialogo__previa{
  display: block; width: 100%; height: min(60vh, 560px); margin: 12px 0 16px;
  border: 1px solid #E4DFD6; border-radius: 12px; background: #171412;
}
</style>

