---
import Base from '../layouts/Base.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import Etiqueta from '../components/Etiqueta.astro';
import Faq from '../components/Faq.astro';
import BandaFoto from '../components/BandaFoto.astro';
import { sitio, whatsapp } from '../data/sitio.js';

const titulo = 'Clases de cheerleading en Santiago | Firehouse Cheer All Stars';
const descripcion = 'Clases de cheerleading en Santiago para niñas y niños desde los 4 años: técnica de cheer, gimnasia de suelo y acondicionamiento. En La Cisterna, a pasos del Metro Lo Ovalle. Primera clase gratis.';

const disciplinas = [
  {
    n: '01',
    nombre: 'Técnica de cheerleading',
    texto: 'Stunts, elevaciones, pirámides y transiciones. Es la parte del deporte que se hace en equipo: unos sostienen, otro sube, y todos aprenden las dos posiciones antes de especializarse.',
  },
  {
    n: '02',
    nombre: 'Gimnasia de suelo',
    texto: 'Volteretas, rondadas, flic flac y progresiones acrobáticas. Se trabaja con colchonetas y asistencia hasta que el movimiento sale limpio y sin ayuda.',
  },
  {
    n: '03',
    nombre: 'Acondicionamiento físico',
    texto: 'Fuerza, elongación, control corporal y resistencia. No es relleno entre ejercicios: es lo que permite que un stunt se sostenga y que una caída no termine en lesión.',
  },
];

const preguntas = [
  { p: '¿Es para principiantes?',
    r: 'Sí. La mayoría llega sin haber hecho nunca cheerleading ni gimnasia. Se entra en el equipo que corresponde por edad y se trabaja desde las bases.' },
  { p: '¿Qué necesito para partir?',
    r: 'Ropa deportiva cómoda, botella de agua y pelo largo tomado. No hace falta uniforme ni zapatillas especiales para empezar.' },
  { p: '¿Desde qué edad se puede entrar?',
    r: 'Desde los 4 años. Los equipos se arman por edad cada temporada, según cuántos deportistas se inscriban.' },
  { p: '¿Es un deporte peligroso?',
    r: 'El cheerleading tiene riesgo, como cualquier deporte acrobático, y por eso el trabajo es por progresiones: nadie ejecuta un movimiento antes de dominar el anterior. Se entrena con colchonetas, con asistencia del coach y con acondicionamiento previo.' },
  { p: '¿Los niños también pueden entrenar?',
    r: 'Sí. El cheerleading competitivo contempla categorías mixtas y en Firehouse entrenan niñas y niños.' },
  { p: '¿Hay que competir?',
    r: 'Todos los equipos preparan una rutina y compiten en la temporada. Esa es la forma en que trabajamos: no hay grupos que solo entrenen sin presentarse.' },
  { p: '¿Cuántas veces por semana se entrena?',
    r: 'Dos: viernes de 18:00 a 20:00 y sábados de 16:00 a 18:00. Cuatro horas semanales en total.' },
];
---
<Base titulo={titulo} descripcion={descripcion} ruta="/clases-cheerleading-santiago" preguntas={preguntas} miga="Entrenamientos">

  <CabeceraPagina etiqueta="Entrenamientos" titulo="Clases de cheerleading en Santiago"
                  acento="azul" objeto="megafono" ruta="Entrenamientos"
                  bajada={`Firehouse Cheer All Stars entrena cheerleading de competencia en {sitio.comuna}, a pasos del Metro {sitio.metro}. Para niñas y niños desde los {sitio.edadMinima} años, con o sin experiencia previa.`}>
    <a class="btn" href={whatsapp('hero')} target="_blank" rel="noopener">Ven a una clase de prueba gratis</a>
  </CabeceraPagina>

  <BandaFoto src="/media/banda-entrenamiento.jpg" alt="Deportistas de Firehouse trabajando gimnasia de suelo durante un entrenamiento" alto="medio" foco="center 42%" />

  <section class="section disciplinas">
    <div class="wrap">
      <div class="reveal">
        <Etiqueta texto="Qué se entrena" />
        <h2 class="section__title">Tres disciplinas, un mismo entrenamiento</h2>
        <p class="section__intro">
          El cheerleading de competencia no es una sola cosa. En Firehouse se trabajan tres áreas
          en paralelo, y las tres avanzan juntas durante la temporada.
        </p>
      </div>

      <ol class="disc__lista">
        {disciplinas.map(d => (
          <li class="disc reveal">
            <span class="disc__n">{d.n}</span>
            <div>
              <h3 class="disc__nombre">{d.nombre}</h3>
              <p class="disc__texto">{d.texto}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section progresion">
    <div class="wrap reveal">
      <Etiqueta texto="Cómo se enseña" />
      <h2 class="section__title">Por progresiones, no por saltos</h2>
      <p class="progresion__texto">
        Ningún movimiento se ejecuta antes de dominar el anterior. Una voltereta hacia atrás no
        aparece de un día para otro: primero está la posición, después el arco, después la
        asistencia del coach, y recién entonces la ejecución sola. Ese orden no es una formalidad
        — es lo que hace que el deporte sea seguro.
      </p>
      <p class="progresion__texto">
        Por eso el acondicionamiento no es opcional y por eso los equipos se separan por edad:
        el cuerpo de una niña de seis no soporta lo mismo que el de una de dieciséis, aunque las
        dos trabajen las mismas áreas del cheerleading.
      </p>
      <p><a class="cta-texto" href="/#el-anio">Ver cómo avanza una temporada completa</a></p>
    </div>
  </section>

  <BandaFoto src="/media/banda-competencia.jpg"
             alt="Equipo de Firehouse Cheer All Stars con su uniforme de entrenamiento"
             alto="bajo" />

  <section class="section semana">
    <div class="wrap">
      <div class="reveal">
        <Etiqueta texto="Horarios" />
        <h2 class="section__title">Dos días a la semana</h2>
      </div>
      <ul class="semana__lista">
        {sitio.horarios.map(h => (
          <li class="reveal">
            <span class="semana__dia">{h.dia}</span>
            <span class="semana__hora">{h.hora}</span>
            <span class="semana__clase">{h.clase}</span>
          </li>
        ))}
      </ul>
      <p class="semana__pie">Cuatro horas semanales de entrenamiento dirigido.</p>
    </div>
  </section>

  <section class="section donde">
    <div class="wrap">
      <div class="reveal">
        <Etiqueta texto="Dónde" />
        <h2 class="section__title">Academia de cheerleader en La Cisterna</h2>
        <p class="donde__texto">
          Si buscas cheerleading en Santiago y quieres entrenar cerca, nuestro gimnasio está en
          {' '}{sitio.calle}, {sitio.comuna}, a pasos del <strong>Metro {sitio.metro} (Línea 2)</strong>.
          Llegan deportistas desde {sitio.cercanas}, y el acceso en metro hace que la distancia
          pese menos que en auto.
        </p>
      </div>

      <dl class="donde__datos reveal">
        <div><dt>Dirección</dt><dd>{sitio.calle}, {sitio.comuna}</dd></div>
        <div><dt>Metro</dt><dd>{sitio.metro}, Línea 2</dd></div>
        <div><dt>WhatsApp</dt><dd><a href={whatsapp('contacto')} target="_blank" rel="noopener">+56 9 8611 4663</a></dd></div>
        <div><dt>Correo</dt><dd><a href={`mailto:${sitio.correo}`}>{sitio.correo}</a></dd></div>
      </dl>

      <p class="reveal"><a class="cta-texto" href="/#contacto">Ver el mapa y cómo llegar</a></p>
    </div>
  </section>

  <section class="section costo">
    <div class="wrap reveal">
      <Etiqueta texto="Cuánto cuesta" />
      <h2 class="section__title">Matrícula $10.000 y mensualidad $30.000</h2>
      <p class="costo__texto">
        La mensualidad cubre los dos entrenamientos semanales y la preparación de la rutina de
        competencia, entre marzo y diciembre. Durante la temporada se suman la tenida de
        entrenamiento, el traje de competencia y el pack de campeonatos, cada uno en el momento
        del año en que se necesita.
      </p>
      <p><a class="cta-texto" href="/precios">Ver el esquema completo de costos</a></p>
    </div>
  </section>

  <Faq preguntas={preguntas} titulo="Preguntas sobre las clases" />

  <section class="section cierre">
    <div class="wrap reveal">
      <p class="cierre__frase">La primera clase es gratis.</p>
      <p class="cierre__sub">Una clase real con el equipo, sin evaluación y sin compromiso.</p>
      <a class="btn" href={whatsapp('hero')} target="_blank" rel="noopener">Ven a una clase de prueba gratis</a>
      <p class="cierre__ver"><a class="cta-texto" href="/clase-de-prueba">Cómo es la clase de prueba, paso a paso</a></p>
    </div>
  </section>
</Base>

<style>

.disciplinas{ background:var(--ember-deep); }
.disc__lista{ list-style:none; margin:var(--e-6) 0 0; padding:0; }
.disc{
  display:grid; grid-template-columns:auto 1fr; gap:var(--e-4);
  padding:var(--e-4) 0; border-bottom:0.5px solid var(--hairline);
}
.disc:first-child{ border-top:0.5px solid var(--hairline); }
.disc__n{
  font-family:var(--font-count); font-weight:700; font-size:13px;
  letter-spacing:.22em; color:var(--txt-faint);
  font-variant-numeric:tabular-nums; min-width:4ch;
}
.disc__nombre{ font-size:clamp(1.3rem, 2.4vw, 1.8rem); color:var(--fire-yellow); }
.disc__texto{ color:var(--txt-soft); max-width:62ch; margin-top:var(--e-1); line-height:1.65; }

.progresion__texto{ color:var(--txt-soft); max-width:var(--wrap-texto); margin-top:var(--e-3); line-height:1.65; }
.progresion p:last-child{ margin-top:var(--e-4); }

.semana__lista{ list-style:none; margin:var(--e-5) 0 0; padding:0; }
.semana__lista li{
  display:flex; align-items:baseline; gap:var(--e-3); flex-wrap:wrap;
  padding:var(--e-3) 0; border-bottom:0.5px solid var(--hairline);
}
.semana__lista li:first-child{ border-top:0.5px solid var(--hairline); }
.semana__dia{ font-family:var(--font-display); font-weight:800; font-size:clamp(1.2rem, 2.2vw, 1.7rem); min-width:7ch; }
.semana__hora{ font-family:var(--font-count); color:var(--fire-yellow); font-variant-numeric:tabular-nums; }
.semana__clase{ font-size:13px; letter-spacing:.14em; text-transform:uppercase; color:var(--txt-faint); margin-left:auto; }
.semana__pie{ margin-top:var(--e-3); color:var(--txt-faint); font-family:var(--font-count); font-size:14px; }

.donde{ background:var(--ember-deep); }
.donde__texto{ color:var(--txt-soft); max-width:var(--wrap-texto); margin-top:var(--e-3); line-height:1.65; }
.donde__texto strong{ color:var(--chalk); font-weight:500; }
.donde__datos{ margin:var(--e-5) 0 var(--e-4); }
.donde__datos > div{ padding:var(--e-3) 0; border-bottom:0.5px solid var(--hairline); }
.donde__datos > div:first-child{ border-top:0.5px solid var(--hairline); }
.donde__datos dt{
  font-size:13px; font-weight:500; letter-spacing:.14em;
  text-transform:uppercase; color:var(--txt-faint);
}
.donde__datos dd{
  margin:var(--e-1) 0 0; font-family:var(--font-display); font-weight:800;
  font-size:clamp(1.05rem, 1.8vw, 1.3rem);
}
.donde__datos dd a{ text-decoration:none; }
.donde__datos dd a:hover{ color:var(--fire-yellow); }

.costo__texto{ color:var(--txt-soft); max-width:var(--wrap-texto); margin-top:var(--e-3); line-height:1.65; }
.costo p:last-child{ margin-top:var(--e-4); }

.cierre{ background:var(--ember-deep); text-align:center; }
.cierre__frase{
  font-family:var(--font-display); font-weight:800;
  font-size:clamp(1.6rem, 3.2vw, 2.4rem); line-height:1.05;
}
.cierre__sub{ color:var(--txt-soft); margin-top:var(--e-1); }
.cierre .btn{ margin-top:var(--e-3); }
.cierre__ver{ margin-top:var(--e-3); }

@media (max-width:760px){
  .disc{ grid-template-columns:1fr; gap:var(--e-1); }
  .semana__clase{ margin-left:0; width:100%; }
}
</style>
