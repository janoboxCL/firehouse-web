---
import AdminBase from '../../layouts/AdminBase.astro';
---
<AdminBase titulo="Ingresar" ocultarCabecera>
  <div class="login">
    <div class="admin-card login__card">
      <p class="login__marca">Firehouse <span>CRM</span></p>
      <h1 class="login__titulo">Ingresar</h1>

      <div id="login-aviso" class="admin-error" hidden></div>

      <form id="form-login">
        <div class="admin-campo">
          <label class="admin-label" for="login-correo">Correo</label>
          <input id="login-correo" class="admin-input" type="email" required autocomplete="username" />
        </div>
        <div class="admin-campo">
          <label class="admin-label" for="login-clave">Contraseña</label>
          <input id="login-clave" class="admin-input" type="password" required autocomplete="current-password" />
        </div>
        <button type="submit" id="login-boton" class="admin-btn login__boton">Ingresar</button>
      </form>

      <p class="login__nota">
        Las cuentas administrativas se crean de forma controlada por Firehouse.
        Si no tienes acceso todavía, contacta a un administrador.
      </p>
    </div>
  </div>
</AdminBase>

<script>
  import { iniciarLogin } from '../../scripts/admin-login.ts';
  iniciarLogin();
</script>

<style is:global>
.login{ min-height: 100dvh; display: flex; align-items: center; justify-content: center; padding: 24px; }
.login__card{ width: 100%; max-width: 380px; padding: 32px 28px; }
.login__marca{ font-family: var(--font-display); font-weight: 800; font-size: 1rem; color: var(--ember); margin: 0; }
.login__marca span{ color: var(--fire-red); }
.login__titulo{ font-size: 1.6rem; margin: 8px 0 20px; }
.admin-campo{ margin-bottom: 16px; }
.login__boton{ width: 100%; margin-top: 6px; }
.login__nota{ margin-top: 20px; font-size: 12px; color: #6B6259; line-height: 1.6; }
</style>
