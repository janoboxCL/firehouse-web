---
import '../styles/tokens.css';
import TopBar from '../components/TopBar.astro';
import Nav from '../components/Nav.astro';
import Pie from '../components/Pie.astro';
import { sitio } from '../data/sitio.js';

const { titulo, descripcion, ruta = '' } = Astro.props;
const canonical = `${sitio.url}${ruta}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SportsActivityLocation',
  name: sitio.nombre,
  alternateName: sitio.nombreCorto,
  url: sitio.url,
  telephone: sitio.telefono,
  sameAs: [sitio.instagram],
  address: {
    '@type': 'PostalAddress',
    addressLocality: sitio.comuna,
    addressRegion: sitio.ciudad,
    addressCountry: 'CL',
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Friday',   opens: '18:00', closes: '20:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '16:00', closes: '18:00' },
  ],
};
---
<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={canonical} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="es_CL" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;800&family=Instrument+Sans:wght@400;500&family=Space+Mono&display=swap" />

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-L88KFZ3MYR"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-L88KFZ3MYR');
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>
  <TopBar />
  <Nav />
  <main>
    <slot />
  </main>
  <Pie />
</body>
</html>
