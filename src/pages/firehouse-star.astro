---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Sparky from '../components/Sparky.astro';
import { whatsapp } from '../data/sitio.js';

const titulo = 'Firehouse Star — cheerleading desde cero para niñas y niños desde 4 años | Firehouse Cheer';
const descripcion = 'Firehouse Star es el programa de iniciación de Firehouse Cheer: una clase semanal para descubrir el cheer desde cero, sin experiencia previa. Sábados en La Cisterna.';

const preguntas = [
  { p: 'Mi hijo o hija nunca ha hecho cheer.',
    r: 'Perfecto. Firehouse Star está pensado justamente para empezar desde cero.' },
  { p: '¿Tiene que saber hacer piruetas?',
    r: 'No. La clase parte con movimientos y ejercicios adaptados a su nivel, sin ninguna base previa.' },
  { p: '¿Es muy exigente?',
    r: 'Es una clase semanal de 90 minutos donde se mezclan movimiento, juegos y fundamentos del cheer. No es un entrenamiento de competencia.' },
  { p: '¿Va a competir?',
    r: 'No. Star es un espacio para aprender, disfrutar y avanzar sin presión por competir. Puede continuar en Star todo el tiempo que quiera; si algún día quiere pasar a un equipo competitivo, también tendrá ese camino disponible.' },
  { p: '¿Existe clase de prueba?',
    r: 'Durante esta etapa, Firehouse Star funciona por inscripción directa, sin clase de prueba gratuita. Para bajar el riesgo de esa decisión, si ningún horario disponible resulta compatible con tu familia, la inscripción se reembolsa completa; y si te arrepientes antes de la primera clase sin que exista ese problema, el pago queda como crédito Firehouse por 90 días, para este hijo o hija, o para un hermano o hermana.' },
  { p: '¿Existe permanencia mínima?',
    r: 'No. La mensualidad funciona mes a mes, igual que en el resto de Firehouse.' },
  { p: '¿Qué pasa si me inscribo a mitad de mes?',
    r: 'La mensualidad se ajusta a las clases que queden en el mes: se paga solo por las semanas de clase a las que efectivamente se llega, nunca el mes completo si se entra después de la primera semana.' },
];

const navEnlacesStar = [
  { href: whatsapp('ayudaRegistroStar'), texto: '¿Dudas? WhatsApp 💬' },
];
---
<Base titulo={titulo} descripcion={descripcion} ruta="/firehouse-star" preguntas={preguntas} miga="Firehouse Star"
      navCtaHref="/registro-star" navCtaTexto="INSCRÍBETE ⭐" navCtaTextoCorto="INSCRÍBETE ⭐"
      navCtaExterno={false} navEnlaces={navEnlacesStar}>

  <!-- ============ HERO ============ -->
  <section class="star-hero">
    <div class="star-hero__glow" aria-hidden="true"></div>

    <div class="wrap star-hero__grid">
      <div class="star-hero__texto">
        <p class="star-hero__kicker reveal star-reveal-1">FIREHOUSE STAR ⭐</p>

        <picture class="star-hero__logo reveal star-reveal-1">
          <source srcset="/media/star/logo-firehouse-star.webp" type="image/webp" />
          <img src="/media/star/logo-firehouse-star.png" alt="Firehouse Star" width="360" />
        </picture>

        <h1 class="star-hero__titulo reveal star-reveal-2">¿Buscas una actividad que de verdad le entusiasme?</h1>
        <p class="star-hero__bajada reveal star-reveal-3">
          Una forma diferente de moverse, aprender, compartir y descubrir el cheer.
        </p>
        <p class="star-hero__submensaje reveal star-reveal-3">Desde los 4 años · No necesita experiencia para comenzar</p>

        <ul class="star-datos reveal star-reveal-4">
          <li>
            <svg class="star-datos__icono" viewBox="0 0 48 48" aria-hidden="true"><path d="M24 4 29.4 18.1 45 19.2 33.4 29.2 37 44 24 35.8 11 44 14.6 29.2 3 19.2 18.6 18.1Z" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linejoin="round"/></svg>
            <span>Edad</span><b>Desde 4 años</b>
          </li>
          <li>
            <svg class="star-datos__icono" viewBox="0 0 48 48" aria-hidden="true"><rect x="6" y="10" width="36" height="32" rx="4" fill="none" stroke="currentColor" stroke-width="3.2"/><path d="M6 19h36" stroke="currentColor" stroke-width="3.2"/><path d="M15 6v9M33 6v9" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/></svg>
            <span>Cuándo</span><b>Sábados</b>
          </li>
          <li>
            <svg class="star-datos__icono" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="18" fill="none" stroke="currentColor" stroke-width="3.2"/><path d="M24 14v10l8 5" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>Duración</span><b>90 minutos</b>
          </li>
          <li>
            <svg class="star-datos__icono" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="18" fill="none" stroke="currentColor" stroke-width="3.2"/><text x="24" y="31" text-anchor="middle" font-weight="800" font-size="20" fill="currentColor">$</text></svg>
            <span>Mensualidad</span><b>$30.000</b>
          </li>
        </ul>

        <p class="star-hero__cta reveal star-reveal-5">
          <a class="star-btn star-btn--brilla" href="/registro-star" id="wa-star-hero">QUIERO QUE EMPIECE EN STAR ⭐</a>
          <a class="star-btn-quiet" href="#clase">Ver cómo es una clase ↓</a>
        </p>
      </div>

      <div class="star-hero__sparky-wrap">
        <Sparky pose="wave" size={340} class="sparky--flota" alt="Sparky saludando, dando la bienvenida a Firehouse Star" />
      </div>
    </div>
  </section>

  <!-- ============ SPARKY TAMPOCO SABÍA CHEER ============ -->
  <section class="star-relato">
    <div class="wrap star-relato__grid">
      <div class="star-relato__sparky reveal">
        <Sparky pose="dizzy" size={260} class="sparky--flota" alt="Sparky mareado, después de intentar un movimiento y que le saliera mal" />
      </div>
      <div class="reveal star-reveal-2">
        <h2 class="star-relato__titulo">Sparky tampoco sabía cheer. ⭐</h2>
        <p class="star-relato__parrafo">
          Se equivocó.<br />
          Probó otra vez.<br />
          Y siguió jugando.
        </p>
        <p class="star-relato__remate">En Star nadie tiene que llegar sabiendo.<br />Ese es justamente el punto.</p>
      </div>
    </div>
  </section>

  <!-- ============ ASÍ SE VIVE UNA CLASE STAR ============ -->
  <section class="star-section star-section--panel" id="clase">
    <div class="wrap">
      <p class="star-eyebrow">Así se vive una clase Star</p>
      <h2 class="star-title">¿Qué pasa en una clase de Firehouse Star?</h2>
      <p class="star-parrafo">90 minutos para moverse, jugar, aprender y descubrir el cheer.</p>
      <p class="star-escenas__hint">Desliza para ver →</p>

      <div class="star-escenas">
        <article class="star-escena reveal">
          <div class="star-escena__img">
            <span class="star-escena__num">1</span>
            <picture>
              <source srcset="/media/star/escena-activamos.webp" type="image/webp" />
              <img src="/media/star/escena-activamos.jpg" alt="Sparky y los niños estirando antes de empezar la clase Star" loading="lazy" decoding="async" />
            </picture>
          </div>
          <div class="star-escena__texto">
            <h3>🔥 Nos activamos</h3>
            <p>Movemos el cuerpo y entramos en calor.</p>
          </div>
        </article>
        <article class="star-escena reveal">
          <div class="star-escena__img">
            <span class="star-escena__num">2</span>
            <picture>
              <source srcset="/media/star/escena-jugamos.webp" type="image/webp" />
              <img src="/media/star/escena-jugamos.jpg" alt="Sparky y los niños en un circuito de conos, jugando y moviéndose" loading="lazy" decoding="async" />
            </picture>
          </div>
          <div class="star-escena__texto">
            <h3>🎯 Jugamos y nos movemos</h3>
            <p>Circuitos y juegos para coordinar y reaccionar.</p>
          </div>
        </article>
        <article class="star-escena reveal">
          <div class="star-escena__img">
            <span class="star-escena__num">3</span>
            <picture>
              <source srcset="/media/star/escena-descubrimos.webp" type="image/webp" />
              <img src="/media/star/escena-descubrimos.jpg" alt="Niños de Star practicando una posición de cheer junto a Sparky" loading="lazy" decoding="async" />
            </picture>
          </div>
          <div class="star-escena__texto">
            <h3>⭐ Descubrimos el cheer</h3>
            <p>Primeras posiciones y movimientos del deporte.</p>
          </div>
        </article>
        <article class="star-escena reveal">
          <div class="star-escena__img">
            <span class="star-escena__num">4</span>
            <picture>
              <source srcset="/media/star/escena-juntos.webp" type="image/webp" />
              <img src="/media/star/escena-juntos.jpg" alt="Sparky y los niños de Star con las manos juntas al centro, en equipo" loading="lazy" decoding="async" />
            </picture>
          </div>
          <div class="star-escena__texto">
            <h3>🙌 Lo hacemos juntos</h3>
            <p>Aprendemos a esperar y a colaborar.</p>
          </div>
        </article>
        <article class="star-escena reveal">
          <div class="star-escena__img">
            <span class="star-escena__num">5</span>
            <picture>
              <source srcset="/media/star/escena-celebramos.webp" type="image/webp" />
              <img src="/media/star/escena-celebramos.jpg" alt="Sparky y los niños de Star celebrando saltando, con estrellas alrededor" loading="lazy" decoding="async" />
            </picture>
          </div>
          <div class="star-escena__texto">
            <h3>🎉 Celebramos lo aprendido</h3>
            <p>Algo nuevo logrado, en cada clase.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ PARA FAMILIAS NUEVAS EN CHEER ============ -->
  <section class="star-section star-camino" id="camino">
    <div class="wrap star-descubrir reveal">
      <p class="star-eyebrow">Una actividad diferente</p>
      <h2 class="star-title">¿Nunca habían pensado en cheer?</h2>
      <p class="star-descubrir__perfecto">Perfecto.</p>
      <p class="star-parrafo">Star está diseñado justamente para descubrirlo desde cero. Aquí puede aprender movimientos, coordinación, trabajo en equipo y fundamentos del cheer de forma progresiva y entretenida.</p>
    </div>
  </section>

  <!-- ============ LO QUE VA APRENDIENDO ============ -->
  <section class="star-section">
    <div class="wrap">
      <p class="star-eyebrow">Qué obtiene</p>
      <h2 class="star-title">Lo que va aprendiendo</h2>

      <div class="star-grid5">
        <div class="star-card reveal">
          <svg class="star-card__icono" viewBox="0 0 48 48" aria-hidden="true"><path d="M20 4 10 26h10L14 44 36 18H24Z" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linejoin="round"/></svg>
          <h3>Movimiento</h3><p>Equilibrio y coordinación.</p>
        </div>
        <div class="star-card reveal">
          <svg class="star-card__icono" viewBox="0 0 48 48" aria-hidden="true"><path d="M24 4 29.4 18.1 45 19.2 33.4 29.2 37 44 24 35.8 11 44 14.6 29.2 3 19.2 18.6 18.1Z" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linejoin="round"/></svg>
          <h3>Cheer</h3><p>Sus primeros fundamentos.</p>
        </div>
        <div class="star-card reveal">
          <svg class="star-card__icono" viewBox="0 0 48 48" aria-hidden="true"><circle cx="16" cy="14" r="6" fill="none" stroke="currentColor" stroke-width="3.2"/><circle cx="32" cy="14" r="6" fill="none" stroke="currentColor" stroke-width="3.2"/><path d="M4 40c0-8 5-13 12-13s12 5 12 13M20 40c0-8 5-13 12-13s12 5 12 13" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/></svg>
          <h3>Equipo</h3><p>Aprender con otros.</p>
        </div>
        <div class="star-card reveal">
          <svg class="star-card__icono" viewBox="0 0 48 48" aria-hidden="true"><path d="M24 4c0 3-3 5-6 5-1.5 0-2 1-1 2.5 1.5 2.5 1 4.5-1 6.5-2.5 2.5-4 5.5-4 9 0 6 5 10 12 10s12-4 12-10c0-3.5-1.5-6.5-4-8.5.3 2.5-1 4-3 4-2.5 0-3.5-2-2.5-4.5C28 14 24 9 24 4Z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/></svg>
          <h3>Atreverse</h3><p>Intentar y volver a intentar.</p>
        </div>
        <div class="star-card reveal">
          <svg class="star-card__icono" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="18" fill="none" stroke="currentColor" stroke-width="3.2"/><circle cx="17" cy="20" r="2.4" fill="currentColor"/><circle cx="31" cy="20" r="2.4" fill="currentColor"/><path d="M15 29c2.5 4 6 6 9 6s6.5-2 9-6" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/></svg>
          <h3>Diversión</h3><p>Querer volver.</p>
        </div>
      </div>
      <p class="star-promesa reveal">Queremos que disfrute y tenga ganas de volver. ⭐</p>
    </div>
  </section>

  <section class="star-franja-confianza" aria-label="Experiencia Firehouse">
    <div class="wrap reveal">
      <p>STAR ES NUEVO. FIREHOUSE NO. ⭐</p>
      <strong>Más de 25 años de experiencia formando deportistas.</strong>
    </div>
  </section>

  <section class="star-section star-ritmo">
    <div class="wrap reveal">
      <p class="star-eyebrow">A su ritmo ⭐</p>
      <h2 class="star-title">Sin presión. Sin apuro. A su ritmo.</h2>
      <p class="star-ritmo__principal">Firehouse Star es un espacio para aprender, disfrutar y avanzar sin presión por competir.</p>
      <p class="star-parrafo">Puede continuar en Star todo el tiempo que quiera. Si algún día quiere dar el paso hacia un equipo competitivo, también tendrá ese camino disponible.</p>
    </div>
  </section>

  <!-- ============ FIREHOUSE REAL ============ -->
  <section class="star-section star-confianza">
    <div class="wrap star-confianza__grid">
      <div class="star-confianza__foto reveal">
        <picture>
          <source srcset="/media/gal-equipo.webp" type="image/webp" />
          <img src="/media/gal-equipo.jpg" alt="Deportistas de Firehouse de distintas edades junto al coach en el tapete, incluyendo niñas pequeñas" loading="lazy" decoding="async" />
        </picture>
      </div>
      <div class="reveal star-reveal-2">
        <p class="star-eyebrow">Star es nuevo. Firehouse no.</p>
        <h2 class="star-title">Entrena dentro de Firehouse Cheer</h2>
        <p class="star-parrafo">Santa Corina 197, La Cisterna — a pasos del Metro Lo Ovalle.</p>

        <div class="star-confianza__coach">
          <p class="star-confianza__coach-nombre">Coach Benjamín Beltrán</p>
          <p class="star-confianza__coach-desc">Head coach, más de 25 años de experiencia.</p>
        </div>

        <!-- TODO (Jano): agregar acá la calificación real de Google y una
             reseña real cuando estén confirmadas. No se inventa un número
             ni una cita — se deja pendiente hasta tener el dato real. -->

        <p class="star-confianza__links">
          <a class="star-cta-texto" href="/coach-benjamin-beltran">Conocer al coach →</a>
          <a class="star-cta-texto" href="/">Conocer Firehouse →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ============ PRECIO ============ -->
  <section class="star-section" id="precio">
    <div class="wrap">
      <p class="star-eyebrow">Empezar es simple</p>
      <h2 class="star-title">Cuánto cuesta empezar</h2>

      <div class="star-precio-card reveal">
        <span class="star-precio-card__etq">Para comenzar</span>
        <span class="star-precio-card__num">$40.000</span>
        <p class="star-precio-card__desglose">$10.000 inscripción + $30.000 primera mensualidad</p>

        <div class="star-precio-card__despues">
          <span>Después</span>
          <b>$30.000<small>/mes</small></b>
          <span class="star-precio-card__detalle">1 clase semanal · 90 minutos</span>
        </div>

        <h3 class="star-precio-card__tranquilidad">Inscríbelo con tranquilidad</h3>
        <ul class="star-precio-card__check">
          <li>Sin permanencia obligatoria</li>
          <li>Pagas mes a mes</li>
          <li>Si entras a mitad de mes, pagas proporcional</li>
          <li>Starter Pack incluido</li>
        </ul>

        <a class="star-btn star-btn--full" href="/registro-star" id="wa-star-precio">QUIERO QUE EMPIECE EN STAR ⭐</a>

        <details class="star-detalle">
          <summary>Ver cálculo si ingreso a mitad de mes</summary>
          <table class="star-tabla">
            <thead><tr><th>Ingresas en</th><th>Pagas ese mes</th></tr></thead>
            <tbody>
              <tr><td>Semana 1</td><td>$30.000 <span class="star-tabla__nota">(mes completo)</span></td></tr>
              <tr><td>Semana 2</td><td>$22.500</td></tr>
              <tr><td>Semana 3</td><td>$15.000</td></tr>
              <tr><td>Semana 4</td><td>$7.500</td></tr>
            </tbody>
          </table>
        </details>
        <details class="star-detalle star-condiciones">
          <summary>Ver condiciones de inscripción +</summary>
          <p>Si ningún horario disponible resulta compatible con tu familia, la inscripción se reembolsa completa. Si te arrepientes antes de la primera clase, el pago queda como crédito Firehouse por 90 días para este hijo o hija, o para un hermano o hermana.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- ============ KIT DE BIENVENIDA ============ -->
  <section class="star-section star-section--panel">
    <div class="wrap">
      <p class="star-eyebrow">Incluido en la inscripción</p>
      <h2 class="star-title">Starter Pack Firehouse Star</h2>

      <div class="star-pack reveal">
        <div class="star-pack__items">
          <svg class="star-pack__icono" viewBox="0 0 48 48" aria-hidden="true"><path d="M16 6 6 14l6 6 4-3v25h16V17l4 3 6-6-10-8c0 3-3 5-6 5s-6-2-6-5Z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/></svg>
          <svg class="star-pack__icono" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="14" fill="none" stroke="currentColor" stroke-width="6"/><path d="M24 10c3 2 3 4 0 6M24 38c3-2 3-4 0-6" stroke="currentColor" stroke-width="3" stroke-linecap="round" fill="none"/></svg>
        </div>
        <div class="star-pack__texto">
          <span class="star-pack__sello">Incluido al inscribirse</span>
          <h3>Polera de entrenamiento + Accesorio</h3>
          <p>Polera oficial Firehouse Star para todos. Además, scrunchie Firehouse para el pelo, incluido para las niñas.</p>
        </div>
      </div>
    </div>
  </section>

  <Faq preguntas={preguntas} titulo="Preguntas frecuentes" />

  <!-- ============ CTA FINAL ============ -->
  <section class="star-cierre">
    <div class="wrap reveal">
      <p class="star-cierre__previo">Toda estrella de Firehouse tuvo un primer día.</p>
      <Sparky pose="excited" size={110} class="sparky--salta" alt="Sparky celebrando con los brazos arriba" />
      <h2 class="star-title">Su primera experiencia en cheer puede empezar aquí. ⭐</h2>
      <p class="star-parrafo star-parrafo--centro">No necesita experiencia. Puede avanzar a su ritmo.</p>
      <a class="star-btn star-btn--brilla" href="/registro-star" id="wa-star-cierre">QUIERO QUE EMPIECE EN STAR ⭐</a>
      <a class="star-whatsapp" href={whatsapp('ayudaRegistroStar')} target="_blank" rel="noopener">¿Tienes una duda? WhatsApp 💬</a>
      <p class="star-nota">Sábados 16:00–17:30 · Santa Corina 197, La Cisterna</p>
    </div>
  </section>

  <!-- ============ BARRA FIJA MÓVIL ============ -->
  <div class="star-barra-fija" id="star-barra-fija">
    <div class="star-barra-fija__info"><b>STAR</b><span>$30.000/mes</span></div>
    <a class="star-btn star-btn--chica" href="/registro-star" id="wa-star-barra">QUIERO QUE EMPIECE EN STAR ⭐</a>
  </div>

</Base>

<script>
  (() => {
    const barra = document.getElementById('star-barra-fija');
    const hero = document.querySelector('.star-hero');
    if (!barra || !hero || !('IntersectionObserver' in window)) return;
    const obs = new IntersectionObserver(([entrada]) => {
      barra.classList.toggle('visible', !entrada.isIntersecting);
    }, { rootMargin: '-10% 0px 0px 0px' });
    obs.observe(hero);
  })();
</script>

<style>
/*
  Sistema de color Firehouse Star (revisado): el rojo Firehouse vuelve a
  ser el color de acción (CTA), tal como en el resto del sitio. El
  amarillo se reserva para acentos, bordes, íconos y números — no para
  rellenos grandes. La única sección que rompe la base oscura es
  "Sparky tampoco sabía cheer" (fondo crema), una decisión deliberada,
  no un accidente.
*/

.star-eyebrow{
  font-family: var(--font-count); font-size: 11px; letter-spacing: .3em;
  color: var(--fire-yellow); text-transform: uppercase;
  display: flex; align-items: center; gap: 12px;
}
.star-eyebrow::before{ content:''; width:30px; height:3px; background: rgba(245,239,232,.38); transform: skewX(var(--tilt-sm)); }

.star-count{
  display: inline-flex; align-items: center; gap: 10px;
  font-family: var(--font-count); font-weight: 700; font-size: 12.5px; letter-spacing: .16em;
  color: var(--fire-yellow); margin-top: 6px;
}

.star-title{ font-family: var(--font-display); font-weight: 800; font-size: clamp(1.7rem, 3.6vw, 2.6rem); line-height: 1.05; margin-top: var(--e-3); }
.star-parrafo{ color: var(--txt-soft); max-width: var(--wrap-texto); margin-top: var(--e-3); font-size: clamp(1rem,1.5vw,1.15rem); line-height: 1.6; }
.star-parrafo--centro{ margin-inline: auto; text-align: center; }
.star-nota{ color: var(--txt-faint); font-size: 13px; margin-top: var(--e-3); max-width: var(--wrap-texto); }
.star-cta-texto{ color: var(--fire-yellow); text-decoration: none; border-bottom: 2px solid var(--fire-yellow); font-size: 15px; }
.star-cta-texto:hover{ color: var(--chalk); border-bottom-color: var(--chalk); }

/* Botón sólido — rojo Firehouse, como el resto del sitio */
.star-btn{
  display: inline-flex; align-items: center; justify-content: center; min-height: 48px;
