---
import Etiqueta from './Etiqueta.astro';
const cifras = [
  { n: '27',  t: 'años en el cheerleading' },
  { n: '19',  t: 'temporadas en un mismo colegio' },
  { n: '4.º', t: 'del mundo · USASF 2008' },
  { n: '10',  t: 'años formando entrenadores' },
];
---
<section class="section coach" id="coach">
  <div class="wrap">
    <div class="reveal">
      <Etiqueta texto="Quién entrena" />
      <h2 class="section__title">Coach Benjamín Beltrán</h2>
    </div>

    <div class="coach__fila">
      <picture class="coach__foto reveal">
        <source srcset="/media/coach-retrato.webp" type="image/webp" />
        <img src="/media/coach-retrato.jpg" alt="Benjamín Beltrán, head coach de Firehouse Cheer, con una deportista de la academia" width="900" height="1200" loading="lazy" />
      </picture>

      <div class="coach__texto reveal">
        <p class="coach__bajada">
          Tu hija no entrena en una academia: entrena con una persona. Esta es la suya.
        </p>
        <p class="coach__sub">
          Compite desde 1998 y entrena desde 2001. Dirigió el mismo programa escolar
          durante diecinueve temporadas seguidas.
        </p>
        <p><a class="cta-texto" href="/coach-benjamin-beltran" id="ver-coach">Conocer su trayectoria</a></p>
      </div>
    </div>

    <ul class="cifras reveal">
      {cifras.map(c => (
        <li class="cifra">
          <span class="cifra__n">{c.n}</span>
          <span class="cifra__t">{c.t}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
.coach{ background:var(--ember-deep); border-bottom:var(--regla) solid var(--fire-red); }

.coach__fila{ display:flex; gap:var(--e-6); align-items:center; margin-top:var(--e-6); }
.coach__foto{ flex:none; width:300px; }
.coach__foto img{ width:100%; height:auto; display:block; border-left:var(--regla) solid var(--fire-red); }
.coach__texto{ flex:1; }

.coach__bajada{
  font-family:var(--font-display); font-weight:800;
  font-size:clamp(1.4rem, 2.8vw, 2.1rem); line-height:1.15;
  color:var(--fire-yellow); max-width:24ch;
}
.coach__sub{ color:var(--txt-soft); max-width:52ch; margin-top:var(--e-3); font-size:clamp(1rem,1.5vw,1.15rem); line-height:1.6; }
.coach__texto p:last-child{ margin-top:var(--e-4); }

/* Las cifras son el argumento: banda propia, a todo el ancho */
.cifras{
  list-style:none; margin:var(--e-6) 0 0; padding:0;
  display:grid; grid-template-columns:repeat(auto-fit, minmax(190px, 1fr)); gap:2px;
  background:var(--hairline);
}
.cifra{
  background:var(--ember);
  padding:var(--e-4) var(--e-3);
  position:relative; overflow:hidden;
}
.cifra::before{
  content:''; position:absolute; left:0; top:0; width:100%; height:4px;
  background:var(--fire-red);
}
.cifra__n{
  display:block;
  font-family:var(--font-display); font-weight:800;
  font-size:clamp(3.2rem, 6vw, 4.6rem); line-height:.88;
  color:var(--fire-yellow); font-variant-numeric:tabular-nums;
  letter-spacing:-.02em;
}
.cifra__t{
  display:block; color:var(--txt-soft); font-size:14.5px;
  margin-top:var(--e-2); line-height:1.4; max-width:20ch;
}

@media (max-width:900px){
  .coach__fila{ flex-direction:column; align-items:flex-start; gap:var(--e-4); }
  .coach__foto{ width:220px; }
  .cifras{ grid-template-columns:1fr 1fr; }
}
</style>
